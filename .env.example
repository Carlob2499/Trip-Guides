# Copy to .env for local builds. Every value is optional: without it the surface degrades honestly
# (docs/reference/integrations.md). Never commit .env.

# Google Maps Platform — Maps JavaScript API browser key, HTTP-referrer restricted.
PUBLIC_GMAPS_KEY=
# Optional Cloud map style id (falls back to DEMO_MAP_ID).
PUBLIC_GMAPS_MAP_ID=

# Public capability switch only. Set to 1 after the Worker has its server-side Google key,
# runtime rate-limiter binding, and provider quotas configured. This is not a credential.
PUBLIC_WAYPOINT_RUNTIME_ENABLED=0
