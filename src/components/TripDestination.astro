---
/* Trip — "what matters now" (design-system.md §7).

   Three lifecycle compositions of ONE destination, all rendered, one shown — trip.js picks
   the phase against the destination's clock (a build-time "now" is whatever moment the site
   was deployed). Every piece is derived from the guide's own record:

     PRE     a strong, restrained destination hero · countdown · only the UNRESOLVED readiness
             items (bookings with a closing door lead; the rest fold away) · entry rules ·
             holidays/closures in the window · the live forecast · offline files.
     ACTIVE  mission control inside the frame (board 02): a left rail of standing answers
             (identity + progress, next stop, weather, today's focus, dated reservations), the
             day's stops as photo rows in the centre, today's route and its measured strip on
             the right. The rows are painted by trip.js from the canonical days in the
             deterministic order Now → Next → Get there → material problem → fallback →
             remainder of the day. Nothing here is a second itinerary.
     POST    an editorial recap from the curated post-mortem, a few large outcome atoms, the
             major Plan-vs-Actual changes, then the Learnings notebook.

   The standing references — Essentials, the Split card and the Learnings notebook
   (#learnings) — are the cream band under the frame: TripBelow.astro. */
import Icon from "./Icon.astro";
import ReminderRow from "./ReminderRow.astro";
import PaintedAtlas from "./PaintedAtlas.astro";
import { jsonEmbed } from "../lib/json-embed";
import { resolveTripDateInYear } from "../lib/trip-dates";
import type { TripDay, ReadinessStack, RecapAtoms } from "../features/trip/index";
import type { HolidayInfo } from "../lib/holidays";

interface Props {
  guide: any;
  slug: string;
  storeKey: string;
  days: TripDay[];
  readiness: ReadinessStack;
  recap: RecapAtoms | null;
  holidays: HolidayInfo | null;
  hero: { src: string | null; srcset: string | null; alt: string; focal: string | null; painted: boolean; tz?: string | null };
  /** Repository photo per named place (guide-view.ts) — the Now/Next atoms show the stop's own picture. */
  placeImages: Record<string, { src: string; srcset: string; alt: string }>;
  dates: string | null;
  cities: string | null;
  hasWeather: boolean;
  /** The itinerary's located stops, day-indexed — today's route draws from these (maps lens "today"). */
  dayPins?: { id: string; name: string; lat: number; lng: number; dayIdx: number; time: string | null; local: string | null; kind: string; cat: string | null; placeId: string | null }[];
  center?: { lat: number; lng: number } | null;
  span?: number | null;
  /** The guide's own first/last day labels ("Wed Jul 8") — the reservation window. */
  tripStart: string | null;
  tripEnd: string | null;
}
const { guide, slug, storeKey, days, readiness, recap, holidays, hero, placeImages, dates, cities, hasWeather, dayPins = [], center = null, span = null, tripStart = null, tripEnd = null } = Astro.props;
/* Google Maps Platform is the live map when built with PUBLIC_GMAPS_KEY (§15); the OSM embed
   stays dormant on data-fallback-src and gmaps-render.js wakes it only if Google fails. */
const googlePrimary = Boolean(import.meta.env.PUBLIC_GMAPS_KEY);
const frameSrcAttr = googlePrimary ? "data-fallback-src" : "data-src";
const todayMapPayload = center && dayPins.length ? jsonEmbed({ center, span, pins: dayPins, lens: "today" }) : null;
const bbox = (c: { lat: number; lng: number }, s: number | null) => {
  const sp = s || 0.05;
  return [c.lng - sp, c.lat - sp * 0.6, c.lng + sp, c.lat + sp * 0.6].join("%2C");
};
const during = holidays?.during ?? [];
const closures = readiness.closures;
const learnings = guide.learnings ?? null;
const tripData = jsonEmbed(days);
const imageData = jsonEmbed(placeImages);
const stopCount = days.reduce((n, d) => n + d.stops.length, 0);
/* The dated commitments (work order §3 "02 · Trip" — its "Reservations" card). The operative
   fact is the DATE: a readiness item the guide gave a due date that falls inside the trip. The
   `book` wording flag is a heuristic over the item's own words and would drop a dated item it
   simply did not phrase as a booking, so the date decides and the flag only styles the row.
   The window is resolved in the due date's own year, so the card is a function of the guide
   alone — never of the day the site happened to be built. Nothing dated, no card: the board's
   three confirmed reservations with entry types and statuses are not a wired concept. */
const reservations = readiness.reminders.filter((r) => {
  if (!r.due) return false;
  const year = Number(String(r.due).slice(0, 4));
  if (!Number.isFinite(year)) return false;
  const from = resolveTripDateInYear(tripStart, year);
  const to = resolveTripDateInYear(tripEnd ?? tripStart, year);
  if (!from || !to) return false;
  const due = new Date(`${r.due}T12:00:00`);
  return due >= from && due.getTime() <= to.getTime() + 86400000;
});
---
<div class="trip" data-trip data-phase="pre">
  <script type="application/json" is:inline id="tripData" set:html={tripData}></script>
  <script type="application/json" is:inline id="tripImages" set:html={imageData}></script>

  {/* The identity band: destination imagery carries identity (§4), the lifecycle stamp says
      which composition this is. Active trips compress it so the Now object owns the fold. */}
  <header class="trip-hero" data-trip-hero>
    <div class={`trip-hero-media${hero.painted ? " trip-hero-media--painted" : ""}`} aria-hidden="true">
      {/* The living painted cover sits under the photo: it IS the cover when the guide has no
          photo, and it stands in when the photo cannot load — never an empty plate. */}
      <PaintedAtlas seed={slug} tz={hero.tz ?? undefined} mini={true} />
      {hero.src && (
        <img class="trip-hero-img" src={hero.src} srcset={hero.srcset ?? undefined} sizes="100vw" alt="" loading="eager" fetchpriority="high"
             style={hero.focal ? `object-position:${hero.focal}` : undefined}
             onerror="this.closest('.trip-hero-media').classList.add('media-fail')" />
      )}
      <span class="trip-hero-scrim"></span>
    </div>
    <div class="trip-hero-text">
      <p class="trip-kicker">
        <span class="trip-stamp" data-trip-stamp>Trip</span>
        {dates && <span class="trip-dates">{dates}</span>}
      </p>
      <h2 class="trip-title">{guide.title}</h2>
      {cities && <p class="trip-cities">{cities}</p>}
      <div class="trip-stats" id="tripStats" data-trip-stats></div>
    </div>
  </header>

  {/* ═══ PRE-TRIP ═══ readiness leads as the one feature object (§24 "may emphasize readiness");
      closures and the forecast support it as compact tiles — never equal cards. The entry
      rules and the offline files are standing references and live under the frame now. */}
  <section class="trip-phase trip-pre" data-trip-phase="pre" aria-label="Before you go">
    {readiness.bookAhead.length > 0 && (
      <div class="trip-block trip-priorities trip-pre-lead" data-readiness={storeKey}>
        <h3 class="trip-h">Still to settle</h3>
        <p class="trip-sub" data-readiness-open></p>
        {/* A short stack (§7 pre-trip): the first items lead, the rest fold but stay counted. */}
        <div data-readiness-list>
          <ul class="trip-rem">
            {readiness.bookAhead.slice(0, 6).map((item) => <ReminderRow item={item} />)}
          </ul>
          {readiness.bookAhead.length > 6 && (
            <details class="trip-more">
              <summary>{readiness.bookAhead.length - 6} more to settle</summary>
              <ul class="trip-rem">{readiness.bookAhead.slice(6).map((item) => <ReminderRow item={item} />)}</ul>
            </details>
          )}
        </div>
        {readiness.other.length > 0 && (
          <details class="trip-more">
            <summary>Everything else the guide asks for — {readiness.other.length} items</summary>
            <ul class="trip-rem">{readiness.other.map((item) => <ReminderRow item={item} />)}</ul>
          </details>
        )}
      </div>
    )}
    {readiness.bookAhead.length === 0 && readiness.other.length > 0 && (
      <div class="trip-block trip-priorities trip-pre-lead" data-readiness={storeKey}>
        <h3 class="trip-h">Before you go</h3>
        <p class="trip-sub" data-readiness-open></p>
        <ul class="trip-rem" data-readiness-list>{readiness.other.map((item) => <ReminderRow item={item} />)}</ul>
      </div>
    )}
    <div class="trip-pre-side">
    {(during.length > 0 || closures.length > 0) && (
      <div class="trip-block trip-block--tile trip-closures">
        <h3 class="trip-h"><Icon name="calendar" size={16} /> Closed during your dates</h3>
        {during.length > 0 && (
          <ul class="trip-list">
            {during.map((h) => <li><b>{h.label}</b> — {h.name} <span class="trip-dim">public holiday</span></li>)}
          </ul>
        )}
        {closures.length > 0 && (
          <ul class="trip-list">
            {closures.map((d) => (
              <li><b>{d.label}</b> — {d.places.map((p, i) => <>{i > 0 && ", "}{p.name}</>)}</li>
            ))}
          </ul>
        )}
      </div>
    )}
    {hasWeather && (
      <div class="trip-block trip-block--tile trip-weather">
        <div id="wxWrap" class="wx-wrap" hidden><div id="wxMount"></div></div>
        <div id="tkPackingCard" class="trip-packing" hidden>
          <p class="trip-sub">Pack for the forecast</p>
          <ul class="trip-list" id="tkPackingList"></ul>
        </div>
      </div>
    )}
    </div>
    {days.length > 0 && (
      <button class="trip-goto" type="button" data-dest-go="itinerary">
        <span class="trip-goto-label">The plan</span>
        <span class="trip-goto-title">{days.length} days · {stopCount} stops</span>
        <span class="trip-goto-arrow" aria-hidden="true">→</span>
      </button>
    )}
  </section>


  {/* ═══ ACTIVE ═══ the cockpit, inside the frame (board 02): a left rail of standing
      answers, the day's stops as photo rows in the centre, today's route and its measured
      strip on the right. trip.js paints everything that depends on the destination clock. */}
  <section class="trip-phase trip-active" data-trip-phase="active" aria-label="Right now" hidden>
    <div class="tn-rail">
      {/* Identity: the trip's name, its dates, and how far into it today is. */}
      <div class="tn-card tn-ident">
        <h2 class="tn-ident-title">{guide.title}</h2>
        {dates && <p class="tn-ident-dates">{dates}</p>}
        <div class="tn-prog" data-trip-prog hidden>
          <p class="tn-prog-k" data-trip-prog-label></p>
          <div class="tn-prog-track"><span class="tn-prog-fill" data-trip-prog-fill></span></div>
        </div>
      </div>

      {/* Next stop — the second line of the hierarchy (§24), painted from today's focus. */}
      <div class="tn-card tn-nextstop" data-trip-nextstop hidden></div>

      {/* Weather now: today's row of the wired Open-Meteo forecast, nothing more. The board's
          current temperature, precipitation chance and wind are not in the payload the guide
          fetches, so they are not drawn. */}
      {hasWeather && <div class="tn-card tn-wx" data-wx-active hidden></div>}

      {/* Today's focus: the day's own title and one line. */}
      <div class="tn-card tn-focus" data-trip-focus hidden></div>

      {reservations.length > 0 && (
        <div class="tn-card tn-resv">
          <p class="tn-card-k">Booked &amp; dated</p>
          <ul class="tn-resv-list">
            {reservations.map((r) => (
              <li class="tn-resv-row">
                <span class="tn-resv-txt">{r.book && <span class="tools-flag">BOOK AHEAD</span>}<Fragment set:html={r.text} /></span>
                <span class="tn-resv-meta">by {r.due}{r.sourceUrl && <> · <a href={r.sourceUrl} target="_blank" rel="noopener">source</a></>}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <div class="tn-main">
      <div class="trip-now" data-trip-now aria-live="polite"></div>
      {days.length > 0 && (
        <button class="tn-full" type="button" data-dest-go="itinerary">
          <Icon name="calendar" size={16} /> View full itinerary
        </button>
      )}
    </div>

    <div class="tn-aside">
      {/* Today's route, spatially (§24 "Get there", board 02): the same located stops the
          Itinerary draws, filtered to today by trip.js. Nothing here is a second itinerary. */}
      {todayMapPayload && (
        <aside class="tn-map spatial" data-trip-map aria-label="Today on the map">
          <div class="tn-map-head"><span class="tn-map-k" data-trip-map-title>Today on the map</span><button class="tn-map-open" type="button" data-open-map-day="0" data-trip-map-open>Open the Map →</button></div>
          <div class="itin-map tn-map-mount" data-itin-map data-map-lens="today" data-map-day="0" data-map-primary={googlePrimary ? "google" : "osm"}>
            <script type="application/json" is:inline data-map-data set:html={todayMapPayload} />
            <iframe class="osmmap" loading="lazy" data-lazy-frame title="Map of today's stops"
              {...{ [frameSrcAttr]: `https://www.openstreetmap.org/export/embed.html?bbox=${bbox(center!, span)}&layer=mapnik&marker=${center!.lat}%2C${center!.lng}` }}></iframe>
            <p class="map-loading" data-map-loading aria-live="polite">Loading the map…</p>
            <p class="map-degraded" data-map-degraded hidden>Map tiles need a connection — the stops and their Get-there links still work.</p>
          </div>
        </aside>
      )}
      {/* Three measured cells — counted, summed and quoted from the day itself. The board's
          step count and estimated active time are not wired, so the strip does not show them. */}
      <dl class="tn-metrics" data-trip-metrics hidden></dl>
    </div>
  </section>

  {/* ═══ POST-TRIP ═══ */}
  <section class="trip-phase trip-post" data-trip-phase="post" aria-label="How it went" hidden>
    {recap ? (
      <div class="trip-recap">
        {learnings?.summary && <p class="trip-recap-lead"><Fragment set:html={learnings.summary} /></p>}
        <dl class="trip-atoms">
          {recap.hitStops !== null && <div class="trip-atom"><dt>Stops made</dt><dd>{recap.hitStops}<span class="trip-atom-of"> of {recap.plannedStops}</span></dd></div>}
          <div class="trip-atom"><dt>Days</dt><dd>{recap.dayCount}</dd></div>
          {recap.skippedStops > 0 && <div class="trip-atom"><dt>Skipped</dt><dd>{recap.skippedStops}</dd></div>}
        </dl>
        {recap.changedDays.length > 0 && (
          <div class="trip-block trip-pva">
            <h3 class="trip-h">Plan vs. actual</h3>
            {recap.changedDays.map((d) => (
              <div class="trip-pva-day">
                <p class="trip-pva-date">{d.date} <a class="trip-pva-link" href={`#${days.find((x) => x.date === d.date)?.anchor ?? "dest-itinerary"}`} data-dest-go="itinerary">Plan →</a></p>
                {d.actually && <p class="trip-pva-actually"><Fragment set:html={d.actually} /></p>}
                {d.skipped.length > 0 && (
                  <ul class="learn-skips">{d.skipped.map((s) => <li><span class="learn-skip-stop">✗ {s.stop}</span>{s.reason && <span class="learn-skip-why">{s.reason}</span>}</li>)}</ul>
                )}
              </div>
            ))}
          </div>
        )}
      </div>
    ) : (
      <p class="trip-recap-none">The trip is over. What worked and what didn't goes in the notebook below.</p>
    )}
  </section>

</div>
