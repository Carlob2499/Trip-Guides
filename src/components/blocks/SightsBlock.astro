---
import { pinSlug } from "../../lib/map-pins";
import { MOBILE_MAX } from "../../lib/breakpoints";
import { formatClosedDays } from "../../lib/closed-days.mjs";
import TransitLinks from "../TransitLinks.astro";
import ProvenancePopover from "../ProvenancePopover.astro";
import GapBlock from "../GapBlock.astro";
const { sec, country } = Astro.props;

// Wikimedia's Special:FilePath already supports ?width= thumbnailing —
// use that directly instead of pulling the image through Astro's optimizer.
// This avoids build-time HTTP fetches (and Wikimedia 429 rate-limits) while
// still giving the browser a proper responsive srcset.
const commonsSrc  = (f: string, w = 800) =>
  `https://commons.wikimedia.org/wiki/Special:FilePath/${encodeURIComponent(f)}?width=${w}`;
const commonsPage = (f: string) =>
  `https://commons.wikimedia.org/wiki/File:${encodeURIComponent(f)}`;
// One width-parameterized source fn for both photo paths — mirrors the masthead's
// mastSrcAt and the hub's stillSrcAt (uniform application across surfaces).
const imgSrcAt = (img: any, w: number) =>
  img.src ? img.src.replace("{w}", String(w)) : commonsSrc(img.file, w);
// A direct URL without a `{w}` token is single-size — offering a srcset of three
// identical URLs would just lie to the browser's selection algorithm.
const imgSrcset = (img: any) =>
  (img.file || img.src?.includes("{w}"))
    ? `${imgSrcAt(img, 480)} 480w, ${imgSrcAt(img, 800)} 800w, ${imgSrcAt(img, 1200)} 1200w`
    : undefined;
// Commons IS the credit (the File page carries author + license); a direct CDN photo
// carries its own zod-required credit, linking creditUrl when one is given.
const creditOf = (img: any) =>
  img.file ? { href: commonsPage(img.file), label: "Wikimedia Commons" }
  : { href: img.creditUrl ?? null, label: img.credit };
---
{(sec.items || []).map((it: any) => (
  it.state === "unconfirmed" ? (
    // D9 (Stage A.8): research came up short — the GapBlock replaces the guessed photo/
    // detail/transit-links a normal card would carry. The name still renders (the traveler
    // needs to know WHAT wasn't confirmed), but no provenance dot — there is nothing
    // confirmed yet for it to point at.
    <article class="card sight" id={it.map ? `sight-${pinSlug(it.name)}` : undefined}>
      <div class="sight-head">
        {it.kicker && <span class="tag">{it.kicker}</span>}
        <h4 class="sight-name">{it.name}</h4>
      </div>
      <div class="sight-body">
        <GapBlock body={it.body} instead={it.instead} />
      </div>
    </article>
  ) : (
  <article class={`card sight ${it.img ? "sight--photo" : "sight--text"}`} id={it.map ? `sight-${pinSlug(it.name)}` : undefined}>
    {it.img ? (
      /* Photo-forward: the image is the card hero with an overlaid caption
         (kicker + name), a legibility gradient, and a hover zoom. */
      <figure class="sight-media">
        <img class="cardimg" loading="lazy" decoding="async" alt={it.img.alt || it.name || ""}
          src={imgSrcAt(it.img, 800)}
          srcset={imgSrcset(it.img)}
          sizes={`(max-width:${MOBILE_MAX}px) 100vw, 420px`}
          onload="this.closest('.sight-media').classList.add('media-ok')"
          onerror="this.closest('.sight-media').classList.add('media-fail')" />
        <span class="sight-media-grad" aria-hidden="true"></span>
        <figcaption class="sight-media-cap">
          {it.kicker && <span class="tag tag--onphoto">{it.kicker}</span>}
          <h4 class="sight-name sight-name--onphoto">
            {it.name}
            <ProvenancePopover claim={it.name} verifiedOn={it.verified_on} sourceUrl={it.source_url}
                                shelfLife={it.shelf_life} tier={it.tier} onPhoto />
          </h4>
        </figcaption>
        {(() => { const c = creditOf(it.img); return c.href ? (
          <a class="imgcredit imgcredit--onphoto" href={c.href} target="_blank" rel="noopener" aria-label={`${c.label} — view source`}>{c.label} ↗</a>
        ) : (
          <span class="imgcredit imgcredit--onphoto">{c.label}</span>
        ); })()}
      </figure>
    ) : (
      <div class="sight-head">
        {it.kicker && <span class="tag">{it.kicker}</span>}
        <h4 class="sight-name">
          {it.name}
          <ProvenancePopover claim={it.name} verifiedOn={it.verified_on} sourceUrl={it.source_url}
                              shelfLife={it.shelf_life} tier={it.tier} />
        </h4>
      </div>
    )}
    <div class="sight-body">
      <p><Fragment set:html={it.body || ""} /></p>
      {formatClosedDays(it.closed_days) && <p class="sight-closed">{formatClosedDays(it.closed_days)}</p>}
      {it.map && (
        <TransitLinks lat={it.map.lat} lng={it.map.lng} name={it.name} country={country} placeId={it.place_id} />
      )}
    </div>
  </article>
  )
))}
