---
/* The itinerary timeline — one day card per authored day (design-system.md D6-20/34/35/46/49).

   Mobile: ONE day is the primary unit. Every card renders (the data is the same at every
   width), but itinerary.css shows only the selected day and the thumb-zone day rail (rendered
   by ItineraryDestination) moves between them. Desktop: the same cards stack as the timeline
   pane of the temporal-spatial workbench, beside the real map.

   Large atoms, not paragraphs: a stop is a numbered row with a big name, its time in the data
   face, a note, and the Get-there links. A day whose party splits renders each branch as its
   own labelled section rather than one fake linear route (D6-46). Plan ⇄ Actual stays per day
   for trips the maker has reflected on. Nothing here invents a time, a coordinate or a stop. */
import Icon from "../Icon.astro";
import TransitLinks from "../TransitLinks.astro";
import Fold from "../Fold.astro";
import { checklistText } from "../../lib/checklist";
import { dayRouteLink } from "../../lib/transit-links";
import { dayLegSummary } from "../../lib/anchors";
import { pinSlug } from "../../lib/map-pins";

interface ModuleLink { id: string; title: string; kind: string; critical: boolean; anchor: string }
const { sec, keyPrefix = "dy", learnings = null, country, modulesByDate = {} as Record<string, ModuleLink[]>, imageFor = null } = Astro.props;
/* The stop's own repository photo (guide-view.ts imageFor): identity, never decoration — a stop
   naming no sight/venue the guide photographed gets no picture (§4 Imagery). */
type PlaceImage = { src: string; srcset: string; alt: string } | null;
const imageOf = (name: string): PlaceImage => (typeof imageFor === "function" ? imageFor(name) : null);
const days: any[] = sec.items || [];
const two = (n: number) => String(n + 1).padStart(2, "0");
const actualFor = (date: string) => (learnings?.days ?? []).find((d: any) => d.date === date) ?? null;
const dayCount = days.length;
/* Knowledge modules deterministically related to a day (D6-53): at most two ordinary links,
   critical ones first and never capped — the itinerary is not an article feed. */
const linksFor = (date: string) => {
  const all: ModuleLink[] = modulesByDate[date] ?? [];
  const critical = all.filter((m) => m.critical);
  const rest = all.filter((m) => !m.critical).slice(0, Math.max(0, 2 - critical.length));
  return [...critical, ...rest];
};
/* The gap between two consecutive located stops, straight-line, in the day's own order. It is
   the only leg measure this product can honestly draw: nothing here routes, so no mode and no
   duration is stated — the board's "30 min walk" would be an invention. */
const legKm = (a: any, b: any): number | null => {
  if (!Number.isFinite(a?.lat) || !Number.isFinite(a?.lng) || !Number.isFinite(b?.lat) || !Number.isFinite(b?.lng)) return null;
  const R = 6371, rad = (d: number) => (d * Math.PI) / 180;
  const dLat = rad(b.lat - a.lat), dLng = rad(b.lng - a.lng);
  const h = Math.sin(dLat / 2) ** 2 + Math.cos(rad(a.lat)) * Math.cos(rad(b.lat)) * Math.sin(dLng / 2) ** 2;
  return 2 * R * Math.asin(Math.min(1, Math.sqrt(h)));
};
const KIND_LABEL: Record<string, string> = { howto: "How to", transit: "Transit", etiquette: "Etiquette", arrival: "Arrival", culture: "Culture", food: "Food", practical: "Practical" };
---
<div class="planner">
  <div class="planner-days" data-planner-days>
    {days.map((d: any, di: number) => {
      const shared = d.waypoints ?? [];
      const branches = d.branches ?? [];
      const routePoints = [...shared, ...branches.flatMap((b: any) => b.waypoints ?? [])];
      const leg = dayLegSummary(shared.length >= 2 ? shared : undefined);
      const route = branches.length ? null : dayRouteLink(shared);
      const actual = actualFor(d.date);
      const links = linksFor(d.date);
      return (
      <article class="day" data-day={di} data-date={d.date} id={`day-${di}`} hidden={di > 0} aria-labelledby={`day-${di}-title`}>
        <header class="day-head">
          <p class="d">
            <span class="day-num">{two(di)}</span>
            <span class="day-of">of {String(dayCount).padStart(2, "0")}</span>
            <span class="day-date">{d.date}</span>
            <span class="day-state" data-day-state hidden></span>
          </p>
          <h3 class="day-title" id={`day-${di}-title`}>{d.title}{d.constraints && d.constraints.length > 0 && <span class="cal-badge" title={d.constraints.join("; ")}><Icon name="calendar" size={14} /></span>}</h3>
          {d.tldr && <p class="day-tldr">{d.tldr}</p>}
          <div class="day-meta">
            {d.pace && <span class="day-pace"><Icon name="clock" size={14} /> {d.pace}</span>}
            <span class="day-sun" role="group" hidden></span>
          </div>
          {leg && (
            <p class="day-leg">
              <span>{leg.from}</span><span class="day-leg-arrow" aria-hidden="true">→</span><span>{leg.to}</span>
              {leg.km !== null && leg.km > 0 && <span class="day-leg-km" title="Straight-line distance between stops">· ≈{leg.km} km straight-line</span>}
            </p>
          )}
          {/* The day-level action slot (D6-37): a route/map control when the day has a mappable
              route, otherwise nothing — never a decorative Done. */}
          {routePoints.filter((w: any) => Number.isFinite(w.lat) && Number.isFinite(w.lng)).length >= 2 && (
            <button class="day-map-btn" type="button" data-open-map-day={di} aria-label={`Show ${d.date} on the map`}>
              <Icon name="map" size={15} /> This day on the map
            </button>
          )}
          {actual && (
            <div class="day-flip" role="group" aria-label="Plan or what actually happened">
              <button class="day-flip-btn on" type="button" data-flip="plan" aria-pressed="true">Plan</button>
              <button class="day-flip-btn" type="button" data-flip="actual" aria-pressed="false">Actually</button>
            </div>
          )}
        </header>
        <div class="b">
          {actual && (
            <div class="day-actual" hidden>
              {actual.actually && <p class="learn-actually"><Fragment set:html={actual.actually} /></p>}
              {(actual.skipped ?? []).length > 0 && (
                <>
                  <p class="learn-sub">Skipped</p>
                  <ul class="learn-skips">
                    {actual.skipped.map((s: any) => (
                      <li>
                        <span class="learn-skip-stop">✗ {s.stop}</span>
                        {s.reason && <span class="learn-skip-why">{s.reason}</span>}
                      </li>
                    ))}
                  </ul>
                </>
              )}
            </div>
          )}
          {links.length > 0 && (
            <nav class="day-know" aria-label="Know before you go">
              {links.map((m) => (
                <a class={`day-know-link${m.critical ? " day-know-link--critical" : ""}`} href={`#${m.anchor}`} data-guide-anchor={m.anchor}>
                  <span class="day-know-kind">{KIND_LABEL[m.kind] ?? m.kind}</span>
                  <span class="day-know-title">{m.title}</span>
                </a>
              ))}
            </nav>
          )}
          {shared.length > 0 && (
            <ol class="stops" aria-label="Stops this day">
              {shared.map((w: any, wi: number) => {
                const mapPinId = Number.isFinite(w.lat) && Number.isFinite(w.lng) ? `d${di}-${pinSlug(w.name)}-${wi}` : null;
                const im = imageOf(w.name);
                const gap = wi > 0 ? legKm(shared[wi - 1], w) : null;
                return (
                <>
                {gap !== null && (
                  <li class="stop-leg" aria-hidden="true">
                    <span class="stop-rail"></span>
                    <span class="stop-leg-txt">≈{gap < 10 ? gap.toFixed(1) : Math.round(gap)} km straight-line</span>
                  </li>
                )}
                <li class={`stop${im ? " stop--photo" : ""}`} data-map-stop={mapPinId ?? undefined} data-lat={Number.isFinite(w.lat) ? w.lat : undefined} data-lng={Number.isFinite(w.lng) ? w.lng : undefined}>
                  <span class="stop-rail" aria-hidden="true"></span>
                  <span class="stop-when">
                    {w.time && <span class="stop-time">{w.time}</span>}
                    <span class="stop-num">{String(wi + 1).padStart(2, "0")}</span>
                  </span>
                  {im && (
                    <span class="stop-media" aria-hidden="true">
                      <img class="stop-img" src={im.src} srcset={im.srcset || undefined} sizes="88px" alt="" loading="lazy" decoding="async"
                           onerror="this.closest('.stop').classList.remove('stop--photo');this.closest('.stop-media').hidden=true" />
                    </span>
                  )}
                  <span class="stop-main">
                    {mapPinId ? (
                      <button class="stop-name stop-map-focus" type="button" data-map-pin-id={mapPinId} aria-label={`Show ${w.name} on the map`}>{w.name}</button>
                    ) : <span class="stop-name">{w.name}</span>}
                    {w.note && <span class="stop-note">{w.note}</span>}
                    {Number.isFinite(w.lat) && Number.isFinite(w.lng) && (
                      <TransitLinks lat={w.lat} lng={w.lng} name={w.name} country={country} />
                    )}
                  </span>
                  {/* Pin to compare (§16): the desktop workbench holds at most two pinned stops
                      beside the map; a phone never shows the control. */}
                  <button class="stop-pin" type="button" data-pin-compare={`d${di}-s${wi}`} data-pin-day={String(di + 1)} data-pin-date={d.date}
                          aria-pressed="false" aria-label={`Pin ${w.name} to compare`} title="Pin to compare">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 17v5M8 3h8l-1 7 3 3H6l3-3z"/></svg>
                  </button>
                </li>
                </>
                );
              })}
            </ol>
          )}
          {branches.length > 0 && (
            <div class="day-branches" role="group" aria-label="The party splits">
              {branches.map((b: any, bi: number) => (
                <section class="day-branch" aria-labelledby={`day-${di}-branch-${bi}`}>
                  <h4 class="day-branch-label" id={`day-${di}-branch-${bi}`}>{b.label}</h4>
                  {b.body && <div class="day-branch-body"><Fragment set:html={b.body} /></div>}
                  {(b.waypoints ?? []).length > 0 && (
                    <ol class="stops" aria-label={`Stops for ${b.label}`}>
                      {b.waypoints.map((w: any, wi: number) => {
                        const im = imageOf(w.name);
                        return (
                        <li class={`stop${im ? " stop--photo" : ""}`} data-lat={Number.isFinite(w.lat) ? w.lat : undefined} data-lng={Number.isFinite(w.lng) ? w.lng : undefined}>
                          <span class="stop-rail" aria-hidden="true"></span>
                          <span class="stop-when">
                            {w.time && <span class="stop-time">{w.time}</span>}
                            <span class="stop-num">{String(wi + 1).padStart(2, "0")}</span>
                          </span>
                          {im && (
                            <span class="stop-media" aria-hidden="true">
                              <img class="stop-img" src={im.src} srcset={im.srcset || undefined} sizes="88px" alt="" loading="lazy" decoding="async"
                                   onerror="this.closest('.stop').classList.remove('stop--photo');this.closest('.stop-media').hidden=true" />
                            </span>
                          )}
                          <span class="stop-main">
                            <span class="stop-name">{w.name}</span>
                            {w.note && <span class="stop-note">{w.note}</span>}
                            {Number.isFinite(w.lat) && Number.isFinite(w.lng) && (
                              <TransitLinks lat={w.lat} lng={w.lng} name={w.name} country={country} />
                            )}
                          </span>
                        </li>
                        );
                      })}
                    </ol>
                  )}
                </section>
              ))}
            </div>
          )}
          {route && (
            <p class="day-route">
              <a class="day-route-link" href={route} target="_blank" rel="noopener">Open the whole day in Google Maps ↗</a>
              <span class="day-route-note">Stops in listed order — timing and traffic come from the map app, not this guide</span>
            </p>
          )}
          {d.plan_b && (
            <div class={`day-planb planb-${d.plan_b.trigger}`}>
              <span class="planb-label">{d.plan_b.trigger === "rain" ? "Rain plan" : "If it's closed"}</span>
              <span class="planb-body"><Fragment set:html={d.plan_b.body} /></span>
            </div>
          )}
          {d.note && <p class="lsnote"><Fragment set:html={d.note} /></p>}
          {d.body && (d.tldr
            ? <Fold id={`day-${di}`} lead={d.tldr} label={`More about ${d.title}`}><Fragment set:html={d.body} /></Fold>
            : <div class="day-body"><Fragment set:html={d.body} /></div>
          )}
          {d.fit && <p class="fit">Fit: <Fragment set:html={d.fit} /></p>}
          {d.checklist && d.checklist.length > 0 && (
            <div class="daykit">
              <span class="kit-label">Day kit <span class="day-kitcount" hidden aria-live="polite"></span></span>
              {d.checklist.map((i: any, j: number) => (
                <label class="check"><input type="checkbox" data-pkey={`${keyPrefix}-d${di}-${j}`} /><span class="check-txt"><Fragment set:html={checklistText(i)} /></span></label>
              ))}
            </div>
          )}
        </div>
      </article>
      );
    })}
  </div>
</div>
