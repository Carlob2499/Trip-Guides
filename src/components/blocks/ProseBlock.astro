---
// Density pass — same lead + "More detail" fold as PanelBlock (see lead-split.ts).
import { splitLead, moreDetailLabel } from "../../lib/lead-split";
const { sec } = Astro.props;
const { lead, more, moreParagraphCount, morePreview } = sec.collapsible
  ? { lead: sec.body, more: null, moreParagraphCount: 0, morePreview: "" }
  : splitLead(sec.body, sec.fold);
const label = moreDetailLabel(sec.moreLabel, moreParagraphCount);
---
{lead && <div class="card-lead" set:html={lead} />}
{more && (
  <div class="card-more-wrap">
    <details class="card-more">
      <summary class="card-more-sum">{label}</summary>
      <Fragment set:html={more} />
    </details>
    <p class="card-more-preview" aria-hidden="true">{morePreview}</p>
  </div>
)}
