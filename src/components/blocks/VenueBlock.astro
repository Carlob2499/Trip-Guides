---
import { pinSlug } from "../../lib/map-pins";
import TransitLinks from "../TransitLinks.astro";
const { sec, country } = Astro.props;

type VenueItem = {
  name: string;
  area?: string;
  price?: string;
  book?: string;
  book_url?: string;
  why?: string;
  crowd_tip?: string;
  hours?: string;
  closed?: string;
  address?: string;
  phone?: string;
  how?: string;
  verified_on?: string;
  source_url?: string;
  shelf_life?: string;
  tier?: string;
  agreement?: string;
  map?: { lat: number; lng: number };
};

const bookLabel = (b: string | undefined) =>
  b === "url" ? "Book online" : b === "call" ? "Call to book" : b === "walk-in" ? "Walk-in" : null;
---
{sec.intro && (
  <div class="venue-intro card"><p><Fragment set:html={sec.intro} /></p></div>
)}
{(sec.items || []).map((it: VenueItem) => (
  <article class="card venue" id={it.map ? `venue-${pinSlug(it.name)}` : undefined}>
    <div class="venue-head">
      <h4 class="venue-name">
        {it.name}
        {it.verified_on && (
          <>
            <button class="prov-dot" type="button" aria-label={`Source info for ${it.name}`}>●</button>
            {/* data-verified-on/data-shelf-life: provenance-dot.js reads these to inject a
                staleness reading on open — computed client-side (a build-time judgment would
                freeze "N days left" at deploy), same contract as staleness-ui.js's section pill. */}
            <dl class="prov-popover" data-verified-on={it.verified_on} data-shelf-life={it.shelf_life ?? "default"}>
              <dt>Checked</dt><dd>{it.verified_on}</dd>
              {it.source_url && <><dt>Source</dt><dd><a href={it.source_url} target="_blank" rel="noopener">{new URL(it.source_url).hostname}</a></dd></>}
              {it.tier && <><dt>Evidence</dt><dd>{it.tier}</dd></>}
              {it.agreement && <><dt>Research</dt><dd>{it.agreement}</dd></>}
            </dl>
          </>
        )}
      </h4>
      {it.area && <span class="venue-area">{it.area}</span>}
    </div>
    <div class="venue-meta">
      {it.price && <span class="venue-pill">{it.price}</span>}
      {bookLabel(it.book) && (
        it.book === "url" && it.book_url
          ? <a class="venue-pill venue-pill--action" href={it.book_url} target="_blank" rel="noopener">{bookLabel(it.book)} ↗</a>
          : <span class="venue-pill">{bookLabel(it.book)}</span>
      )}
    </div>
    <div class="venue-body">
      {it.why && <p class="venue-why">{it.why}</p>}
      {it.crowd_tip && <p class="venue-crowd"><Fragment set:html={it.crowd_tip} /></p>}
      <dl class="venue-details">
        {it.hours && <><dt>Hours</dt><dd>{it.hours}</dd></>}
        {it.closed && <><dt>Closed</dt><dd>{it.closed}</dd></>}
        {it.address && <><dt>Address</dt><dd>{it.address}</dd></>}
        {it.phone && <><dt>Phone</dt><dd>{it.phone}</dd></>}
        {it.how && <><dt>Getting there</dt><dd><Fragment set:html={it.how} /></dd></>}
      </dl>
      {it.map && (
        <TransitLinks lat={it.map.lat} lng={it.map.lng} name={it.name} country={country} />
      )}
    </div>
  </article>
))}
