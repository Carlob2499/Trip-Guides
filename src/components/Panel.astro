---
/* Panel — the Atlas container. Kicker, title, drag handle, collapse toggle, body.
   A Panel is a CONTAINER, never a content type: from Phase 2 a Panel *section*
   (content.config.ts's "type":"panel") renders INSIDE one of these. See CONTEXT.md
   for why the two share the word.

   Collapse is progressive, and the styles enforce it: every collapse rule is gated on
   `[data-panel-ready]`, which only src/features/panel/ sets. Until it does — and forever,
   with JS off — every Panel renders open and the toggle is not drawn, so a Panel that
   ships collapsed is still readable and no control is offered that cannot work.

   The drag handle is a real control, wired by src/features/panel/ (ui/reorder.js):
   drag to reorder, or arrow keys on the focused handle. Like the collapse toggle it
   is only DRAWN once that wiring exists ([data-panel-reorder]) — no JS, no handle. */
import Hint from "./Hint.astro";
interface Props {
  /** Stable id — the key this Panel's collapsed state is stored under. */
  id: string;
  /** The type label. On a collapsed Panel this is the only body-level thing visible. */
  kicker?: string;
  title: string;
  /** Start collapsed before the reader has any saved state for this Panel. */
  collapsed?: boolean;
  /** Span the entire grid row. A property of the Panel's TYPE — dense reference
      material (a sights list, a day's itinerary, a budget table) declares it;
      it is never inferred from how much content happens to be inside. */
  fullWidth?: boolean;
  /* ---- Guide-section identity (Phase 2). When a Panel hosts a guide section it IS
     the section's block — a wrapper is impossible, because reorder.js moves the grid's
     direct children. `anchorId` switches all of this on: the element carries the
     `.block` class, the `sec-N` HTML id (deep links, scrollspy), `data-cat`, and the
     provenance attrs staleness-ui.js reads. Absent, the Panel renders exactly as
     before — the design-study route passes none of these. */
  /** The section's HTML id (`sec-N`) — presence marks this Panel as a guide block. */
  anchorId?: string;
  /** Tab-group index for the scrollspy (`data-cat`). */
  cat?: number;
  /** Provenance trio for the staleness pill (schema's additive fields). */
  verifiedOn?: string;
  sourceUrl?: string;
  shelfLife?: string;
  /** Draw the `#` copy-link button (guide-ui.js wires every `.anchor-btn`). */
  anchorBtn?: boolean;
  /** Heading level for the title — 2 (default) standalone, 3 under a group's h2. */
  level?: 2 | 3;
  /* Creator ruling (2026-08-08): an explanation belongs behind a `?`, not under the title
     taking up space. A Panel that wants to say what it IS passes that sentence here and it
     becomes a hint beside the heading — see src/components/Hint.astro. */
  hint?: string;
}
const {
  id, kicker, title, collapsed = false, fullWidth = false,
  anchorId, cat, verifiedOn, sourceUrl, shelfLife, anchorBtn = false, level = 2, hint,
} = Astro.props;
const Heading = level === 3 ? "h3" : "h2";
/* The derived DOM ids are IDREF TARGETS (aria-controls, aria-labelledby), and aria-controls
   is a SPACE-SEPARATED list — so an id of "day 1" would silently point at two elements that
   don't exist and kill the disclosure relationship for assistive tech with nothing visibly
   wrong. Slugged here rather than trusted, because the caller's id is also a storage key and
   is not otherwise constrained. */
const slug = String(id).replace(/[^A-Za-z0-9_-]+/g, "-");
const bodyId = `pnl-body-${slug}`;
const titleId = `pnl-title-${slug}`;
/* A bare <section> with an accessible name gets an IMPLICIT role="region" below — a landmark.
   The enclosing tab group is already a labelled region of its own, and a group whose only
   content is one identically-titled Panel produces two indistinguishable "region" landmarks
   (found: Japan's Etiquette & language tab, axe landmark-unique). The explicit role="group"
   on the section isn't a landmark, so it can't collide with any ancestor's name — a Panel is
   a titled content cluster, not a page-level navigation target. */
---

<section
  class:list={["pnl", fullWidth && "pnl--full", anchorId && "block"]}
  id={anchorId}
  data-cat={anchorId != null ? cat : null}
  data-verified-on={verifiedOn}
  data-source-url={sourceUrl}
  data-shelf-life={shelfLife}
  data-panel={id}
  data-panel-full={fullWidth ? "1" : null}
  data-collapsed={collapsed ? "1" : null}
  aria-labelledby={titleId}
  role="group"
>
  <header class="pnl-head">
    <button class="pnl-grip" type="button" data-panel-grip aria-label={`Move ${title}. Use arrow keys to reorder.`}>
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><g fill="currentColor">
        <circle cx="6" cy="3.5" r="1.35" /><circle cx="10" cy="3.5" r="1.35" />
        <circle cx="6" cy="8" r="1.35" /><circle cx="10" cy="8" r="1.35" />
        <circle cx="6" cy="12.5" r="1.35" /><circle cx="10" cy="12.5" r="1.35" />
      </g></svg>
    </button>
    <div class="pnl-headings">
      {kicker && <p class="pnl-kicker">{kicker}</p>}
      {/* The hint sits BESIDE the heading, never inside it. The section is
          aria-labelledby={titleId}, and accessible-name computation walks that element's whole
          subtree — with the Hint inside, every hinted panel announced its title plus the "?"
          plus the entire tooltip paragraph as its name ("What everyone actually spent?The same
          ledger as the calculator…"). Found in review, 2026-08-09. */}
      <div class="pnl-title-row">
        <Heading class="pnl-title" id={titleId}>{title}</Heading>
        {hint && <Hint text={hint} label={title} />}
      </div>
    </div>
    {anchorBtn && anchorId && (
      <button class="anchor-btn" data-sid={anchorId} type="button"
              title="Copy link to this section" aria-label="Copy link to this section">#</button>
    )}
    <button
      class="pnl-toggle"
      type="button"
      data-panel-toggle
      aria-expanded={collapsed ? "false" : "true"}
      aria-controls={bodyId}
    >
      <span class="pnl-sr">{title}</span>
      <svg class="pnl-chev" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
        <path d="M4 6.2 8 10.2l4-4" fill="none" stroke="currentColor" stroke-width="1.8"
          stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </header>
  <div class="pnl-body" id={bodyId} data-panel-body>
    <div class="pnl-body-in"><slot /></div>
  </div>
</section>
