---
/* The guided "Request a change" wizard's markup. Ships on every guide page, inert until
   src/features/change-request wires it up — and if JS never runs, the footer pill it hangs
   off is still a real link to the same prefilled GitHub issue, so the flow degrades to
   exactly what shipped before this component existed. */
import "../features/change-request/styles.css";
const { repo, slug } = Astro.props;
---

<div class="cr-backdrop" id="crBackdrop" aria-hidden="true"></div>
<div
  class="cr-modal"
  id="crModal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="crHead"
  data-repo={repo}
  data-slug={slug}
  hidden
>
  <p class="cr-head" id="crHead">
    Request a change
    <button class="cr-close" type="button" data-cr-close aria-label="Close">✕</button>
  </p>
  <p class="cr-step-of" data-cr-stepof>Step 1 of 3</p>

  <!-- Step 1 — which tab -->
  <div data-cr-pane>
    <p class="cr-intro">Which part of this guide is wrong? Pick the tab it's on — or skip it if you're not sure.</p>
    <div class="cr-options" data-cr-options role="group" aria-label="Which tab"></div>
    <p class="cr-hint" data-cr-hint></p>
  </div>

  <!-- Step 2 — what's wrong -->
  <div data-cr-pane hidden>
    <label class="cr-label" for="crChange">What needs to change</label>
    <textarea
      class="cr-textarea"
      id="crChange"
      data-cr-change
      placeholder="e.g. Admission is 145 DKK now, not 125 — the museum's own site says so."
    ></textarea>
    <p class="cr-count" data-cr-count></p>
    <p class="cr-err" data-cr-err role="alert"></p>
  </div>

  <!-- Step 3 — review. The GitHub wording is the no-JS/unconfigured DEFAULT; the wizard swaps
       both this line and the footer to the worker wording when that path is live (MODE_COPY in
       features/change-request/model). Never author the promise in two places. -->
  <div data-cr-pane hidden>
    <p class="cr-intro" data-cr-review-note>Here's what gets sent. You'll see it again on GitHub before anything is filed.</p>
    <dl class="cr-review" data-cr-review></dl>
    <p class="cr-err" data-cr-send-err role="alert"></p>
  </div>

  <p class="cr-sent" data-cr-sent tabindex="-1" hidden></p>

  <div class="cr-nav">
    <button class="cr-btn" type="button" data-cr-back hidden>← Back</button>
    <button class="cr-btn cr-btn-primary" type="button" data-cr-next>Next</button>
  </div>
  <p class="cr-foot" data-cr-foot>
    Opens a prefilled GitHub issue — you press submit. Filing it changes nothing on its own;
    the site owner reviews every request before any edit runs.
  </p>
</div>
