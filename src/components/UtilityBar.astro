---
/* The one top strip for every page that is not the Atlas or a guide: intake, progress, triage,
   change request, about, health, 404. Same wordmark, same way back, same theme control — so the
   product reads as one product off its main surfaces too (design-system.md §5). The guide shell
   (AppChrome) is not reused here on purpose: these pages have no destinations to navigate. */
import "../styles/utility-bar.css";
interface Props {
  base: string;
  /** id of the theme button — pages that already wire one keep their id. */
  toggleId?: string;
  /** measure of the page's own column, so the strip lines up with the content below it. */
  maxWidth?: string;
}
const { base, toggleId = "btnDark", maxWidth = "74rem" } = Astro.props;
---
<header class="ubar" style={`--ubar-max:${maxWidth}`}>
  <a class="ubar-home" href={`${base}/`}>
    <svg class="ubar-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
    <span class="ubar-wordmark">Waypoint</span>
    <span class="ubar-atlas">Atlas</span>
  </a>
  <div class="ubar-right">
    <slot />
    <button type="button" class="ubar-btn" id={toggleId} aria-label="Switch to dark mode" title="Switch to dark mode"></button>
  </div>
</header>
