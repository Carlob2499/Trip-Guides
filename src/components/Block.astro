---
// Renders ONE section by routing to the appropriate sub-component in blocks/.
// To add a new section type:
//   1. Add it to content.config.ts (the schema is the source of truth).
//   2. Create src/components/blocks/<Type>Block.astro.
//   3. Add it to the import list and the routing below.
//   4. Update the `carded` list if the type should render inside a .card wrapper.
import PanelBlock  from "./blocks/PanelBlock.astro";
import ProseBlock  from "./blocks/ProseBlock.astro";
import ListBlock   from "./blocks/ListBlock.astro";
import RoutesBlock from "./blocks/RoutesBlock.astro";
import MapBlock    from "./blocks/MapBlock.astro";
import BudgetBlock from "./blocks/BudgetBlock.astro";
import DaysBlock   from "./blocks/DaysBlock.astro";
import SightsBlock from "./blocks/SightsBlock.astro";
import RaidBlock   from "./blocks/RaidBlock.astro";
import HabitatsBlock from "./blocks/HabitatsBlock.astro";
import InfoGridBlock from "./blocks/InfoGridBlock.astro";
import TierListBlock from "./blocks/TierListBlock.astro";
import WeatherBlock from "./blocks/WeatherBlock.astro";
import HolidaysBlock from "./blocks/HolidaysBlock.astro";
import VenueBlock from "./blocks/VenueBlock.astro";
import DivergencesBlock from "./blocks/DivergencesBlock.astro";
import Panel from "./Panel.astro";
import { CARDED_TYPES, FULL_WIDTH_PANEL_TYPES } from "../lib/section-types";

// `holidays` is the server-computed holiday info (or null), threaded down from
// GuideLayout; only the `holidays` section type uses it. `learnings` is the guide's
// optional curated post-mortem (or null), threaded the same way; only `days` uses it,
// to grow a per-day Plan ⇄ Actual toggle on the days it has an entry for. `country`
// drives TransitLinks' country-native app row (days/sights only).
// `panelHost` (Atlas Phase 2): the section renders as a Panel — the grid's direct
// child, absorbing the block identity — instead of the legacy .block/.card wrapper.
// Only GuideLayout sets it, for groups the guide's `panelGroups` meta names.
const { sec, sid, ci, solo, holidays, learnings, mapPins, country, panelHost = false } = Astro.props;

// Stable key prefix for checklist items — based on section index, not content.
// Changing item text does not change its saved state; adding/removing items at
// the end is safe. Adding in the middle shifts later keys (acceptable tradeoff).
const keyPrefix = sid.replace(/^sec-/, "s");

const titleText = solo ? "" : (sec.title || "");

// Types that render their content inside a shared .card wrapper.
// days and sights render their own per-item .card elements instead.
// The set lives in lib/section-types.ts — the schema's panelGroups check reads the
// same one, so "what a Panel can host" can't drift between renderer and gate.
const carded = CARDED_TYPES.has(sec.type);

// A Panel host needs a title (it IS the Panel's title) and a carded type; anything
// else falls back to the legacy render rather than half-wrapping. The schema refuses
// panelGroups that violate this, so the fallback is a belt, not a path.
const asPanel = panelHost && carded && !!sec.title;

// Opt-in per-section collapse/expand (content.config.ts `collapse` fields). Renders
// the whole card as a native <details>/<summary> instead of a plain div — tap the
// title to fold it away. The anchor (#) button sits OUTSIDE <summary> (as a sibling,
// positioned absolute) so tapping it copies the link instead of also toggling open/closed.
const isCollapsible = carded && sec.collapsible === true;
const CardTag = isCollapsible ? "details" : "div";
const cardProps = isCollapsible ? { open: sec.defaultOpen !== false } : {};
const TitleTag = isCollapsible ? "summary" : "div";
---
{/* Structured provenance (content.config.ts `provenance`) rides as data attrs;
    staleness-ui.js judges shelf life client-side (live clock — a static build
    date would freeze "fresh" forever) and pins a warn pill on stale sections.
    Sections without verified_on render exactly as before. */}
{/* Phase 2: when a Panel hosts the section it IS the block — one element carrying the
    anchor id, data-cat, and provenance attrs, because reorder.js moves the grid's
    DIRECT children and a wrapper would strand the identity outside the moved node. */}
{asPanel ? (
  <Panel
    id={sec.title}
    title={sec.title}
    anchorId={sid}
    cat={ci}
    level={3}
    verifiedOn={sec.verified_on}
    sourceUrl={sec.source_url}
    shelfLife={sec.shelf_life}
    fullWidth={FULL_WIDTH_PANEL_TYPES.has(sec.type)}
    collapsed={sec.collapsible === true && sec.defaultOpen === false}
    anchorBtn={true}
  >
    {/* Bodies render WHOLE inside a Panel (`whole`): the Panel's collapse is the one
        disclosure per card — stacking splitLead's "More detail" fold inside it would
        be the nested-details pattern PanelBlock already refuses. */}
    {sec.type === "panel"  && <PanelBlock  sec={sec} keyPrefix={keyPrefix} whole={true} />}
    {sec.type === "prose"  && <ProseBlock  sec={sec} whole={true} />}
    {sec.type === "list"   && <ListBlock   sec={sec} keyPrefix={keyPrefix} />}
    {sec.type === "routes" && <RoutesBlock sec={sec} keyPrefix={keyPrefix} />}
    {sec.type === "map"    && <MapBlock    sec={sec} pins={mapPins} />}
    {sec.type === "budget" && <BudgetBlock sec={sec} />}
    {sec.type === "raids"  && <RaidBlock   sec={sec} />}
    {sec.type === "habitats" && <HabitatsBlock sec={sec} />}
    {sec.type === "infogrid" && <InfoGridBlock sec={sec} />}
    {sec.type === "tierlist" && <TierListBlock sec={sec} />}
  </Panel>
) : (
<section class="block" id={sid} data-cat={ci}
         data-verified-on={sec.verified_on} data-source-url={sec.source_url}
         data-shelf-life={sec.shelf_life}>
  {carded ? (
    <CardTag class={`card${isCollapsible ? " is-collapsible" : ""}`} {...cardProps}>
      {titleText && (
        <TitleTag class="block-title-row">
          <h3 class="block-title">{titleText}</h3>
          {!isCollapsible && (
            <button class="anchor-btn" data-sid={sid} type="button"
                    title="Copy link to this section" aria-label="Copy link to this section">#</button>
          )}
        </TitleTag>
      )}
      {isCollapsible ? (
        <>
          <button class="anchor-btn" data-sid={sid} type="button"
                  title="Copy link to this section" aria-label="Copy link to this section">#</button>
          <div class="block-body">
            {sec.type === "panel"  && <PanelBlock  sec={sec} keyPrefix={keyPrefix} />}
            {sec.type === "prose"  && <ProseBlock  sec={sec} />}
            {sec.type === "list"   && <ListBlock   sec={sec} keyPrefix={keyPrefix} />}
            {sec.type === "routes" && <RoutesBlock sec={sec} keyPrefix={keyPrefix} />}
            {sec.type === "map"    && <MapBlock    sec={sec} pins={mapPins} />}
            {sec.type === "budget" && <BudgetBlock sec={sec} />}
            {sec.type === "raids"  && <RaidBlock   sec={sec} />}
            {sec.type === "habitats" && <HabitatsBlock sec={sec} />}
            {sec.type === "infogrid" && <InfoGridBlock sec={sec} />}
            {sec.type === "tierlist" && <TierListBlock sec={sec} />}
          </div>
        </>
      ) : (
        <>
          {sec.type === "panel"  && <PanelBlock  sec={sec} keyPrefix={keyPrefix} />}
          {sec.type === "prose"  && <ProseBlock  sec={sec} />}
          {sec.type === "list"   && <ListBlock   sec={sec} keyPrefix={keyPrefix} />}
          {sec.type === "routes" && <RoutesBlock sec={sec} keyPrefix={keyPrefix} />}
          {sec.type === "map"    && <MapBlock    sec={sec} pins={mapPins} />}
          {sec.type === "budget" && <BudgetBlock sec={sec} />}
          {sec.type === "raids"  && <RaidBlock   sec={sec} />}
          {sec.type === "habitats" && <HabitatsBlock sec={sec} />}
          {sec.type === "infogrid" && <InfoGridBlock sec={sec} />}
          {sec.type === "tierlist" && <TierListBlock sec={sec} />}
        </>
      )}
    </CardTag>
  ) : sec.type === "weather" ? (
    // Weather renders its own title INSIDE the hidden wrapper, so a failed fetch
    // (wrapper stays hidden) leaves no orphaned heading — hence no block-title-row here.
    <WeatherBlock sec={sec} title={titleText} />
  ) : sec.type === "holidays" ? (
    // Holidays likewise keeps its title inside the wrapper, which is hidden when
    // there's no data for the country/year — so no orphaned heading on empty data.
    <HolidaysBlock sec={sec} title={titleText} info={holidays} />
  ) : (
    <>
      {titleText && (
        <div class="block-title-row">
          <h3 class="block-title">{titleText}</h3>
          <button class="anchor-btn" data-sid={sid} type="button"
                  title="Copy link to this section" aria-label="Copy link to this section">#</button>
        </div>
      )}
      {sec.type === "days"   && <DaysBlock   sec={sec} keyPrefix={keyPrefix} learnings={learnings} country={country} />}
      {sec.type === "sights" && <SightsBlock sec={sec} country={country} />}
      {sec.type === "venues" && <VenueBlock sec={sec} country={country} />}
      {sec.type === "divergences" && <DivergencesBlock sec={sec} />}
    </>
  )}
</section>
)}
