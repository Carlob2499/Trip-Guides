---
interface Props {
  storeKey: string;
  /* On the standalone Tools screen the calculator is not one of a guide's tab panels —
     it IS the panel, already on screen. It therefore drops the tabpanel role (there is no
     tab labelling it there; an orphaned aria-labelledby points at nothing) and is not
     hidden, since nothing would ever unhide it. Same markup, same ids, same ledger. */
  standalone?: boolean;
}
const { storeKey, standalone = false } = Astro.props;
---

<!-- Behavior lives in the src/features/trip-split silo (imported in the GuideLayout
     bundle via its index.ts) — the id-keyed calculator + settlement + minor-unit split
     engine, plus (when Firebase is configured) the shared live room. Markup only.

     ORDER IS THE DESIGN (2026-08-02): people → what you spent → what it means. The panel
     used to read People → Total → Results → Expenses, which put the entry form at the very
     bottom and the answer ~500px above it: you typed an expense and the number it changed
     was off-screen behind you. Cause now precedes effect, so the results card is always the
     thing below the row you just filled in. -->
<div class="split-wrap" id="tripSplit" role={standalone ? undefined : "tabpanel"}
     aria-labelledby={standalone ? undefined : "gtab-split"} hidden={!standalone} data-sk={storeKey}>

  <div class="split-toolbar">
    <h2 class="split-title">Budget split</h2>
    <p class="split-desc">Add who paid what. See who owes who, with the fewest transfers.</p>
    <!-- Revealed by trip-split.js only once there is spending to summarise — an empty
         budget has no summary, and a button that prints a blank sheet is a broken promise. -->
    <div class="split-save-actions">
      <button class="split-pdf-btn" id="sSavePdf" type="button" hidden>
        <span class="split-pdf-ico" aria-hidden="true">⎙</span>Save summary as PDF
      </button>
    </div>
  </div>

  <!-- Shared live budget: everyone viewing this guide edits ONE budget automatically —
       no code, no setup, no buttons. This is a passive status line only; trip-split.js
       reveals it once it knows whether live sync is available (src/features/firebase). -->
  <div class="split-live" id="sLive" data-state="connecting" hidden>
    <span class="split-live-dot" aria-hidden="true"></span>
    <span class="split-live-text" id="sLiveText">Connecting to your group’s live budget…</span>
  </div>

  <!-- Room-visibility notice: this room is world-readable by design (zero-setup shared link),
       so anyone who has the guide link can read the names + payment handles added here. Shown
       only once sync is actually LIVE (local-only mode exposes nothing) — revealed by
       trip-split.js's setLive("live"). -->
  <p class="split-privacy" id="sPrivacy" hidden>
    Anyone with this guide’s link can see the names and payment handles you add here — don’t add anything you wouldn’t share with the group.
  </p>

  <!-- 1 · People -->
  <div class="split-card">
    <div class="sc-head">
      <span class="sc-label">People on this trip</span>
      <button class="sc-add-btn" id="sAddPerson" type="button">+ Add person</button>
    </div>
    <div class="sc-body" id="sMemberList">
      <p class="split-empty">Add the people splitting costs.</p>
    </div>
  </div>

  <!-- 2 · Expenses.
       The old trip-wide ÷Even/Custom toggle is gone: how an expense splits is a property of
       THAT expense now (open a row's Details), because one flag for the whole trip could not
       express dinner-split-evenly alongside a hotel split 70/30. -->
  <div class="split-card">
    <div class="sc-head">
      <span class="sc-label">Expenses</span>
    </div>
    <!-- Add-expense box — boxed off so it never reads as a blank/broken row. -->
    <div class="se-new-card" id="sNewCard">
      <div class="se-new-head">
        <span class="sc-label">Add expense</span>
        <button class="sc-add-expense-btn" id="sAddExpense" type="button">+ Add expense</button>
      </div>
      <div class="se-new-row">
        <input class="split-in se-desc" type="text" placeholder="What for?" id="sNewDesc" aria-label="What the expense was for" />
        <select class="split-in se-payer" id="sNewPayer" aria-label="Who paid"></select>
        <div class="se-amt-wrap">
          <!-- Populated by trip-split.js with [local currency, USD] on a guide that has one;
               it stays hidden on a dollar destination, where the choice is not a choice. -->
          <select class="se-cur-sel" id="sNewCur" aria-label="Currency" hidden></select>
          <input class="split-in se-amt" type="number" min="0" step="any" inputmode="decimal" placeholder="0.00" id="sNewAmt" aria-label="Amount" />
        </div>
      </div>
    </div>

    <!-- Suggestions only — the field stays free text, so a trip can invent its own. -->
    <datalist id="sCatList">
      <option value="Food"></option>
      <option value="Transport"></option>
      <option value="Lodging"></option>
      <option value="Activities"></option>
      <option value="Shopping"></option>
      <option value="Drinks"></option>
      <option value="Fees"></option>
    </datalist>

    <!-- Find one expense among many. Lives OUTSIDE the list container on purpose: the list
         is rebuilt on every keystroke, and a search box inside it would lose focus after
         each character. Revealed by trip-split.js only once the list is long enough to be
         worth searching. -->
    <div class="se-filter" id="sFilter" hidden>
      <input class="split-in se-filter-q" type="search" id="sFilterQ" placeholder="Search expenses…" aria-label="Search expenses" />
      <select class="split-in se-filter-sel" id="sFilterWho" aria-label="Filter by person"></select>
      <select class="split-in se-filter-sel" id="sFilterCat" aria-label="Filter by category"></select>
      <button class="se-filter-clear" id="sFilterClear" type="button" hidden>Clear</button>
      <p class="se-filter-note" id="sFilterNote" role="status" hidden></p>
    </div>

    <!-- Column labels belong to the DESKTOP row grid; on phones the rows restack and the
         header would be labelling columns that no longer exist, so CSS hides it there. -->
    <div class="se-header">
      <span class="se-h-desc">What for</span>
      <span class="se-h-payer">Paid by</span>
      <span class="se-h-amt">Amount</span>
    </div>
    <div class="sc-body" id="sExpenseList">
      <p class="split-empty">Add people first, then record who paid what.</p>
    </div>
  </div>

  <!-- 3 · What it means. The total used to float between cards as a lone bar; it is the
       headline of this card, not a fifth sibling. -->
  <div class="split-card split-results-card" id="sResults" hidden>
    <div class="sr-total">
      <span class="sr-total-lbl">Total spend</span>
      <span class="sr-total-val" id="sTotalUSD">$0.00</span>
    </div>

    <div class="sr-sec">
      <span class="sc-label">Balances</span>
      <div id="sBalances"></div>
    </div>

    <div class="sr-sec">
      <div class="split-settle-head">
        <span class="sc-label">Who pays who</span>
        <span class="split-settle-count" id="sSettleCount"></span>
        <button class="sc-add-btn" id="sCopySettle" type="button">⧉ Copy</button>
      </div>
      <div id="sSettlements"></div>
    </div>

    <!-- Settling is RECORDED, not just suggested. Without this the tool recomputes the same
         transfer forever and can never say a trip is done. Revealed once a payment exists. -->
    <div class="sr-sec" id="sPaid" hidden>
      <span class="sc-label">Already settled</span>
      <div id="sPaidList"></div>
    </div>

    <!-- Where it went. Hidden until at least one expense carries a category — an all-
         "Uncategorised" chart teaches nothing. -->
    <div class="sr-sec" id="sCategories" hidden>
      <span class="sc-label">Where it went</span>
      <div id="sCatBreakdown"></div>
    </div>
  </div>

  <!-- Undo for the one action here that destroys something nobody can reconstruct. Fixed to
       the bottom of the viewport on purpose: the × that deletes an expense can be forty rows
       down, so an undo anchored to the top of the panel would appear off-screen — exactly
       where it is not. It lives INSIDE the tabpanel so leaving the Budget tab takes it with
       it (the panel's `hidden` removes its descendants from layout). -->
  <div class="split-undo" id="sUndo" role="status" aria-live="polite" hidden>
    <span class="su-text" id="sUndoText"></span>
    <button class="su-btn" id="sUndoBtn" type="button">Undo</button>
    <button class="su-x" id="sUndoDismiss" type="button" aria-label="Dismiss">×</button>
  </div>

</div>
