---
import { getCollection } from "astro:content";
import Block from "../components/Block.astro";
import Icon from "../components/Icon.astro";
import PwaHead from "../components/PwaHead.astro";
import { jsonEmbed } from "../lib/json-embed";
import TripSplit from "../components/TripSplit.astro";
import Voting from "../components/Voting.astro";
import Learnings from "../components/Learnings.astro";
import Reminders from "../components/Reminders.astro";
import TripKit from "../components/TripKit.astro";
import { bucket } from "../lib/buckets";
import { emergencyFor, FALLBACK_RATES_AS_OF } from "../data/countries.mjs";
import { buildModifyIssueUrl } from "../lib/modify-schema.mjs";
import { currencyFor, tzFor, COUNTRY_CODES } from "../lib/themes";
import { paletteFor, accentForGuide } from "../lib/palettes";
import { accentTokens, accentStyle } from "../lib/accent-tokens";
import PaintedAtlas from "../components/PaintedAtlas.astro";
import ChangeRequest from "../components/ChangeRequest.astro";
import { buildHolidayInfo, deriveTripYear } from "../lib/holidays";
import { computeGuideStats, latestVerifiedOn } from "../lib/guide-stats";
import { sheetOrder, ordinalFor } from "../lib/sheet-order";
import { firstDayDateOf, lastDayDateOf } from "../features/atlas/index";
import { collectWaypoints, collectDayEvents, buildSummary } from "../features/exports/index";
// slotLabel only — the silo's DOM boot is guarded by `typeof document`, so importing its
// public surface at build time is inert (the sealed-silo contract: index is the only door).
import { slotLabel } from "../features/mobile-nav/index.js";
// Self-hosted variable fonts (bundled, base-path-safe, offline-correct) — no CDN.
// Quiet Edition (R1): ONE serif — Literata with its optical-size axis (standard = wght+opsz,
// so browsers cut display vs text automatically) — and ONE quiet humanist sans for data/labels.
import "@fontsource-variable/literata/standard.css";
import "@fontsource-variable/literata/standard-italic.css";
import "@fontsource-variable/source-sans-3";
import "../styles/base.css";
import "../styles/guide.css";
import "../styles/print.css";
import "../styles/trip-split.css";
import "../styles/masthead.css";
import "../styles/painted-atlas.css";
import "../styles/anchors.css";
import "../styles/sights.css";
import "../styles/venues.css";
import "../styles/divergences.css";
import "../styles/provenance-dot.css";
import "../styles/gap-block.css";
import "../styles/map.css";
import "../styles/planner.css";
import "../styles/overview.css";
import "../styles/flight.css";
import "../styles/mobile-nav.css";
import "../styles/field-tools.css";
import "../styles/palette.css";
import "../styles/print-day.css";
import "../styles/budget-sheet.css";
import "../styles/transitions.css";
import "../styles/story-mode.css";
import "../styles/scroll-motion.css";
import "../features/firebase/styles.css";
import "../features/route-opt/styles.css";
import "../features/budget-pact/styles.css";
import "../features/panel/styles.css";
// touch.css LAST: its @media(hover:none) block overrides hover rules from every
// stylesheet above, and equal-specificity rules are decided by source order.
import "../styles/touch.css";
import { derivePins } from "../lib/map-pins";

// Build-time public-holiday data (Nager.Date), written by scripts/fetch-holidays.mjs
// into src/data/holidays/{CC}-{year}.json and refreshed by CI before each build.
// Eagerly imported so it's inlined at build with no client fetch. Empty object if
// no files exist yet — the holiday block then simply hides.
const holidayData = import.meta.glob("../data/holidays/*.json", { eager: true, import: "default" }) as Record<string, any[]>;

// Same repo identifier index.astro's New-guide modal already uses for its
// prefilled-issue link — kept as a local constant there too (no shared
// site-config module exists yet for a single string this small).
const REPO = "Carlob2499/Trip-Guides";

const { guide } = Astro.props;
const { order, byG } = bucket(guide.sections);

// R2 (Living Atlas): the mobile bar's Map destination deep-links to the guide's first
// map section — and simply doesn't render when a guide has none (honest blank).
let navMapCat: number | null = null, navMapSec: number | null = null;
order.forEach((g: string, ci: number) => (byG[g] || []).forEach((o: any) => {
  if (navMapSec === null && o.s.type === "map") { navMapCat = ci; navMapSec = o.i; }
}));

// The jet-lag calculator is an ARRIVAL tool, and it used to sit above EVERY tab of every
// guide (creator, 2026-07-30: "quite useless and doesn't need to be there on every screen,
// especially on the Days tab"). It now shows on ONE group — the one whose own content
// already covers jet lag or arrival — and guide-ui hides it entirely once the trip is over.
// Derived from the guide's own section titles; no new field, and a guide with no such
// section keeps it on the first group, where planning lives.
let jlGroup: number | null = null;
order.forEach((g: string, ci: number) => (byG[g] || []).forEach((o: any) => {
  const t = String(o.s.title ?? o.s.name ?? "");
  if (jlGroup === null && /jet[\s-]?lag|arriv|when you land/i.test(t)) jlGroup = ci;
}));
const jlGroupIdx = jlGroup ?? 0;

// Tab-bar display shortening: long compound group names crowd the tab strip
// (Korea has 13 tabs; names run to 20 chars). Display-only — the full name
// stays in aria-label, the sheet, the dial, and the chapter opener. Data is
// untouched. Rule: names over 13 chars split at " & " keep the head.
const shortLabel = (g: string) =>
  g.length > 13 && g.includes(" & ") ? g.split(" & ")[0] : g;

// Chapter-opener photo fans: a group whose sections already carry verified
// Commons images (sights) gets up to three of its OWN photos fanned beside
// the opener numeral. Pure derivation — no new sourcing, no invented files.
const groupImgs: Record<string, { file?: string; src?: string; alt: string }[]> = {};
for (const g of order) {
  const imgs = byG[g]
    .filter((o: any) => o.s.type === "sights")
    .flatMap((o: any) => o.s.items || [])
    .filter((it: any) => it?.img?.file || it?.img?.src)
    .slice(0, 3)
    .map((it: any) => ({ file: it.img.file, src: it.img.src, alt: it.img.alt || it.name || "" }));
  if (imgs.length) groupImgs[g] = imgs;
}
const thumbSrc = (im: { file?: string; src?: string }) =>
  im.src ? im.src.replace("{w}", "320")
  : `https://commons.wikimedia.org/wiki/Special:FilePath/${encodeURIComponent(im.file!)}?width=320`;
// Accent precedence (src/lib/palettes.ts — the SAME resolution the hub + OG use):
// explicit `theme` (zod-gated) → palette extracted from this guide's own cover photo
// (`npm run extract-palette`, gated at generation) → country accent. The V4 identity
// engine: a guide's colours come from its own imagery, and a guide with neither an
// explicit theme nor an extracted palette keeps the country colour, unchanged.
const guideSlug = Astro.url.pathname.split("/").filter(Boolean).pop() ?? "";
const extracted = paletteFor(guideSlug);
const accent  = accentForGuide(guideSlug, guide.theme, guide.country);
// Text shade comes from accentTokens (src/lib/accent-tokens.ts) — the SAME derivation the hub
// card uses. It used to be `darken(accent, 0.14)` here and the palette's `secondary` there, which
// is how one token name ended up meaning two colours and shipping 3.32:1 link text.
const tokens = accentTokens(accent, extracted?.accent);
const themePrimary   = guide.theme?.primary   ?? extracted?.primary   ?? accent;
const themeSecondary = guide.theme?.secondary ?? extracted?.secondary ?? accent;
const themeAccent    = guide.theme?.accent    ?? extracted?.accent    ?? accent;
// R8: storeKey namespaces every per-device localStorage/sessionStorage key (checklists,
// budget, saved tab, scroll memory, field-tools stop check-off) — it MUST be unique per
// guide. Deriving it from the TITLE let two similarly-titled guides collide and share all
// of that storage. The slug is the guide's actual unique identity (it's the URL path
// segment), so it's what this derives from now. `legacyStoreKey` is kept only so
// guide-ui.js/scroll-memory.js/field-tools.js can migrate a returning visitor's existing
// data ONCE from the old title-derived key — never read for anything else.
const storeKey = (guideSlug || "guide").replace(/\W+/g, "").toLowerCase();
const legacyStoreKey = (guide.title || "guide").replace(/\W+/g, "").toLowerCase();
const navLabel = (s: any, g: string) => s.title || s.name || g;
function collapseSubPrefixes(parts: string[]): string[] {
  if (parts.length < 2) return parts;
  const sep = / — | – /;
  const splits = parts.map(p => p.split(sep, 2));
  if (!splits.every(s => s.length === 2)) return parts;
  const prefix = splits[0][0];
  if (!splits.every(s => s[0] === prefix)) return parts;
  return [prefix + " — " + splits.map(s => s[1]).join(", ")];
}
const localCur = currencyFor(guide.country);

// Destination IANA time zone (e.g. "Asia/Seoul"). A guide-level `tz` (resolved from the
// destination's actual verified coordinates via scripts/lookup-tz.mjs) wins when present;
// the country table is a fallback default only, and is wrong whenever a destination's
// local time differs from its country's typical zone (Hawaii, Arizona — see content.config.ts).
// The client uses Intl with this, so the local-time pill + jet-lag calc are DST-correct.
const destTzIana = guide.tz || tzFor(guide.country);

// Base path for the deploy (e.g. "/Trip-Guides" on GitHub Pages). Astro does not
// auto-prepend the base to string/template hrefs, so home links build it explicitly.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// OG/Twitter image lives at {base}/og/{slug}.png (generated by pages/og/[slug].png.ts).
// Build it from the base + the last path segment so it works under the subpath —
// the old code stripped "^/guides/" which never matched "/Trip-Guides/guides/...",
// producing a double-slash, wrong-path URL.
const ogSlug  = guideSlug;
const ogImage = `${Astro.url.origin}${base}/og/${ogSlug}.png`;

// Compute at-a-glance stats for the masthead stat bar
function flatSections(secs: any[]): any[] {
  return secs.flatMap((s: any) => s.sections ? flatSections(s.sections) : [s]);
}
const _flat = flatSections(guide.sections || []);

// Masthead hero image = the guide's own COVER art when set, else its first sights photo
// (docs/MOTION.md). This is the SAME image the hub card shows — the shared element
// that morphs between them. Present → full-bleed photo hero; absent (scaffolds) → the
// Painted Atlas (R4), living from birth. Same Commons Special:FilePath thumbnailing as SightsBlock.
const heroSight = _flat
  .filter((s: any) => s.type === "sights")
  .flatMap((s: any) => s.items || [])
  .find((it: any) => it?.img?.file || it?.img?.src);
const cover = (guide as any).cover;
// R4: a still cover may now be a direct royalty-free CDN URL (`cover.src`, credit+license
// zod-required) as well as a Commons `file`. `src` wins when set (the schema rejects both
// together); a cover with only `video` still takes the first sight photo as its poster base.
// The sight-photo fallback carries whichever source THAT photo uses — a guide whose sights
// are all direct-CDN would otherwise fall through to the Painted Atlas despite having art.
const coverStill = (cover?.src || cover?.file)
  ? { file: cover.file ?? null, src: cover.src ?? null, credit: cover.credit, creditUrl: cover.creditUrl }
  : { file: heroSight?.img?.file ?? null, src: heroSight?.img?.src ?? null, credit: heroSight?.img?.credit, creditUrl: heroSight?.img?.creditUrl };
const coverDirect = (coverStill.src as string | undefined) ?? null;
const coverFile  = (coverStill.file as string | undefined) ?? null;
const coverAlt   = cover?.alt   ?? heroSight?.img?.alt  ?? heroSight?.name ?? "";
const coverFocal = cover?.focal ?? null;
const mastCommonsSrc = (w: number) =>
  coverFile ? `https://commons.wikimedia.org/wiki/Special:FilePath/${encodeURIComponent(coverFile)}?width=${w}` : null;
// One width-parameterized source fn for both paths: Commons thumbnails via Special:FilePath,
// direct CDNs via their own `{w}` token (absent token → the URL is single-size, srcset off).
const mastSrcAt = (w: number) =>
  coverDirect ? coverDirect.replace("{w}", String(w)) : mastCommonsSrc(w);
const heroSrc = mastSrcAt(1600);
// M2: a 375px phone was downloading the full 1600px masthead hero — same responsive
// treatment SightsBlock already gives every sight photo.
const heroSrcset = (coverFile || coverDirect?.includes("{w}"))
  ? `${mastSrcAt(480)} 480w, ${mastSrcAt(800)} 800w, ${mastSrcAt(1200)} 1200w, ${mastSrcAt(1600)} 1600w`
  : null;
// Credit chip: Commons files link their File page (Commons IS the credit); direct-URL
// covers carry their own zod-required credit, linking creditUrl when given. The living
// video swaps this chip to the footage credit while it plays (living-cover.js).
const heroCredit = coverFile
  ? { href: `https://commons.wikimedia.org/wiki/File:${encodeURIComponent(coverFile)}`, label: "Photo: Wikimedia Commons" }
  : coverDirect && coverStill.credit
  ? { href: (coverStill.creditUrl as string | undefined) ?? null, label: `Photo: ${coverStill.credit}` }
  : null;
// R4 living cover — the footage upgrade (schema-gated: credit+license required).
const coverVideo = cover?.video ?? null;

// For weather widget — pull lat/lng from first map section
const mapSec    = _flat.find((s: any) => s.type === "map" && s.center?.lat);
const mapCenter = mapSec ? { lat: mapSec.center.lat as number, lng: mapSec.center.lng as number } : null;
// Plate-line coordinate readout (design-handoff README.md §4) — Reading-scale notation,
// not a data lookup: reuses the same mapCenter the weather widget sources from, so a
// guide with no map section gets no coordinate line rather than a guessed one.
const platelineCoord = mapCenter
  ? `${Math.abs(mapCenter.lat).toFixed(4)}° ${mapCenter.lat >= 0 ? "N" : "S"}, ${Math.abs(mapCenter.lng).toFixed(4)}° ${mapCenter.lng >= 0 ? "E" : "W"}`
  : null;
// Per-guide masthead chips (emergency, currency) — both already computed elsewhere on
// this page (tgConfig, the budget/split tools); reused here rather than re-derived.
const platelineEmergency = emergencyFor(guide.country);

// Plate number (D6/D13): "PLATE NN — <CC>", NN from the ONE chronological-by-trip-start
// derivation (src/lib/sheet-order.ts) shared with the future hub index/table/ping sheet,
// CC from the guide's own `country` via the same COUNTRY_CODES map the holiday lookup
// uses. Every guide's start date is needed to rank this one, so this reads the whole
// collection — cheap at guide-count scale, and it's what keeps every guide's plate number
// agreeing with every other's without a hand-filled ordinal anywhere. Day-date extraction
// comes from the atlas silo's own helpers (one copy, not a third re-implementation), and
// `kicker` rides along so sheet-order can PIN each trip's year (its doc explains why —
// without it, ordinals silently renumber on any build >180 days after a trip ends).
const _allGuides = await getCollection("guides");
const _sheetInputs = _allGuides.map((g) => ({
  slug: g.id,
  firstDayDate: firstDayDateOf(g.data.sections as any[]),
  lastDayDate: lastDayDateOf(g.data.sections as any[]),
  kicker: (g.data as any).kicker ?? null,
}));
const sheetOrdinal = ordinalFor(sheetOrder(_sheetInputs, new Date()), guideSlug);
const guideCC = COUNTRY_CODES[guide.country] ?? null;
const platelineNumber = sheetOrdinal != null && guideCC
  ? `PLATE ${String(sheetOrdinal).padStart(2, "0")} — ${guideCC}`
  : null;

// When a guide has its own `weather` section, that section provides the #wxWrap
// mount in-flow, so the masthead strip is suppressed (no double render). The flag
// is also passed to the client so the service can log a breadcrumb if a weather
// section exists but there's no map section to source coordinates from.
const hasWeatherSection = _flat.some((s: any) => s.type === "weather");

// Map-section pins (build-time; first map gets all sights). Consumed only by
// the opt-in Google renderer (gmaps-render.js) when a key is set; the default
// OSM iframe ignores them.
const pinMap = derivePins(guide.sections);

// For trip countdown — pull first date string from first days section (e.g. "Wed Jul 8")
const daysSec      = _flat.find((s: any) => s.type === "days" && s.items?.length);
const firstDayDate = (daysSec?.items?.[0]?.date as string) ?? null;
const lastDayDate  = (daysSec?.items?.[daysSec.items.length - 1]?.date as string) ?? firstDayDate;

// What's-Next banner: compact per-day slice for the client to match against
// today's device-local date. No coordinates/time-of-day in the schema — day
// granularity only, same as the trip-countdown pill's own date parsing.
const daysForBanner = (daysSec?.items ?? []).map((d: any) => ({
  date: d.date as string, title: d.title as string, fit: (d.fit as string) ?? null,
  env: (d.env as string) ?? null, // outdoor|indoor|mixed — powers the weather day-swap advisory
}));

// Story-mode deck data — one tight card per day (date · title · tl;dr · pace · stops),
// consumed by the full-screen swipeable day viewer (features/itinerary/ui/story-mode.js).
// Structured JSON, not scraped DOM: the viewer composes a clean one-per-view panel.
const storyDays = (daysSec?.items ?? []).map((d: any) => ({
  date: d.date as string,
  title: (d.title as string) ?? "",
  tldr: (d.tldr as string) ?? "",
  pace: (d.pace as string) ?? "",
  stops: (d.waypoints ?? []).map((w: any) => ({
    name: w.name as string, note: (w.note as string) ?? "", time: (w.time as string) ?? "",
  })),
}));

// `verified` is source metadata (freshness tracking for the maker/AI), not shown to
// travelers — EXCEPT genuine ⚠ warnings (e.g. an unconfirmed draft), which stay visible.
const verifiedWarning = guide.verified?.trimStart().startsWith("⚠") ? guide.verified : null;
// Freshness date for the masthead chip — the ISO date inside the verified
// stamp when present (surfaced, never invented; no date → no chip).
const verifiedDate = guide.verified?.match(/\d{4}-\d{2}-\d{2}/)?.[0] ?? null;

// M4 item 5 — the colophon's numbers, counted from THIS guide's own data by the same walker the
// hub's Overture uses (src/lib/guide-stats.ts: a "verified fact" is any node carrying a
// source_url; sources are distinct hostnames). Counted, never typed — a footer that claims
// "47 verified facts" has to mean exactly that on every rebuild. Zero counts render nothing:
// an unresearched scaffold gets an honest blank, not a row of zeroes.
const colophon = computeGuideStats([guide]);
// The guide-level `verified` field is free prose ("Checked 28 Jun 2026 for the 8–15 Jul
// trip; …"), so `verifiedDate` above is null on every real guide — the per-FACT provenance
// dates are the machine-readable ones. Their maximum is a true, checkable statement, and
// falls back to the guide-level ISO date if a guide ever carries one.
const colophonChecked = verifiedDate ?? latestVerifiedOn([guide]);

// P7/R14: earliest upcoming recheck date across all ⚠-flagged facts with an `expected` field.
const nextRecheck = (() => {
  const dates: string[] = [];
  const walk = (obj: any) => {
    if (!obj || typeof obj !== "object") return;
    if (obj.expected && typeof obj.expected === "string") dates.push(obj.expected);
    if (Array.isArray(obj)) obj.forEach(walk);
    else Object.values(obj).forEach(walk);
  };
  walk(guide.sections);
  return dates.sort()[0] ?? null;
})();

// Public holidays — if the guide has a `holidays` section, look up the build-time
// data for this country + trip year and slice it around the trip dates. All
// server-side; the block hides when there's no country mapping or no data file.
const holSec = _flat.find((s: any) => s.type === "holidays");
let holidayInfo = null;
if (holSec) {
  const cc = COUNTRY_CODES[guide.country] || null;
  const holYear = holSec.year || deriveTripYear(firstDayDate);
  const all = cc ? holidayData[`../data/holidays/${cc}-${holYear}.json`] : null;
  holidayInfo = buildHolidayInfo(all ?? null, firstDayDate, lastDayDate, holYear);
}

// Build-time export availability. A guide gets a .gpx only if it has at least one
// map/sights coordinate, and a .ics only if it has at least one parseable day card —
// the same filters the endpoints use. Each download link is shown only when its
// file exists, so a guide missing that data simply doesn't offer it (Principle 5).
const hasWaypoints = collectWaypoints(guide).length > 0;
const hasDayEvents = collectDayEvents(guide).length > 0;


// Plain-text trip digest for the "Share summary" button (theme + planned days +
// key spots). Embedded in a hidden element; the client reads its textContent and
// appends the page URL at share time.
const tripSummary = buildSummary(guide);
---
<!doctype html>
<html lang="en" style={accentStyle(tokens, { "--theme-primary": themePrimary, "--theme-secondary": themeSecondary, "--theme-accent": themeAccent })}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{guide.title} — Waypoint</title>
    <meta name="description" content={guide.dek || guide.title} />
    {/* Drafts stay fully viewable/linkable (the homepage's Guides-to-be tier links
        directly to them) — only search indexing is suppressed in production, since
        the content isn't verified yet. Never applied in dev, so drafts are
        inspectable exactly like any other guide while working on them. */}
    {guide.draft && import.meta.env.PROD && (
      <meta name="robots" content="noindex, nofollow" />
    )}
    <meta property="og:type"        content="article" />
    <meta property="og:title"       content={`${guide.title} — Waypoint`} />
    <meta property="og:description" content={guide.dek || guide.title} />
    <meta property="og:url"         content={Astro.url.href} />
    <meta property="og:image"       content={ogImage} />
    <meta name="twitter:card"       content="summary_large_image" />
    <meta name="twitter:title"      content={`${guide.title} — Waypoint`} />
    <meta name="twitter:description" content={guide.dek || guide.title} />
    <meta name="twitter:image"      content={ogImage} />
    <link rel="canonical"           href={Astro.url.href} />
    <PwaHead />
    <!--
      Inline dark-mode init: runs synchronously before first paint so there's
      no flash of the wrong theme. Reads localStorage then falls back to the
      OS prefers-color-scheme preference.
    -->
    <script is:inline>
      (function () {
        const s = localStorage.getItem("tg-theme");
        const preferDark = window.matchMedia && window.matchMedia("(prefers-color-scheme:dark)").matches;
        if (s === "dark" || (s === null && preferDark)) {
          document.documentElement.setAttribute("data-theme", "dark");
        } else if (s === "light") {
          document.documentElement.setAttribute("data-theme", "light");
        }
        // Tint the browser/PWA chrome in the SAME breath. theme.js re-syncs this from the
        // computed --bg later, but "later" is after first paint: installed to the home
        // screen on a dark phone, the status bar flashed the light default first.
        const tc = document.querySelector('meta[name="theme-color"]');
        if (tc) tc.setAttribute("content", document.documentElement.getAttribute("data-theme") === "dark" ? "#0f1317" : "#dfe3d9");
      })();
    </script>
  </head>

  <body data-storekey={storeKey} data-legacy-storekey={legacyStoreKey}>

    <!-- Skip link — first focusable element; jumps keyboard/AT users past the
         chrome straight to the content. -->
    <a class="skip-link" href="#content">Skip to content</a>

    <!-- Reading progress bar — fixed 3px line at top, fills as user scrolls -->
    <div id="readProg" class="read-prog" aria-hidden="true"></div>

    <!-- Transient toast — destination for flash() (save/copy confirmations).
         Was previously inline in the checklist progress bar; relocated here as a
         standalone toast so feedback survives that bar's removal. -->
    <div id="savedNote" class="toast" role="status" aria-live="polite"></div>

    <!-- Sticky chrome: topbar + guide tab bar stick together as a unit -->
    <div class="sticky-chrome">

    <!-- ═══════════════════════════════════════════════════════════════════════
         TOP NAVIGATION BAR
         ═══════════════════════════════════════════════════════════════════ -->
    <nav class="topbar" aria-label="Site navigation">
      <a href={`${base}/`} class="topbar-home" aria-label="Waypoint — all guides">
        <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
          <path d="M1 5h12M1 5l4-4M1 5l4 4" stroke="currentColor" stroke-width="1.6"
                stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="topbar-wordmark">Waypoint</span>
      </a>
      <div class="topbar-right">
        <!-- Search + SOS buttons are injected into this cluster by palette.js /
             sos.js so they share the chrome-button styling. -->
        <button id="btnShare" class="topbar-btn" aria-label="Share this guide" title="Share this guide"><svg class="tb-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"/></svg> <span class="tb-label">Share</span></button>
        <!--
          Dark-mode toggle — icon and aria-label are swapped by theme.js on load (moon =
          currently light, click for dark; sun = currently dark, click for light). The moon
          below is the SERVER-RENDERED first-paint state and must match theme.js's own MOON_SVG:
          it used to be a bare text glyph, which flashed for one frame before JS replaced it
          with the real icon (M4 item 1 — one icon language, no glyph fallbacks).
        -->
        <button id="btnDark" class="topbar-btn" aria-label="Switch to dark mode" title="Switch to dark mode"><Icon name="moon" class="tb-ico" /></button>
      </div>
    </nav>

    <!-- Guided "Request a change" wizard — hidden until the footer pill is clicked. Both it
         and the share modal are reparented to <body> on init (the .sticky-chrome
         backdrop-filter containing-block trap). -->
    <ChangeRequest repo={REPO} slug={ogSlug} />

    <!-- Share modal — hidden until btnShare is clicked; skipped by Web Share API on mobile -->
    <div class="share-backdrop" id="shareBackdrop" aria-hidden="true"></div>
    <div class="share-modal" id="shareModal" role="dialog" aria-modal="true" aria-label="Share this guide" hidden>
      <p class="share-head">
        Share this guide
        <button class="share-close" id="shareClose" type="button" aria-label="Close">✕</button>
      </p>
      <div class="share-qr-wrap"><div id="shareQr"></div></div>
      <div class="share-url-row">
        <span class="share-url-txt" id="shareUrlTxt" title="Guide URL"></span>
        <button class="share-copy-btn" id="shareCopyBtn" type="button">Copy link</button>
      </div>
      {(hasDayEvents || hasWaypoints) && (
        <button class="share-summary-btn" id="btnShareSummary" type="button">↗ Share trip summary</button>
      )}
      <!-- Plain-text trip digest; read by the Share-summary handler via textContent -->
      <div id="tripSummary" hidden>{tripSummary}</div>
      <div class="share-socials">
        <a class="share-soc" id="shareWA" href="#" target="_blank" rel="noopener noreferrer">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96s-.47-.15-.66.15-.76.96-.93 1.16-.34.22-.64.07a8.06 8.06 0 0 1-2.37-1.46 8.9 8.9 0 0 1-1.64-2.04c-.17-.3 0-.46.13-.6s.3-.35.44-.52a2 2 0 0 0 .3-.5.55.55 0 0 0-.03-.52c-.07-.15-.66-1.6-.91-2.19-.24-.57-.48-.49-.66-.5h-.57a1.1 1.1 0 0 0-.8.37 3.36 3.36 0 0 0-1.05 2.5 5.84 5.84 0 0 0 1.22 3.1c.15.2 2.1 3.2 5.08 4.49a17.1 17.1 0 0 0 1.7.63 4.1 4.1 0 0 0 1.87.12 3.08 3.08 0 0 0 2.02-1.43 2.5 2.5 0 0 0 .17-1.43c-.07-.13-.26-.2-.56-.35M12 2a10 10 0 0 0-8.67 14.97L2 22l5.18-1.36A10 10 0 1 0 12 2"/></svg>
          WhatsApp
        </a>
        <a class="share-soc" id="shareEmail" href="#">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          Email
        </a>
      </div>
      <p class="share-install"><Icon name="phone" size={15} /> <b>Save this guide to your phone:</b> open your browser menu and choose <i>Add to Home Screen</i> — it then works offline for the whole trip (maps and photos still need a connection).</p>
      {(hasWaypoints || hasDayEvents) && (
        <div class="share-downloads">
          <p class="share-dl-head">Take it with you</p>
          <div class="share-dl-row">
            {hasWaypoints && (
              <a class="share-dl" href={`${base}/guides/${ogSlug}.gpx`} download={`${ogSlug}.gpx`}>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                Map points <span class="share-dl-ext">.gpx</span>
              </a>
            )}
            {hasDayEvents && (
              <a class="share-dl" href={`${base}/guides/${ogSlug}.ics`} download={`${ogSlug}.ics`}>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                Trip calendar <span class="share-dl-ext">.ics</span>
              </a>
            )}
          </div>
        </div>
      )}
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════════
         GUIDE TAB BAR — one tab per section group + Budget Calculator + Vote tools
         ═══════════════════════════════════════════════════════════════════ -->
    <nav class="guide-tabs-nav" aria-label="Guide sections" data-hint-anchor>
    <div class="guide-tabs" id="guideTabs" role="tablist">
      {order.map((g, i) => (
        <button class="gtab" role="tab" type="button" id={`gtab-${i}`} data-tab={i} data-full={g}
                aria-controls={`grp-${i}`}
                aria-label={g} aria-selected={i === 0 ? "true" : "false"}>{shortLabel(g)}</button>
      ))}
      {/* M4 item 3 — the TOOL tabs are layout chrome by CLAUDE.md's own definition, not content
          groups, and Korea's 13 content tabs + these 5 made the strip scroll even on a 1400px
          desktop. They stay in the SAME tablist (one tab set, one arrow-key ring, aria-controls
          untouched — collapsing them into a popover would have broken the tablist's ARIA
          structure for a purely visual win). Instead `.gtab-tool` marks them: a separator rule
          sets them off as chrome, and on desktop their labels go visually-hidden (clipped, NOT
          display:none — clipped text stays in the accessibility tree) so the strip fits one row
          while every accessible name survives verbatim. Mobile keeps the labels: the strip
          scrolls there by design and the sheet below spells them out in full anyway. */}
      <button class="gtab gtab-tool gtab-split" role="tab" type="button" id="gtab-split" data-tab="split"
              aria-controls="tripSplit" aria-selected="false"
              aria-label="Budget calculator" title="Budget calculator"><Icon name="budget" class="gtab-ico" /><span class="gtab-txt">Budget</span></button>
      <button class="gtab gtab-tool gtab-vote" role="tab" type="button" id="gtab-vote" data-tab="vote"
              aria-controls="tripVote" aria-selected="false"
              aria-label="Group vote" title="Group vote"><Icon name="vote" class="gtab-ico" /><span class="gtab-txt">Vote</span></button>
      <button class="gtab gtab-tool gtab-remind" role="tab" type="button" id="gtab-remind" data-tab="remind"
              aria-controls="tripRemind" aria-selected="false"
              aria-label="Reminders" title="Reminders"><Icon name="remind" class="gtab-ico" /><span class="gtab-txt">Reminders</span></button>
      <button class="gtab gtab-tool gtab-learn" role="tab" type="button" id="gtab-learn" data-tab="learn"
              aria-controls="tripLearn" aria-selected="false" hidden
              aria-label="Trip learnings" title="Trip learnings"><Icon name="learn" class="gtab-ico" /><span class="gtab-txt">Learnings</span></button>
      <button class="gtab gtab-tool gtab-kit" role="tab" type="button" id="gtab-kit" data-tab="kit"
              aria-controls="tripKit" aria-selected="false"
              aria-label="Trip kit" title="Trip kit"><Icon name="kit" class="gtab-ico" /><span class="gtab-txt">Trip kit</span></button>
    </div>
    </nav>

    </div>{/* end .sticky-chrome */}

    <!-- Cold-visitor framing — shown once per browser to shared-link recipients
         (cold-open.js reveals it; dismiss persists). -->
    <div class="cold-open" id="coldOpen" role="region" aria-label="About this guide" hidden>
      <span class="cold-open-txt"><b>Waypoint</b> — personal, fact-checked travel guides. This one was researched and verified for a specific trip.</span>
      <button class="cold-open-x" type="button" aria-label="Dismiss">✕</button>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════════
         MASTHEAD
         ═══════════════════════════════════════════════════════════════════ -->
    <header class={`masthead mast-hero ${heroSrc ? "mast-photo" : "mast-painted"}`} id="top" data-hero>
      <div class="mast-plate-row">
        <div class="mast-frame">
          {/* D13 (Stage A.5): the 16px inner mat — a bordered bed the photo/painted scene sits
              inside, inset from the frame's own edge, per the design-handoff prototype's exact
              markup (docs/design-handoff/prototype: inset:16px, 1px var(--rule2) border,
              overflow:hidden). The corner ticks (masthead.css's .mast-frame::after) are inset
              to match, so they mark the MAT's corners, not the frame's. hero-parallax.js and
              gsap-hero.js select `.mast-img`/`.mast-frame` by class, not by direct-child
              relationship, so this wrapper doesn't touch their wiring. */}
          <div class="mast-mat">
            {/* R4 — the Painted Atlas (src/components/PaintedAtlas.astro): rendered under EVERY
                hero. Coverless guides open on it (living from birth, replacing the old flat
                accent field); photo guides keep it hidden UNDERNEATH as the fallback that shows
                when the Commons photo fails to load (.mast-media-fail) — a painted scene instead
                of a dead grey field. CSS owns the switching (painted-atlas.css / masthead.css). */}
            <PaintedAtlas seed={guideSlug} tz={destTzIana} />
            {heroSrc && (
              <img class="mast-img" src={heroSrc} srcset={heroSrcset} sizes="(min-width:900px) 560px, 100vw" alt={coverAlt}
                   loading="eager" fetchpriority="high"
                   onerror="this.closest('.mast-frame').classList.add('mast-media-fail')"
                   style={`view-transition-name:cover-${ogSlug}${coverFocal ? `;object-position:${coverFocal}` : ""}`} />
            )}
            {/* R4 living cover — the footage upgrade over the still. Poster-first delivery:
                no `src` at all until living-cover.js decides the visitor gets motion (reduced-
                motion, Save-Data, and autoplay-refusal all leave the still standing, which is a
                complete cover, not a degraded one). DOM-after the img with the same z-index, so
                it paints above the photo only once it actually plays (.mast-video-live fades it
                in). muted+playsinline as attributes AND re-asserted in JS — the attribute alone
                is what mobile autoplay policies inspect. */}
            {coverVideo && (
              <video class="mast-video" muted playsinline loop preload="none"
                     data-src={coverVideo.src}
                     poster={coverVideo.poster ?? undefined}
                     aria-hidden="true" tabindex="-1"
                     style={coverFocal ? `object-position:${coverFocal}` : undefined}></video>
            )}
          </div>
          {heroCredit && (heroCredit.href ? (
            <a class="mast-credit" id="mastCredit" href={heroCredit.href} target="_blank" rel="noopener"
               aria-label={`${heroCredit.label} — view source`}
               data-video-credit={coverVideo ? `Video: ${coverVideo.credit}` : undefined}
               data-video-credit-url={coverVideo?.creditUrl ?? undefined}>{heroCredit.label} ↗</a>
          ) : (
            <span class="mast-credit" id="mastCredit"
                  data-video-credit={coverVideo ? `Video: ${coverVideo.credit}` : undefined}>{heroCredit.label}</span>
          ))}
          {/* Visible pause for the living cover (doctrine: obvious clickability; WCAG 2.2.2).
              NOT aria-hidden — it's a real control — but hidden until the video actually
              plays, so a visitor who never gets motion never sees a dead button. */}
          {coverVideo && (
            <button class="mast-pause" id="mastPause" type="button" hidden
                    aria-label="Pause background video" aria-pressed="false">
              <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
                <g class="mp-pause"><rect x="3.2" y="2.6" width="3.4" height="10.8" rx="1"/><rect x="9.4" y="2.6" width="3.4" height="10.8" rx="1"/></g>
                <path class="mp-play" d="M4.5 2.8v10.4c0 .8.9 1.3 1.6.9l8.2-5.2c.6-.4.6-1.4 0-1.8L6.1 1.9c-.7-.4-1.6.1-1.6.9z"/>
              </svg>
            </button>
          )}
        </div>
        <div class="mast-inner">
          {/* Dedup guard: never render the eyebrow if it would repeat the
              title verbatim (e.g. title "South Korea", country "South Korea").
              A kicker always wins; otherwise `region` (a state, for a US-scoped guide)
              shows in place of `country` when set — country stays the real nation for
              every functional lookup, region is what a reader actually sees here. */}
          {(guide.kicker || (guide.region || guide.country) !== guide.title) && (
            <p class="eyebrow mast-eyebrow">{guide.kicker || guide.region || guide.country}</p>
          )}
          <h1 class="mast-title">{guide.title}</h1>
          {guide.dek && <p class="dek mast-dek">{guide.dek}</p>}
          {/* Per-guide chips (design-handoff README.md §4): emergency numbers as tel: links,
              currency. "base" (home city/accommodation) has no schema field on any guide —
              omitted rather than invented, per the honesty doctrine. */}
          {(platelineEmergency || localCur) && (
            <div class="mast-chips">
              {platelineEmergency && platelineEmergency.lines.map((l: any) => (
                <a class="mast-chip mast-chip--sos" href={`tel:${l.num.replace(/[^0-9+]/g, "")}`}>{l.label}: {l.num}</a>
              ))}
              {localCur && <span class="mast-chip">{localCur.code} · {localCur.symbol}</span>}
            </div>
          )}
        </div>
      </div>

      {/* The plate line (DESIGN.md "The plate"): coordinates + the CHECKED stamp + this
          guide's own fact/source counts (colophon — same counts the page-footer colophon
          signs with, not re-derived) + a print control. Any row with nothing to show
          renders nothing — an unresearched guide's plate line can be shorter, never padded. */}
      {(platelineCoord || platelineNumber || colophonChecked || colophon.verifiedFactCount > 0 || colophon.sourceCount > 0) && (
        <div class="mast-plateline">
          {platelineCoord && <span class="mast-coord">{platelineCoord}</span>}
          {/* D6/D13: the sheet ordinal, chronological by trip start — the same number the
              future hub index/table/ping sheet will show for this guide. */}
          {platelineNumber && <span class="mast-platenum">{platelineNumber}</span>}
          {colophonChecked && <span class="mast-stamp">CHECKED {colophonChecked}</span>}
          {colophon.verifiedFactCount > 0 && (
            <span class="mast-plcount">{colophon.verifiedFactCount} verified facts</span>
          )}
          {colophon.sourceCount > 0 && (
            <span class="mast-plcount">{colophon.sourceCount} primary sources</span>
          )}
          <button class="mast-print" type="button" data-print-sheet>Print sheet</button>
        </div>
      )}

      {/* V5: shares a view-transition-name with the hub card's `.hubcard-bar` — the accent
          literally morphs from the card into this rule on arrival, rather than merely
          coincidentally matching (both sides compute the same accent independently via
          accentForGuide(), but only this shared name makes the transition itself carry it). */}
      <div class="masthead-rule" aria-hidden="true" style={`view-transition-name:accent-${ogSlug}`}></div>

      <!-- What's-Next banner — populated client-side against the device clock;
           FIRST in the masthead flow because it's the most actionable element
           during the trip ("what am I doing today"). Hidden outside the trip's
           own date range. -->
      <div class="whats-next" id="whatsNext" hidden>
        <span class="wn-label" id="wnLabel">Today</span>
        <span class="wn-text" id="wnText"></span>
      </div>

      <!-- Weather strip — populated by JS via Open-Meteo if guide has a map section.
           Suppressed when the guide has its own `weather` section (which mounts
           #wxWrap in-flow instead), so weather never renders twice. -->
      {!hasWeatherSection && (
        <div id="wxWrap" class="wx-wrap" hidden><div id="wxMount"></div></div>
      )}

      <!-- Stats bar — always rendered so JS can inject dynamic pills -->
      {/* M2: nowrap+overflow-x (CLS fix, see overview.css) makes this a scrollable region —
          tabindex so keyboard users can actually scroll it (axe scrollable-region-focusable).
          No aria-label: a plain div's implicit role is "generic", which ARIA prohibits naming
          (axe's aria-prohibited-attr correctly caught this on the first attempt). */}
      {/* LIVE FACTS ONLY (2026-07-30). A JSX comment, not an HTML one — Astro ships
          `<!-- -->` to every guide page, and this note is for readers of the source.

          The row used to carry six pills and scrolled sideways on a phone, so half of it
          was information the reader never saw. Three were cut for saying nothing this
          guide doesn't already say better:
            · "{n} days"       — the eyebrow above reads "Jul 8–15, 2026" and the dek
                                 opens "Eight days based in Seoul". A third telling.
            · "{n} sights"     — an inventory count; nothing a traveller can act on.
            · "Works offline"  — identical on every guide and a promise about the site,
                                 not a fact about this page. Its honest per-page form
                                 ("Saved on this device") now sits in the colophon,
                                 beside the instruction that earns it.
          What's left all changes on its own and differs per guide: the countdown (daily),
          the exchange rate (live), and the destination clock (per minute). Both remaining
          pills are injected by guide-ui.js. */}
      <div class="guide-stats" id="guideStats" tabindex="0">
        {verifiedWarning && <span class="gstat gstat-warning">{verifiedWarning}</span>}
        <!-- Live currency rate injected by JS when fetch succeeds -->
        <span class="gstat gstat-rate" id="liveRatePill" hidden></span>
      </div>

      {guide.draft && (
        <>
          <!-- research-pass.yml auto-graduates a guide the moment its OWN verify PASS lands
               (scripts/graduate-guide.mjs --slug) — so a guide still showing draft:true here is
               either mid-pipeline right now, or a run that couldn't reach PASS and is sitting in
               a draft PR for a human to fix. Either way, the live tracker is the honest first
               stop — it shows which of those two is actually true. -->
          <p class="draft-graduate">
            <a class="draft-graduate-link" href={`${base}/progress/?slug=${encodeURIComponent(ogSlug)}`}>
              <Icon name="clock" size={14} /> Track live progress
            </a>
          </p>
          <!-- Anyone can nominate; nothing here actually publishes anything — the linked issue
               only auto-applies "graduate-request". Only the owner applying "graduate-approved"
               (requires write access) flips draft:false, via .github/workflows/graduate-guide.yml.
               This is the MANUAL OVERRIDE path now (see that workflow's own header comment) — a
               routine research pass never needs it, since it graduates itself on PASS. It's still
               here for a draft finished/fixed by hand outside the pipeline. -->
          <p class="draft-graduate">
            <a
              class="draft-graduate-link"
              href={`https://github.com/${REPO}/issues/new?template=graduate-guide.yml&labels=graduate-request&slug=${encodeURIComponent(ogSlug)}&title=${encodeURIComponent(`Graduate: ${ogSlug}`)}`}
              target="_blank" rel="noopener"
            >✓ Think this is ready? Nominate it for graduation</a>
          </p>
        </>
      )}

      <!-- U11: "Request a change" moved to the page footer — it was a bare underlined text
           link mid-masthead (banned bare-text tap target; maker plumbing shown to every
           traveler in the guide's most prominent spot). See <footer> below for the pill. -->

      <!--
        JET-LAG CALCULATOR
        Collapsible — shown only when the guide's country has a known UTC offset.
        User picks their origin timezone; output shows the time gap, recovery
        estimate, and direction-specific tips.
      -->
      {destTzIana !== null && (
        <div class="jl-wrap" data-jl-group={jlGroupIdx}>
          <button class="jl-toggle" id="jlToggle" type="button"
                  aria-expanded="false" aria-controls="jlPanel">
            <Icon name="plane" size={15} class="jl-icon" />
            <span>Jet-lag calculator</span>
            <Icon name="chevron" size={13} class="jl-chev" />
          </button>
          <div id="jlPanel" hidden data-dest-tz={destTzIana}>
            <div class="jl-inner">
              <div class="jl-row">
                <label class="jl-label" for="jlOrigin">Flying&nbsp;from</label>
                <select class="jl-select" id="jlOrigin">
                  <option value="">— pick your departure city —</option>
                  <optgroup label="United States">
                    <option value="-7">Los Angeles / Pacific (PDT, UTC−7)</option>
                    <option value="-6">Denver / Mountain (MDT, UTC−6)</option>
                    <option value="-5">Chicago / Central (CDT, UTC−5)</option>
                    <option value="-4">New York / Eastern (EDT, UTC−4)</option>
                  </optgroup>
                  <optgroup label="Other cities">
                    <option value="0">London (BST, UTC+0)</option>
                    <option value="1">Lisbon (WEST, UTC+1)</option>
                    <option value="2">Paris / Berlin / Madrid (CEST, UTC+2)</option>
                    <option value="3">Helsinki / Athens / Nairobi (UTC+3)</option>
                    <option value="4">Dubai (UTC+4)</option>
                    <option value="5.5">Mumbai / Delhi (IST, UTC+5:30)</option>
                    <option value="7">Bangkok (ICT, UTC+7)</option>
                    <option value="8">Singapore / Hong Kong / Beijing (UTC+8)</option>
                    <option value="9">Tokyo / Seoul (JST/KST, UTC+9)</option>
                    <option value="10">Sydney (AEST, UTC+10)</option>
                    <option value="12">Auckland (NZST, UTC+12)</option>
                  </optgroup>
                </select>
              </div>
              <!-- Output injected by JS -->
              <div class="jl-output" id="jlOutput" hidden></div>
            </div>
          </div>
        </div>
      )}
    </header>

    <!-- ═══════════════════════════════════════════════════════════════════════
         MAIN LAYOUT — tab-switched content panels (nav is the sticky tab bar above)
         ═══════════════════════════════════════════════════════════════════ -->
    <div class="shell">
      <main class="content" id="content">
        <noscript>
          <p class="note" style="padding:1.5rem 0">This guide reads fine without JavaScript; enabling it adds section tabs, saved checklists, and the jet-lag calculator.</p>
        </noscript>
        {order.map((g, ci) => {
          const solo = byG[g].length === 1;
          // R5: a creator-signed descriptor wins the line under the title (rare,
          // informational-only — voice standard rev. 2026-07-28); without one, the
          // chapter-opener falls back to the derived contents line — what's inside,
          // from the section titles already in the data (no invented copy).
          const descriptor = (guide as any).descriptors?.[g] ?? null;
          const subParts = solo || descriptor ? [] : byG[g].map((o) => navLabel(o.s, g)).filter((t: string) => t && t !== g);
          const sub = collapseSubPrefixes(subParts.slice(0, 4)).join(" · ") + (subParts.length > 4 ? ` · +${subParts.length - 4} more` : "");
          const isPanelGroup = ((guide as any).panelGroups ?? []).includes(g);
          return (
            <div class="catblock" id={`grp-${ci}`} data-ci={ci} role="tabpanel" aria-labelledby={`gtab-${ci}`} hidden={ci > 0}>
              <header class="cat-opener">
                <span class="cat-num" aria-hidden="true">{String(ci + 1).padStart(2, "0")}</span>
                {groupImgs[g] && (
                  <span class="cat-fan" aria-hidden="true">
                    {groupImgs[g].map((im, fi) => (
                      <img class={`cat-fan-img cat-fan-${fi}`} src={thumbSrc(im)} alt="" loading="lazy" decoding="async" />
                    ))}
                  </span>
                )}
                <h2 class="cat-title">{g}</h2>
                {descriptor && <p class="cat-desc">{descriptor}</p>}
                {sub && <p class="cat-sub">{sub}</p>}
                {/* README:281 — "Each section group also gets a COLLAPSE ALL / EXPAND ALL
                    control in its header." Only meaningful where this group IS Panels (the
                    non-Panel path has nothing to collapse); no-JS-safe the same way the Panel
                    toggle itself is — hidden until src/features/panel/ui/collapse.js confirms
                    the grid exists and unhides + labels it. */}
                {isPanelGroup && (
                  <button class="cat-collapse-all" type="button" data-panel-collapse-all hidden>Collapse all</button>
                )}
              </header>
              {isPanelGroup ? (
                <>
                  {/* Atlas Phase 2: this group's sections are Panels on the grid —
                      collapse + reorder, persisted per reader under this scope. The
                      scope key is per GROUP, not per guide, so a later-phase grid in
                      another tab never interleaves its order with this one. */}
                  <div class="pnl-grid" data-panel-grid data-panel-scope={`${storeKey}:${g}`}>
                    {byG[g].map((o) => (
                      <Block sec={o.s} sid={`sec-${o.i}`} ci={ci} solo={solo} holidays={holidayInfo} learnings={guide.learnings ?? null} mapPins={o.s.type === "map" ? (pinMap.get(o.s) ?? null) : null} country={guide.country} panelHost={true} />
                    ))}
                  </div>
                  {/* The guide surface's own reset control (the Panel deliberately
                      carries none). Doubly gated: CSS hides it until the reorder
                      wiring exists; reorder.js unhides it only while a custom order
                      is actually saved. */}
                  <p class="pnl-reset-row">
                    <button class="pnl-reset" type="button" data-panel-order-reset hidden>Reset panel order</button>
                  </p>
                </>
              ) : (
                byG[g].map((o) => (
                  <Block sec={o.s} sid={`sec-${o.i}`} ci={ci} solo={solo} holidays={holidayInfo} learnings={guide.learnings ?? null} mapPins={o.s.type === "map" ? (pinMap.get(o.s) ?? null) : null} country={guide.country} />
                ))
              )}
              {byG[g].some((o: any) => o.s.type === "days") && (
                <div class="lnw-cta">
                  <button class="lnw-open" type="button" data-lnw-open hidden>
                    <Icon name="edit" size={14} class="lnw-open-ico" />Trip Feedback
                  </button>
                  <span class="lnw-cta-note">Traveled this? Log what worked and what you’d change.</span>
                </div>
              )}
              {ci < order.length - 1 && (
                <button class="next-cta" type="button" data-next-tab={ci + 1}>
                  <span class="next-cta-label">Next section</span>
                  <span class="next-cta-title">{order[ci + 1]}</span>
                  <span class="next-cta-arrow" aria-hidden="true">→</span>
                </button>
              )}
            </div>
          );
        })}
        <TripSplit storeKey={storeKey} />
        <Voting storeKey={storeKey} />
        <Learnings storeKey={storeKey} learnings={guide.learnings ?? null} slug={guideSlug} title={guide.title} />
        <Reminders storeKey={storeKey} />
        <TripKit storeKey={storeKey} country={guide.country} days={daysSec?.items ?? []} sections={_flat} phrases={guide.phrases ?? null} entry={guide.entry ?? null} />
      </main>
    </div>

    <!-- M4 item 5 — COLOPHON. This was the weakest surface on an otherwise composed page:
         `{guide.footer}` plus three <br>-separated muted spans. It is also the natural home for
         the product's one real differentiator — that every perishable fact here was checked
         against a primary source on a date — so it now signs the page instead of trailing off.
         Every number is counted from this guide's own data at build time (see `colophon` above);
         a stat with nothing to report renders nothing at all, per the honest-blank rule. -->
    <footer class="colophon">
      <div class="colo-sig">
        <span class="colo-mark" aria-hidden="true"><Icon name="shield" size={18} /></span>
        <div class="colo-sig-txt">
          <p class="colo-claim">Every perishable fact on this page was checked against a primary source.</p>
          {guide.footer && <p class="colo-footer-note">{guide.footer}</p>}
        </div>
      </div>

      {(colophonChecked || colophon.verifiedFactCount > 0 || colophon.sourceCount > 0) && (
        <dl class="colo-stats">
          {colophonChecked && (
            <div class="colo-stat"><dt>Last checked</dt><dd>{colophonChecked}</dd></div>
          )}
          {colophon.verifiedFactCount > 0 && (
            <div class="colo-stat"><dt>Verified facts</dt><dd>{colophon.verifiedFactCount}</dd></div>
          )}
          {colophon.sourceCount > 0 && (
            <div class="colo-stat"><dt>Primary sources</dt><dd>{colophon.sourceCount}</dd></div>
          )}
          {nextRecheck && (
            <div class="colo-stat"><dt>Next self-check</dt><dd>{nextRecheck}</dd></div>
          )}
        </dl>
      )}

      <div class="colo-foot">
        <p class="colo-notes">
          {/* offline-pill.js writes the ✓ ONLY once this page is genuinely in the service
              worker's cache — a state, not a promise. No cache entry, no line. */}
          <span class="offline-saved" id="offlineSaved"></span>
          <span class="offline-note">Add this to your home screen and it works offline once opened — only the embedded maps need a connection.</span>
          {" "}
          <span class="foot-telemetry">This guide counts anonymous tab opens (no names, no personal data) to learn which sections travelers actually use.</span>
        </p>
        <!-- U11: renders on EVERY guide, draft or published — a wrong fact doesn't stop being
             wrong once a guide graduates. Filing this issue auto-applies "modify-request" and
             does nothing by itself; only the owner applying "modify-approved" (requires write
             access) runs the edit, via .github/workflows/modify-guide.yml. -->
        <!-- A REAL link, on purpose: with JS off (or before hydration) this still reaches the
             same prefilled issue. The change-request feature intercepts the click and offers
             the guided 3-step version instead — progressive enhancement, not a JS-only button. -->
        <a
          class="foot-modify-pill"
          id="btnChangeRequest"
          aria-expanded="false"
          href={buildModifyIssueUrl(REPO, { slug: ogSlug })}
          target="_blank" rel="noopener"
        ><Icon name="edit" size={14} /> Request a change</a>
      </div>
    </footer>

    <!-- ═══════════════════════════════════════════════════════════════════════
         MOBILE BOTTOM TAB BAR (hidden on desktop)
         [ group ] [ group ] [ ☰ Groups ] [ ◎ Today ] [ ⚲ Map ]
         Under 900px the top chip strip is hidden, so THIS is the guide's primary
         navigation — hence real content groups in the bar, not tools alone (the old
         Journey · Today · Map · Kit bar could never say where you were in the guide).
         · group slots — the current group plus the one this DEVICE opens most
           (src/features/mobile-nav — labels and data-tab are rewritten client-side;
           what's rendered here is the first-paint default, the guide's own order).
         · Groups      — opens the journey sheet: ALL groups + every tool, so the
           promoted pair is a shortcut and never a ceiling.
         · Today       — the journey jump; Map only when the guide has a map section.
         Trip Kit moved into the sheet's tool row (creator, 2026-07-30): a reference
         surface, not a wayfinding one. Home lives in the topbar; SOS keeps its post.
         ═══════════════════════════════════════════════════════════════════ -->
    <!-- A <nav>, not a <div>: these are the only controls on the page at phone widths, and as a
         plain div they sat OUTSIDE every landmark — so a screen-reader user navigating by
         landmark skipped the entire mobile navigation. Invisible to the a11y gate until it
         started auditing a narrow viewport, because .botbar is display:none on wide ones.
         Deliberately NOT role="tablist": it seats two of N groups, and a tablist claiming
         to be the tab set while showing a fifth of it misreports the guide to a screen
         reader. Plain buttons + aria-current say exactly what is true; the full tab
         semantics stay on the real strip, and the sheet is the complete list. -->
    <nav class="botbar" aria-label="Guide navigation">
      {/* The active-group underline. Positioned over the live slot by mobile-nav, and
          in Phase B it tracks a swiping finger — one element that moves, rather than a
          per-slot state that pops. */}
      <span class="botbar-ind" aria-hidden="true"></span>
      {/* Slot 1 — the current content group (mobile-nav rewrites the label). */}
      <button class="botslot" type="button" data-slot="0" data-tab="0" aria-label={order[0]}>
        <span class="bslot-mark" aria-hidden="true"></span>
        <span class="bslot-txt">{slotLabel(order[0])}</span>
      </button>
      {/* Slot 2 — the TOOLS slot (creator, 2026-07-30: "the tools should be their own tab
          ... the Trip Split calculator is by far the most useful to have handy"). It was a
          second content group, which the Groups sheet already reaches in one tap; a tool
          panel was three. It shows whichever tool THIS device opens most, defaulting to the
          budget split, and every icon ships so the swap is a class toggle, not a fetch. */}
      <button class="botslot botslot-tool" type="button" data-slot="tool" data-tab="split"
              aria-label="Budget calculator">
        <Icon name="budget" size={17} class="bslot-ico bsi-split" />
        <Icon name="vote"   size={17} class="bslot-ico bsi-vote" />
        <Icon name="remind" size={17} class="bslot-ico bsi-remind" />
        <Icon name="kit"    size={17} class="bslot-ico bsi-kit" />
        <Icon name="learn"  size={17} class="bslot-ico bsi-learn" />
        <span class="bslot-txt">Split</span>
      </button>
      <button class="botmini botmini-groups" id="sheetOpen" type="button"
              aria-haspopup="dialog" aria-expanded="false">
        <Icon name="groups" size={17} />
        <span>Groups</span>
        {/* The current group and its "3/13" position (field-tools.js appends .bs-pos
            after this) are now part of the button's ACCESSIBLE NAME rather than a
            visible label — the active group slot already says where you are visually,
            and five slots have no room to say it twice. The sheet head shows the
            position in full for everyone. */}
        <span class="bs-cur mn-sr" id="curCat"></span>
      </button>
      <button class="botmini" id="botToday" type="button" aria-label="Jump to today in the itinerary">
        <svg width="17" height="17" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="8" cy="8" r="3"/><path d="M8 1.2v2M8 12.8v2M1.2 8h2M12.8 8h2M3.3 3.3l1.4 1.4M11.3 11.3l1.4 1.4M12.7 3.3l-1.4 1.4M4.7 11.3l-1.4 1.4"/></svg>
        <span>Today</span>
      </button>
      {navMapSec !== null && (
        <a class="botmini" href={`#sec-${navMapSec}`} data-tab={navMapCat} id="botMap" aria-label="Open the map">
          <svg width="17" height="17" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M8 14s4.5-4.2 4.5-7.5a4.5 4.5 0 1 0-9 0C3.5 9.8 8 14 8 14Z"/><circle cx="8" cy="6.5" r="1.6"/></svg>
          <span>Map</span>
        </a>
      )}
    </nav>

    <!-- Slide-up section sheet (mobile) -->
    <div class="sheet-backdrop"></div>
    <div class="sheet" role="dialog" aria-label="Sections" aria-modal="true">
      <div class="sheet-grip" aria-hidden="true"></div>
      {/* The "3 of 13" position moved here from the bottom bar when that bar became a
          five-slot tab bar (no room for a second label). field-tools.js writes it. */}
      <div class="sheet-head">The journey <span class="sheet-pos" id="sheetPos"></span></div>
      <div class="sheet-list">
        {order.map((g, ci) => (
          <>
            <a class="sheet-cat" data-cat={ci} data-tab={ci} href={`#grp-${ci}`}>{g}</a>
            {byG[g].length > 1 && byG[g].map((o) => (
              <a class="sheet-link" data-tab={ci} href={`#sec-${o.i}`}>{navLabel(o.s, g)}</a>
            ))}
          </>
        ))}
        {/* U2: `sheet-tool` marks every tool link (layout chrome, not a content group) so
            mobile-nav.css can exclude ALL FIVE from the bearing-number counter in one rule.
            Previously only split/vote had their own :not() exclusions — Reminders/
            Learnings/Trip Kit kept incrementing the counter as if they were real content
            chapters, so the sheet's numbering lied about how many sections a guide has. */}
        <a class="sheet-cat sheet-tool sheet-split-link" data-tab="split" href="#"><Icon name="budget" class="sheet-ico" />Budget Calculator</a>
        <a class="sheet-cat sheet-tool sheet-vote-link" data-tab="vote" href="#"><Icon name="vote" class="sheet-ico" />Group Vote</a>
        <a class="sheet-cat sheet-tool sheet-remind-link" data-tab="remind" href="#"><Icon name="remind" class="sheet-ico" />Reminders</a>
        <a class="sheet-cat sheet-tool sheet-learn-link" data-tab="learn" href="#" hidden><Icon name="learn" class="sheet-ico" />Trip Learnings</a>
        <a class="sheet-cat sheet-tool sheet-kit-link" data-tab="kit" href="#"><Icon name="kit" class="sheet-ico" />Trip Kit</a>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════════
         CLIENT SCRIPT
         All interactive enhancements in one bundle:
           1. Dark-mode toggle
           2. Mobile sheet (open/close, Escape, focus-trap)
           3. Scroll-spy (highlights current section in nav)
           4. Checklists (save to localStorage, export/import/clear)
           5. Budget calculators (live total, persisted per-device)
           6. Jet-lag calculator
         ═══════════════════════════════════════════════════════════════════ -->
    <!-- Config for the extracted guide UI module (formerly Astro define:vars). -->
    <script type="application/json" is:inline id="tgConfig" set:html={jsonEmbed({ order, storeKey, legacyStoreKey, roomId: guide.roomId ?? null, mapCenter, firstDayDate, lastDayDate, hasWeatherSection, destTzIana, curCode: localCur?.code ?? null, curFallbackRate: localCur?.approxRate ?? null, curFallbackAsOf: FALLBACK_RATES_AS_OF, navSections: order.map((g: string) => ({ group: g, titles: (byG[g] || []).map((o: any) => navLabel(o.s, g)) })), daysForBanner, gmapsKey: import.meta.env.PUBLIC_GMAPS_KEY ?? null, gmapsMapId: import.meta.env.PUBLIC_GMAPS_MAP_ID ?? null, emergency: emergencyFor(guide.country), advisory: (guide as any).advisory ?? null, verifiedDate, budgetLock: (guide as any).budgetLock ?? false })}></script>
    <script type="application/json" is:inline id="storyDays" set:html={jsonEmbed(storyDays)}></script>
    <!-- Interactive UI — bundled + hashed by Astro into one module shared across guides. -->
    <script>
      import "../scripts/guide-ui.js";
      import "../features/maps/index.js";
      // itinerary silo (day-rail, now-line, spine, print-day, story-mode) —
      // imported at day-rail's original slot; its index preserves their exec
      // order. guide-ui above stays first (the one load-bearing invariant).
      import "../features/itinerary/index.js";
      // mobile-nav reads the tab strip's active state and drives the bottom bar; it must
      // load AFTER guide-ui (which sets the initial active tab) so its first render sees
      // the real starting group instead of counting the restore as a chosen open.
      import "../features/mobile-nav/index.js";
      import "../scripts/reveal.js";
      import "../scripts/section-flight.js";
      import "../scripts/micro.js";
      import "../scripts/provenance-dot.js";
      // M4 item 4 — ORDER IS LOAD-BEARING for the onboarding choreography. ES modules evaluate
      // in import order: cold-open claims the first eligible view; onboard's nav-hint defers
      // to it via window.__onboardShown. (The masthead's day-segmented title-card intro that
      // used to own visit 1 — story-open.js — was retired with the plate masthead rebuild:
      // its full-bleed treatment assumed title text sat absolutely over the photo, which the
      // plate layout no longer does. The Phase 3 hub→masthead FLIP transition in the redesign
      // spec supersedes it rather than needing a rebuild here.)
      import "../scripts/cold-open.js";
      import "../scripts/onboard.js";
      import "../scripts/scroll-memory.js";
      import "../scripts/offline-pill.js";
      import "../features/field-tools/index.js";
      import "../features/route-opt/index.js";
      import "../features/sos/index.js";
      import "../scripts/lightbox.js";
      import "../scripts/hero-parallax.js";
      import "../scripts/gsap-hero.js";
      import "../scripts/living-cover.js";
      import "../scripts/anchors.js";
      import "../features/palette/index.js";
      import "../features/trip-split/index.ts";
      import "../features/voting/index.js";
      import "../scripts/staleness-ui.js";
      import "../features/telemetry/index.js";
      // Atlas Phase 2 — boots any Panel grid a group declared (data-panel-scope).
      // After guide-ui so tabs exist; a guide with no panelGroups wires nothing.
      import { initDeclaredPanelGrids } from "../features/panel/index.js";
      initDeclaredPanelGrids();
    </script>

  </body>
</html>
