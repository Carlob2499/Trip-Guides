---
/* The Tools screen's page shell. Two routes render it — `/tools/` (the trip the hub is
   currently featuring) and `/tools/<slug>/` (a named trip) — so it lives here rather than
   being pasted into both: a divergence between them would be a screen that behaves
   differently depending on which door you came through, which is precisely the failure the
   README warns about for this feature. */
import PwaHead from "../components/PwaHead.astro";
import ToolsScreen from "../components/ToolsScreen.astro";
import type { TripTools } from "../lib/tools-data";
import "@fontsource-variable/literata/standard.css";
import "@fontsource-variable/literata/standard-italic.css";
import "@fontsource-variable/source-sans-3";
import "../styles/base.css";
import "../features/panel/styles.css";
import "../styles/trip-split.css";
import "../styles/jetlag.css";
import "../styles/tools.css";

interface Props { trips: TripTools[]; active: TripTools }
const { trips, active } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{active.record.title} — trip tools — Waypoint</title>
    <meta name="description" content={`Split costs, jet lag, closures, reminders and route order for the ${active.record.title} trip — each running on that guide's own verified record.`} />
    <PwaHead />
    <!-- Theme before paint, same as every other surface. -->
    <script is:inline>
      (function () {
        const s = localStorage.getItem("tg-theme");
        const preferDark = window.matchMedia && window.matchMedia("(prefers-color-scheme:dark)").matches;
        if (s === "dark" || (s === null && preferDark)) document.documentElement.setAttribute("data-theme", "dark");
        else if (s === "light") document.documentElement.setAttribute("data-theme", "light");
      })();
    </script>
  </head>
  <body data-base={base} data-storekey={active.record.storeKey}>
    <a class="skip-link" href="#toolsMain">Skip to the tools</a>
    <header class="tools-bar">
      <a class="tools-wordmark" href={`${base}/`}>← Waypoint</a>
    </header>
    <main id="toolsMain">
      <ToolsScreen trips={trips} active={active} base={base} />
    </main>
    <script>
      // The split calculator self-mounts on #tripSplit; the panel silo wires collapse and
      // reorder; jetlag-ui is the same module the guide pages use.
      import "../features/trip-split/index";
      import "../scripts/tools-reminders.js";
      import { initDeclaredPanelGrids } from "../features/panel/index.js";
      import { initJetLag } from "../scripts/jetlag-ui.js";
      initDeclaredPanelGrids();
      initJetLag();
    </script>
  </body>
</html>
