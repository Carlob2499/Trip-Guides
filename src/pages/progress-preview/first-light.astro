---
/* OPTION A — "First Light" · design study for /progress/ (PREVIEW ONLY).
   Nothing here is imported by src/pages/progress/index.astro; this route is additive
   and the whole study deletes with src/pages/progress-preview/ + src/styles/progress-preview/.

   The pitch in one line: a guide is born with a cover, so the wait already has a picture —
   the destination's own Painted Atlas, at the destination's own hour, with the six real
   pipeline stages riding a journey line across its horizon. */
import PwaHead from "../../components/PwaHead.astro";
import PreviewBar from "./_lib/PreviewBar.astro";
import "@fontsource-variable/literata/standard.css";
import "@fontsource-variable/literata/standard-italic.css";
import "@fontsource-variable/source-sans-3";
import "../../styles/base.css";
import "../../styles/painted-atlas.css";
import "../../styles/progress-preview/preview-chrome.css";
import "../../styles/progress-preview/first-light.css";
import PaintedAtlas from "../../components/PaintedAtlas.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>First Light — progress design study</title>
    <meta name="robots" content="noindex,nofollow" />
    <PwaHead />
  </head>
  <body>
    <PreviewBar option="First Light" pitch="The guide's living cover, before the guide exists." />

    <!-- The scene. PaintedAtlas is rendered verbatim from src/components/PaintedAtlas.astro;
         its terrain seed and sky are re-keyed client-side from the runtime slug/country,
         because on THIS page those two facts only exist in the query string. -->
    <div class="fl-scene" aria-hidden="true">
      <PaintedAtlas seed="waypoint" />
    </div>

    <div class="fl-page" id="flPage">
      <div class="fl-top">
        <a class="fl-mark" href={`${base}/`}>Waypoint</a>
        <p class="fl-elapsed"><b id="flElapsed">—</b><i>Elapsed</i></p>
      </div>

      <main class="fl-main">
        <div class="fl-stack">
          <p class="fl-eyebrow" id="flEyebrow"></p>
          <h1 class="fl-title" id="flTitle">Your guide</h1>
          <p class="fl-dek" id="flDek">
            Being researched and written right now. Nothing appears here until it has been
            checked against a primary source.
          </p>
        </div>

        {/* The rail spans the full page, not the text measure — it is the horizon. */}
        <section class="fl-rail" aria-label="Pipeline progress">
          <p class="fl-rail-head">
            <span>The pipeline</span>
            <span class="fl-count" id="flCount"></span>
          </p>
          <div class="fl-line" id="flLine">
            <span class="fl-track"></span>
            <span class="fl-fill" id="flFill"></span>
            <span class="fl-tip" id="flTip"></span>
          </div>
        </section>

        <div class="fl-below">
          <p class="fl-now" id="flNow"></p>
          <p class="fl-note" id="flAttempts" hidden></p>
          <p class="fl-note fl-note--warn" id="flStuck" hidden></p>

          <div class="fl-done" id="flDone" hidden>
            <a class="fl-cta" id="flCta" href="#">Open the guide <span class="fl-cta-arrow" aria-hidden="true">→</span></a>
          </div>

          <div class="fl-fix" id="flFix" hidden>
            <p>
              Not finding it — the web address depends on the destination name and this page's
              first guess may not match. Paste the slug from your issue's confirmation comment.
            </p>
            <form id="flFixForm">
              <label class="fl-fix-label" for="flFixInput" hidden>Guide slug</label>
              <input id="flFixInput" type="text" placeholder="e.g. south-korea" autocomplete="off" />
              <button type="submit">Track</button>
            </form>
          </div>

          <a class="fl-foot" href={`${base}/`}>← All guides</a>
        </div>
      </main>
    </div>

    <!-- Live-region mirror of the state, for screen readers. The visual rail is a graphic;
         this is the same fact in words, announced only when it actually changes. -->
    <p id="flLive" role="status" aria-live="polite" style="position:absolute;left:-9999px;top:0"></p>

    <script>
      import { initFirstLight } from "./_lib/first-light.js";
      initFirstLight();
    </script>
  </body>
</html>
