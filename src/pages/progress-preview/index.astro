---
/* Index for the /progress/ design study (PREVIEW ONLY).
   Four directions × eight real states, every one a shareable URL. Nothing here is
   imported by src/pages/progress/index.astro; delete src/pages/progress-preview/ and
   src/styles/progress-preview/ and the study is gone without a trace. */
import PwaHead from "../../components/PwaHead.astro";
import { FIXTURES } from "./_lib/fixtures";
import "@fontsource-variable/literata/standard.css";
import "@fontsource-variable/source-sans-3";
import "../../styles/base.css";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const IDENT = "country=South+Korea&slug=south-korea";

const OPTIONS = [
  {
    slug: "first-light",
    name: "First Light",
    pitch: "The guide's living cover, before the guide exists.",
    what: "Full-bleed Painted Atlas seeded from the real slug, under the destination's real sky right now, with the six stages riding a journey line across its horizon. When the guide lands, its masthead is the same painting.",
    uses: "PaintedAtlas.astro · terrain.ts (client-side re-seed) · anchors.css journey line · one overture + a live tip glow",
  },
  {
    slug: "departures",
    name: "Departures",
    pitch: "A schedule board: six ordered events, real times, forward-only flaps.",
    what: "The board's grammar — one line per stage, hard column discipline, status and time in fixed columns — with a split-flap rendering only the status word. A drum turns forward or not at all, so it cannot show a state it wasn't driven to.",
    uses: "CSS only, plus a small flap driver · inverted --ink board (the .botSections precedent) · --on-accent for the RUNNING fill",
  },
  {
    slug: "neatline",
    name: "Neatline",
    pitch: "The sheet before it is drawn — printed index, dotted leaders, near-still.",
    what: "A chart sheet built from two devices the site already ships: the neatline (guide.css's double rule) and the colophon stat pair. The stages are set as a printed index with dotted leaders. One entrance, one live mark, nothing else.",
    uses: "CSS only · guide.css neatline + colophon idioms · reduced-motion frame is near-identical by design",
  },
  {
    slug: "two-passes",
    name: "Two Passes",
    pitch: "The pipeline's real shape: a fork, two passes, a merge.",
    what: "The other three draw six stages in a row. The pipeline isn't a row — two independent research passes are run and then reconciled, on a research branch that lands on main. Drawn as the commit graph it literally is.",
    uses: "CSS-only commit graph (per-row gutter, no SVG sync) · trunk fill stops dead at the last cleared node",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Progress page — design study</title>
    <meta name="robots" content="noindex,nofollow" />
    <PwaHead />
  </head>
  <body>
    <div class="ix">
      <p class="ix-kicker">Design study</p>
      <h1 class="ix-h">The progress page, four ways</h1>
      <p class="ix-lede">
        Four directions for <code>/progress/</code>, each built as working code against the real
        <code>deriveProgress()</code> from <code>src/features/pipeline-progress/</code>. Every
        state below is a real <code>PipelineState</code> fixture, not a mock-up frame — the
        timers tick, the fills move, the stalled state genuinely stalls.
      </p>
      <p class="ix-lede ix-lede--note">
        Nothing here touches the live <code>/progress/</code> route. Add <code>?bare=1</code> to
        any link to drop the tool chrome, <code>?play=1</code> to watch a run step through
        itself, or <code>?sky=day|dusk|night|dawn</code> to see First Light's four painted moods.
      </p>

      {OPTIONS.map((o) => (
        <section class="ix-opt">
          <h2 class="ix-opt-h">
            <a href={`${base}/progress-preview/${o.slug}/?${IDENT}&state=mid`}>{o.name}</a>
          </h2>
          <p class="ix-pitch">{o.pitch}</p>
          <p class="ix-what">{o.what}</p>
          <p class="ix-uses">{o.uses}</p>
          <p class="ix-states">
            {FIXTURES.map((f) => (
              <a class="ix-chip" href={`${base}/progress-preview/${o.slug}/?${IDENT}&state=${f.key}`} title={f.note}>{f.label}</a>
            ))}
          </p>
        </section>
      ))}

      <section class="ix-opt">
        <h2 class="ix-opt-h">The states</h2>
        <dl class="ix-fx">
          {FIXTURES.map((f) => (
            <div class="ix-fx-row"><dt>{f.label}</dt><dd>{f.note}</dd></div>
          ))}
        </dl>
      </section>

      <p class="ix-back"><a href={`${base}/progress/`}>The live page, for comparison →</a></p>
    </div>

    <style>
      .ix{max-width:48rem;margin:0 auto;padding:2.4rem 1.2rem 5rem}
      .ix-kicker{font-family:var(--font-data);font-size:var(--text-micro);font-weight:700;
        letter-spacing:var(--tracking-micro);text-transform:uppercase;color:var(--muted);margin:0 0 .3rem}
      .ix-h{font-family:var(--font-display);font-weight:600;font-size:var(--text-h2);margin:0 0 .8rem;
        letter-spacing:-.018em}
      .ix-lede{color:var(--muted);font-size:var(--text-small);line-height:1.6;margin:0 0 .7rem;max-width:62ch}
      .ix-lede--note{padding-left:.9rem;border-left:1px solid var(--rule2)}
      .ix code{font-family:var(--font-data);font-size:.92em;background:var(--bg2);padding:.05em .3em;border-radius:3px}
      .ix-opt{margin-top:2.2rem;padding-top:1.4rem;border-top:2px solid var(--ink);
        box-shadow:0 6px 0 -4px color-mix(in srgb,var(--ink) 26%,transparent)}
      .ix-opt-h{font-family:var(--font-display);font-size:var(--text-h3);font-weight:600;margin:0 0 .35rem}
      .ix-opt-h a{color:var(--ink);text-decoration:none}
      .ix-opt-h a:hover{color:var(--accent-ink)}
      .ix-pitch{font-family:var(--font-body);font-size:var(--text-lead);color:var(--ink);margin:0 0 .5rem;
        line-height:1.4;text-wrap:pretty}
      .ix-what{color:var(--muted);font-size:var(--text-small);line-height:1.6;margin:0 0 .5rem;max-width:64ch}
      .ix-uses{font-family:var(--font-data);font-size:var(--text-control-sm);color:var(--muted);margin:0 0 .8rem}
      .ix-states{display:flex;flex-wrap:wrap;gap:.4rem;margin:0}
      .ix-chip{display:inline-block;padding:.28rem .7rem;border-radius:999px;border:1px solid var(--rule2);
        font-family:var(--font-data);font-size:var(--text-control-sm);color:var(--muted);text-decoration:none}
      .ix-chip:hover{border-color:var(--ink);color:var(--ink)}
      .ix-chip:focus-visible{outline:2px solid var(--accent-ink);outline-offset:2px}
      .ix-fx{margin:.6rem 0 0}
      .ix-fx-row{display:grid;grid-template-columns:9rem 1fr;gap:.6rem;padding:.45rem 0;
        border-bottom:1px solid color-mix(in srgb,var(--rule) 55%,transparent)}
      .ix-fx dt{font-family:var(--font-data);font-size:var(--text-control-sm);font-weight:700;color:var(--ink)}
      .ix-fx dd{margin:0;font-size:var(--text-control);color:var(--muted);line-height:1.5}
      .ix-back{margin-top:2.4rem}
      .ix-back a{font-family:var(--font-data);font-size:var(--text-control);color:var(--accent-ink);text-decoration:none}
      @media(max-width:520px){.ix-fx-row{grid-template-columns:1fr;gap:.15rem}}
    </style>
  </body>
</html>
