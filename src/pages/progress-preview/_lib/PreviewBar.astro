---
/* PREVIEW-ONLY chrome for the /progress/ design study. Deliberately looks like a tool, not
   like the design — it must never be mistaken for part of the option being reviewed, and
   `?bare=1` removes it entirely for clean screenshots.

   It also carries the build-time config embed (country identity table + base path) that
   _lib/harness.js reads, so every option page gets it from one place. */
import { jsonEmbed } from "../../../lib/json-embed";
import { countryTable, houseIdentity } from "./config";
import { FIXTURES } from "./fixtures";

interface Props {
  /** This option's short name, e.g. "First Light". */
  option: string;
  /** One-line pitch shown in the bar. */
  pitch: string;
}
const { option, pitch } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const OPTIONS = [
  { slug: "first-light", name: "First Light" },
  { slug: "departures", name: "Departures" },
  { slug: "neatline", name: "Neatline" },
  { slug: "two-passes", name: "Two Passes" },
];
---

<script type="application/json" is:inline id="pvConfig" set:html={jsonEmbed({ base, countries: countryTable(), house: houseIdentity() })}></script>

<div class="pv-bar" id="pvBar" data-pv-bar>
  <div class="pv-bar-row">
    <span class="pv-tag">Design study</span>
    <strong class="pv-opt">{option}</strong>
    <span class="pv-pitch">{pitch}</span>
    <span class="pv-warn">Fixture data — not a live run</span>
  </div>
  <div class="pv-bar-row pv-bar-row--links">
    <span class="pv-lbl">Option</span>
    {OPTIONS.map((o) => (
      <a class="pv-chip" class:list={["pv-chip", { "is-here": o.name === option }]} href={`${base}/progress-preview/${o.slug}/${Astro.url.search}`}>{o.name}</a>
    ))}
  </div>
  <div class="pv-bar-row pv-bar-row--links">
    <span class="pv-lbl">State</span>
    {FIXTURES.map((f) => (
      <button class="pv-chip" type="button" data-pv-state={f.key} title={f.note}>{f.label}</button>
    ))}
  </div>
  <p class="pv-note" id="pvNote"></p>
</div>

<script is:inline>
  /* ?bare=1 strips the tool chrome for screenshots. Inline + immediate so it never flashes. */
  (function () {
    if (new URLSearchParams(location.search).get("bare") === "1") {
      document.documentElement.setAttribute("data-pv-bare", "1");
    }
  })();
</script>
