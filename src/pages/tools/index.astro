---
/* `/tools/` — the Tools screen with no trip named. It opens on the trip the hub is
   currently featuring (loadTripTools returns the hub's own relevance order: ongoing first,
   then soonest upcoming), which is the same trip the header's TOOLS button is about. The
   picker is right there for the other three, and every panel is already loaded for the one
   you land on. */
import ToolsLayout from "../../layouts/ToolsLayout.astro";
import { loadTripTools } from "./_data";

const trips = await loadTripTools();
const active = trips[0];
---
{active && <ToolsLayout trips={trips} active={active} />}
