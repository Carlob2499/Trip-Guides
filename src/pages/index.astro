---
// Atlas hub — THE site's home page (docs/archive/PLAN_ATLAS_MIGRATION.md Stage C item 10, the flip:
// built aside at /atlas/ through Stage C per D1, then moved here in one commit on the
// creator's GO). Two doors (D4): the table view is server-rendered so the page works with
// zero JS and stays indexable; the globe (world view) and the cover are progressive
// enhancement that mount on top once their modules load.
import { getCollection } from "astro:content";
import PwaHead from "../components/PwaHead.astro";
import Icon from "../components/Icon.astro";
import { generateContourLayer } from "../lib/contours";
import {
  deriveGuideRecord, relevanceOrder, quickCardKicker, firstDayDateOf, lastDayDateOf,
} from "../features/atlas/index";
import { sheetOrder, ordinalFor } from "../lib/sheet-order";
import { tripRangeLabel } from "../lib/trip-dates";
// A 56px plate does not need a 258 KB original — Commons serves a 14.5 KB thumbnail for
// the same picture if you ask it for a width (verified against the live endpoint).
import { atWidth, srcsetFor, srcsetWidths } from "../lib/img-width";
import { countryData, emergencyFor, COUNTRY_CODES } from "../data/countries.mjs";
import { flattenSections } from "../features/exports/index";
import "@fontsource-variable/literata/standard.css";
import "@fontsource-variable/literata/standard-italic.css";
import "@fontsource-variable/source-sans-3";
import "../styles/base.css";
import "../styles/atlas.css";
import "../styles/atlas-world.css";
import "../styles/atlas-cover.css";
import "../styles/atlas-mobile.css";
import "../styles/transitions.css";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const now = new Date();
const DESCRIPTION = "Verified, personalized travel guides — every price, hour, and door checked against a primary source, never autogenerated.";

// A page-level survey ground (README/design-handoff screenshots — the hub's own visual
// identity, ported from index.astro's R3b "page-contours" pattern: position:fixed, so the
// terrain holds still while table/world content scrolls or toggles over it). Fixed seeds ⇒
// identical rings every build. Own seeds, distinct from the old hub's — this is atlas's own
// ground, not a copy. hub-motion.css (the old hub's copy of this) is deleted at the flip
// (item 10); this page owns its copy independently rather than importing a file due for removal.
const contourLayers = [
  generateContourLayer({ seed: 211, rings: 11, cx: 180, cy: 760 }),
  generateContourLayer({ seed: 307, rings: 8, cx: 860, cy: 200 }),
];

const allGuides = await getCollection("guides");
const curated = allGuides.filter((g) => !g.data.draft);

const sheetInputs = curated.map((g) => ({
  slug: g.id,
  firstDayDate: firstDayDateOf(g.data.sections),
  lastDayDate: lastDayDateOf(g.data.sections),
  kicker: g.data.kicker ?? null,
}));
const order = sheetOrder(sheetInputs, now);

const rows = curated.map((g) => {
  const flat = flattenSections(g.data.sections || []);
  // coverImgFor (guide-record.ts) deliberately reads `guide.cover` alone — its own doc
  // comment names the richer cover -> first-sight-photo chain as "Stage C's own job".
  // GuideLayout.astro's masthead already runs that exact chain (heroSight fallback); a
  // guide with no explicit `cover.file`/`src`/`video.poster` (Denmark, the US guide) was
  // otherwise showing a picture on its own page but NO picture on the globe pincard —
  // found 2026-08-08 comparing the live globe against guide pages directly.
  const gCover = g.data.cover as { file?: string; src?: string; video?: { poster?: string } } | null | undefined;
  const heroSight = gCover?.file || gCover?.src || gCover?.video?.poster
    ? null
    : flat.filter((s) => s.type === "sights")
        .flatMap((s) => (s as { items?: unknown[] }).items || [])
        .find((it) => (it as { img?: { file?: string; src?: string } })?.img?.file || (it as { img?: { file?: string; src?: string } })?.img?.src) as { img?: { file?: string; src?: string } } | undefined;
  const effectiveCover = heroSight?.img
    ? { file: heroSight.img.file ?? null, src: heroSight.img.src ?? null }
    : (gCover ?? null);
  const record = deriveGuideRecord(
    {
      slug: g.id,
      title: g.data.title,
      dek: g.data.dek ?? null,
      kicker: g.data.kicker ?? null,
      country: g.data.country,
      tz: g.data.tz ?? null,
      cover: effectiveCover,
      sections: g.data.sections,
      // factsFile validates each row's real shape at build (factRecord/originRecord,
      // content.config.ts) but types it as Record<string, unknown> — z.record's value type
      // can't express "one of two discriminated shapes" — so this narrows to the fields
      // deriveGuideRecord actually reads, which every validated row already carries.
      facts: (g.data.facts ?? null) as Record<string, { value?: string; state?: string }> | null,
      ordinal: ordinalFor(order, g.id),
    },
    now,
  );
  const dayCount = flat.filter((s) => s.type === "days").flatMap((s) => (s as { items?: unknown[] }).items || []).length;
  const cc = COUNTRY_CODES[g.data.country] ?? null;
  const kicker = g.data.kicker;
  const cities = kicker ? kicker.split("—")[0].trim() : (g.data.region || g.data.country);
  const dates = kicker && kicker.includes("—") ? kicker.split("—").slice(1).join("—").trim() : null;
  const emergency = emergencyFor(g.data.country);
  const currency = countryData(g.data.country)?.currency ?? null;
  const advisory = g.data.advisory && g.data.advisory.level >= 2 ? g.data.advisory : null;
  return { g, record, dayCount, cc, cities, dates, emergency, currency, advisory };
});

// Relevance sort (README §3) — distinct from the D6 plate ordinal above: this one moves with
// the clock (ongoing -> upcoming soonest-first -> past most-recent-first -> undated last).
const relevant = relevanceOrder(rows.map((r) => r.record)).map((rec) => rows.find((r) => r.record.slug === rec.slug)!);
const quick = relevant[0] ?? null;
const quickKicker = quick ? quickCardKicker(quick.record.status) : null;

const STAMP: Record<string, { label: string; cls: string } | null> = {
  ongoing: { label: "IN PROGRESS", cls: "atlas-stamp--progress" },
  upcoming: { label: "UPCOMING", cls: "atlas-stamp--upcoming" },
  past: { label: "COMPLETE", cls: "atlas-stamp--complete" },
  undated: null,
};

// The globe's data feed (Stage C.2/5, D19) — every field traces to `rows` above (content is
// king); nothing here is a parallel registry. `anchor`/`origin` flatten to [lng,lat] pairs
// because that's the coordinate order geo libraries (and atlas-map's own port) expect.
/* The prototype's record rail distinguishes NEXT TRIP from PLANNED, and only one guide can
   be the next one. relevanceOrder already sorts upcoming soonest-first, so the first
   `upcoming` it returns IS that guide — derived, not a second ranking to keep in step. */
const nextTripSlug = relevant.find((r) => r.record.status === "upcoming")?.record.slug ?? null;

const guidesJson = rows.map(({ g, record, cc }) => ({
  slug: g.id,
  name: g.data.title,
  href: `${base}/guides/${g.id}/`,
  countryId: record.countryId,
  anchor: record.anchor ? [record.anchor.lng, record.anchor.lat] : null,
  origin: record.origin
    ? { lng: record.origin.lng, lat: record.origin.lat, label: record.origin.iata, confirmed: record.origin.confirmed }
    : null,
  ordinal: record.ordinal,
  status: record.status,
  coverImg: record.coverImg,
  tz: record.tz,
  cc,
  /* The two date labels the world-view overlays render. Both are formatted from the record's
     own resolved window, so a guide with no dates gets null and the overlays print an em dash
     rather than inventing one. */
  dates: tripRangeLabel(record.start, record.end),
  /* "KR · SEOUL" — the pin card's kicker names the place the pin is ON, which is the one
     thing the globe cannot say for itself. It was the sheet ordinal, which the index rail
     on the left already carries. Null when the guide's kicker names no anchor. */
  anchorLabel: record.anchorLabel,
  isNext: record.slug === nextTripSlug,
  /* Where this guide sits in relevance order, so the globe's record rail can present the
     same sequence the hub already ranks by without re-deriving (and possibly disagreeing
     with) it. The index rail sorts by `ordinal` instead — see world-view.js. */
  rank: relevant.findIndex((r) => r.record.slug === record.slug),
  stamp: record.start
    ? `${record.start.toLocaleDateString("en-US", { month: "short" }).toUpperCase()} ${String(record.start.getFullYear()).slice(2)}`
    : null,
}));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {/* viewport-fit=cover — see GuideLayout.astro's note: without it every --safe-* token
        resolves to 0 and this page's own FAB/menu/ping-sheet insets do nothing. */}
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Waypoint — Atlas</title>
    <meta name="description" content={DESCRIPTION} />
    <meta property="og:type"        content="website" />
    <meta property="og:title"       content="Waypoint — Atlas" />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:url"         content={Astro.url.href} />
    <meta name="twitter:card"       content="summary" />
    <meta name="twitter:title"      content="Waypoint — Atlas" />
    <meta name="twitter:description" content={DESCRIPTION} />
    <PwaHead />
    {/* Mode before first paint (bundle §1b "apply before first paint to avoid a globe flash
        for table users"). The module script below owns the toggle, but it runs after the
        bundle loads — long enough for a table-view visitor on a phone to watch a 400px globe
        paint and then vanish. Same shape, and the same reason, as the theme script beside it.
        Markup default stays `table` (D4's no-JS door); this only ever writes an attribute. */}
    <script is:inline>
      (function () {
        let m = null;
        try { m = localStorage.getItem("tg-atlas-mode"); } catch (e) { /* storage unavailable */ }
        document.documentElement.setAttribute("data-atlas-mode", m === "table" ? "table" : "world");
      })();
    </script>
    <script is:inline>
      (function () {
        const s = localStorage.getItem("tg-theme");
        const preferDark = window.matchMedia && window.matchMedia("(prefers-color-scheme:dark)").matches;
        if (s === "dark" || (s === null && preferDark)) document.documentElement.setAttribute("data-theme", "dark");
        else if (s === "light") document.documentElement.setAttribute("data-theme", "light");
      })();
    </script>
  </head>
  <body data-base={base}>
    {/* Page-level survey ground (design-handoff screenshots) — position:fixed, sits under
        everything; see the frontmatter comment on `contourLayers` for why this page keeps
        its own copy instead of importing the old hub's (deleted at the flip, item 10). */}
    <div class="page-contours" aria-hidden="true">
      {contourLayers.map((layer, i) => (
        <svg data-pg-contour={i} viewBox={`0 0 ${layer.viewBox} ${layer.viewBox}`} preserveAspectRatio="xMidYMid slice">
          {layer.rings.map((pts) => <polyline points={pts} />)}
        </svg>
      ))}
    </div>

    <a class="skip-link" href="#atlasTable">Skip to guides</a>

    {/* Header (item 6 built the shell — brand mark + wordmark, the cover's FLIP target; item 9
        added the actions cluster). It carries ＋ New guide and the theme toggle. There is no
        TOOLS button and there is not meant to be: the tools are a station of each guide's own
        rail, so a hub-level door could only point at one trip's while reading as a door to
        tools in general (creator, 2026-08-11: "it's per-guide").
        The WORLD VIEW | TABLE VIEW toggle lives here too, centred at >=760px to match the
        design screenshots, instead of the full-width bar it started as below — that bar read as
        oversized/mobile-only-styled at desktop widths. Under 760px it stays in this same header
        row, compact and right-aligned (atlas-mobile.css's `max-width:759px` block), with only
        the " view" suffix dropped; it is NOT re-widened to a full-bleed bar there either. */}
    <header class="atlas-header">
      <a class="atlas-brand" href={`${base}/`} aria-label="Waypoint — the atlas">
        <span class="atlas-brand-mark" aria-hidden="true"></span>
        <span class="atlas-brand-word">
          <span class="atlas-brand-name" data-ref-headword>WAYPOINT</span>
          <span class="atlas-brand-sub">VERIFIED FIELD GUIDES</span>
        </span>
      </a>
      <div class="atlas-toggle" role="group" aria-label="Switch view">
        {/* "World view" on desktop, "World" on a phone — one button, and the suffix is a span
            CSS drops under 760px rather than two labels that could disagree. */}
        <button type="button" class="atlas-toggle-btn" data-atlas-mode-btn="world" aria-pressed="false">World<span class="atlas-toggle-word"> view</span></button>
        <button type="button" class="atlas-toggle-btn" data-atlas-mode-btn="table" aria-pressed="true">Table<span class="atlas-toggle-word"> view</span></button>
      </div>
      {/* aria-pressed has to match the view that is actually on screen, and the two doors
          disagree about which that is: with no JS nothing sets `data-atlas-mode`, so CSS
          leaves the TABLE up (D4) — which is what the markup above ships pressed. With JS the
          head script has ALREADY flipped the root to `world` (or the visitor's remembered
          choice) before first paint, so that same markup announced "Table view, pressed" over
          a rendered globe. This re-syncs the pair to the mode the head script settled on.

          It lives HERE, immediately after the buttons, and not in <head> beside its partner:
          the head script runs before these elements are parsed and could not reach them. Still
          parser-blocking and still pre-paint, so no wrong state is ever announced or painted.
          The module script at the foot owns every LATER change, through the same setMode(). */}
      <script is:inline>
        (function () {
          const mode = document.documentElement.getAttribute("data-atlas-mode") || "table";
          document.querySelectorAll("[data-atlas-mode-btn]").forEach(function (b) {
            b.setAttribute("aria-pressed", String(b.dataset.atlasModeBtn === mode));
          });
        })();
      </script>
      <div class="atlas-header-actions">
        <a class="atlas-header-btn atlas-header-btn--cta" href={`${base}/new/`}>＋<span class="atlas-header-btn-label"> New guide</span></a>
        <button type="button" id="btnDark" class="atlas-header-btn atlas-header-icon" aria-label="Switch to dark mode" title="Switch to dark mode">
          <Icon name="moon" size={16} />
        </button>
      </div>
    </header>

    {/* Cover (README §1, D21) — shown once per session. CSS hides it (`display:none`)
        until cover.js explicitly opts it in with `data-open`, so a no-JS visitor (D4's
        no-JS/SEO door) never sees it at all rather than seeing it stuck open with no way
        to dismiss it; a returning visitor within the same session never sees it flash
        before cover.js removes it. */}
    {/* A NAMED <section> (i.e. a region landmark), not a bare div: axe's `region` rule
        requires all page content to live inside a landmark, and the cover sits outside
        <main> by necessity — it's an overlay above the whole hub. A `section` only counts
        as a landmark once it has an accessible name, hence aria-label. */}
    <section class="atlas-cover" aria-label="Waypoint — verified field guides" data-atlas-cover data-fly-slug={quick?.g.id}>
      <div class="atlas-cover-col">
        <span class="atlas-cover-mark" data-cover-fade aria-hidden="true"></span>
        <span class="atlas-cover-word" data-ref-coverword>WAYPOINT</span>
        <span class="atlas-cover-sub" data-cover-fade>VERIFIED FIELD GUIDES</span>
        <button type="button" class="atlas-cover-cta" data-cover-fade data-cover-cta>Enter the atlas</button>
        <span class="atlas-cover-scroll" data-cover-fade aria-hidden="true">
          <span class="atlas-cover-scroll-line"></span>
          <span class="atlas-cover-scroll-dot"></span>
        </span>
      </div>
    </section>

    {/* Named region for the same reason as the cover above — the globe is a second top-level
        view alongside <main>'s table, so its canvas/overlays need a landmark of their own. */}
    <section class="atlas-globe-wrap" aria-label="World view — the guide map">
      <div id="atlasGlobe" data-atlas-globe>
        <div data-atlas-map-slot></div>
        <div class="atlas-pins" data-atlas-pins></div>

        <div class="atlas-ov atlas-ov-index" data-ref-fadezoom>
          <span class="atlas-ov-kicker">Index of sheets</span>
          <span class="atlas-ov-coord" data-atlas-coord>—</span>
          <ul data-atlas-index-list></ul>
        </div>

        <div class="atlas-ov atlas-ov-key" data-ref-fadezoom>
          <span class="atlas-ov-kicker">Key to the marks</span>
          <ul>
            <li><span class="swatch swatch--surveyed"></span> Surveyed (trip complete)</li>
            <li><span class="swatch swatch--filed"></span> Filed (upcoming)</li>
            <li><span class="swatch swatch--route"></span> Route from origin</li>
            <li><span class="swatch swatch--night"></span> Night now</li>
          </ul>
        </div>

        <div class="atlas-ov atlas-ov-record" data-ref-fadezoom>
          <span class="atlas-ov-kicker">The record</span>
          <ul data-atlas-record-list></ul>
        </div>

        <div class="atlas-ov atlas-ov-controls" data-ref-fadezoom>
          <button type="button" data-atlas-zoom-out aria-label="Zoom out">−</button>
          <button type="button" data-atlas-fit>Fit world</button>
          <button type="button" data-atlas-zoom-in aria-label="Zoom in">+</button>
          <button type="button" data-atlas-spin>Pause</button>
        </div>

        <div class="atlas-ov atlas-ov-motto" data-ref-fadezoom data-atlas-motto>
          <button type="button" class="atlas-ov-motto-close" data-atlas-motto-close aria-label="Dismiss">✕</button>
          {/* No kicker here — the prototype's north-star card leads with the line itself, at
              display size, and a caption above it would only say the same thing smaller. The
              accent falls on the punctuation and on `verified`, which is the word the whole
              product turns on. */}
          <p class="atlas-ov-lead">The North Star to any country<span class="atlas-ov-mark">,</span><br /><em>verified</em><span class="atlas-ov-mark">.</span></p>
          <p class="atlas-ov-sub">Drag and scroll to travel the map. Tap a pin to open its sheet — anywhere else starts a new guide.</p>
        </div>

        <div class="atlas-toast" data-atlas-toast></div>

        {/* Globe caption (bundle §1 "Globe hero"). Mobile-only, and it describes what this
            globe ACTUALLY does today: tapping a pin raises the ping sheet, tapping anywhere
            else raises the "No guide here yet — start one" toast (world-view.js's
            atlas-select handler). The bundle's own wording promises a country-polygon hit
            test that is not built; a caption is a claim like any other. */}
        <p class="atlas-globe-caption">Tap a pin for its sheet — anywhere else to start one.</p>

        {/* The horizon strip's fade and its tap target (bundle §1b). Both are inert until
            `data-atlas-mode="table"` at phone width; the globe underneath is the same
            instance either way — the strip crops it, it never unmounts. */}
        <div class="atlas-horizon" aria-hidden="true"></div>
        <button type="button" class="atlas-horizon-btn" data-atlas-horizon
                aria-label="Back to the world view"></button>

        {/* Mobile-only (<760px, D5): the desktop rails/pincards/motto have no spatial budget
            on a phone (README "Mobile"), so a bare-ping globe gets its own FAB menu (fly to
            each sheet, fit world, pause spin, ＋ new guide — the same actions the
            desktop rail already exposes, just relocated) and a bottom sheet on pin tap instead
            of the desktop pincard. Hidden by CSS above 759px; inert without JS either way
            (world.js gates its own mobile branch, so a no-JS phone visitor still gets the
            table view, D4's door). */}
        {/* ── The dock (creator, 2026-08-08: "the globe page needs more useful information
             or buttons, preferably hideable") ─────────────────────────────────────────────
             A phone looking at the globe used to have NOTHING but dots and a ☰. This is the
             table view's quick card relocated: the same emergency numbers, currency, live
             local clock and status the table already shows for the trip the hub is
             featuring — no new data, no parallel registry (CONTENT IS KING).

             Hideable, and it remembers: collapsed it is a single pill (trip · clock ·
             status dot); expanded it adds the numbers you would want at 2am in that country.
             Server-rendered, so it is there before any script runs; the clock ticks through
             the same [data-tick] hook the table's card uses. */}
        {quick && (
          <div class="atlas-dock" data-atlas-dock hidden>
            <button class="atlas-dock-head" type="button" data-atlas-dock-toggle
                    aria-expanded="false" aria-controls="atlasDockBody">
              <span class={`atlas-dock-dot atlas-dock-dot--${quick.record.status}`} aria-hidden="true"></span>
              <span class="atlas-dock-name">{quick.g.data.title}</span>
              {quick.record.tz && (
                <span class="atlas-dock-clock" data-tick data-tz={quick.record.tz}>—</span>
              )}
              <svg class="atlas-dock-chev" width="14" height="14" viewBox="0 0 16 16" fill="none"
                   stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 6.2 8 10.2l4-4"/></svg>
            </button>
            <div class="atlas-dock-body" id="atlasDockBody">
              {quickKicker && <span class="atlas-dock-kicker">{quickKicker}</span>}
              <div class="atlas-dock-facts">
                {quick.emergency?.lines.map((line: { label: string; num: string }) => (
                  <a class="atlas-dock-tel" href={`tel:${line.num}`}>{line.label} · {line.num}</a>
                ))}
                {quick.currency && <span class="atlas-dock-meta">{quick.currency.code} {quick.currency.symbol}</span>}
                {quick.advisory && <span class="atlas-dock-meta atlas-dock-warn">⚠ Level {quick.advisory.level}</span>}
              </div>
              <div class="atlas-dock-actions">
                <a class="atlas-dock-cta" href={`${base}/guides/${quick.g.id}/`}>Open the sheet →</a>
              </div>
            </div>
          </div>
        )}

        <button type="button" class="atlas-menufab" data-atlas-menufab aria-label="Map menu" aria-expanded="false">☰</button>
        <div class="atlas-menuscrim" data-atlas-menuscrim hidden></div>
        <div class="atlas-menusheet" data-atlas-menusheet hidden>
          <span class="atlas-menusheet-kicker">Fly to a sheet</span>
          <div data-atlas-menusheet-fly></div>
          <span class="atlas-menusheet-kicker">The map</span>
          <button type="button" data-atlas-menu-fit>Fit world</button>
          <button type="button" data-atlas-menu-spin>Pause</button>
          {/* No tools link. The README warned that on a phone the ☰ is the only route in,
              and that was true of a cross-trip screen; it stopped being true when R5 made
              the tools a station of each guide's own rail. From here the honest route is
              "fly to a sheet" above and then that guide's rail — one door, in the one place
              the tools actually belong. */}
          <a class="atlas-menusheet-new" href={`${base}/new/`}>＋ New guide</a>
        </div>

        <div class="atlas-pingsheet" data-atlas-pingsheet hidden>
          <span class="atlas-pingsheet-grip" aria-hidden="true"></span>
          {/* The sheet carried a country code, a title and a clock — true, and completely
              anonymous (creator, 2026-08-09: "the globe boxes are quite sterile", "the globe
              doesn't have enough information. Where is the picture cover?"). The photo is the
              trip's OWN `record.coverImg`, already in the payload this sheet reads and already
              rendered on the table rows, so this adds a surface rather than a second source of
              truth — and no new image sourcing, which would need Commons provenance.
              `hidden` until world-view.js has a URL: a guide with no cover gets no empty
              frame. */}
          <img class="atlas-pingsheet-thumb" data-atlas-pingsheet-thumb alt="" hidden
               loading="lazy" decoding="async" width="64" height="64" />
          <span class="atlas-pingsheet-kicker" data-atlas-pingsheet-kicker></span>
          <span class="atlas-pingsheet-title" data-atlas-pingsheet-title></span>
          <span class="atlas-pingsheet-meta" data-atlas-pingsheet-meta></span>
          <div class="atlas-pingsheet-actions">
            <a class="atlas-pingsheet-open" data-atlas-pingsheet-open href="#">Open the sheet →</a>
            <button type="button" data-atlas-pingsheet-zoom>Zoom</button>
            <button type="button" data-atlas-pingsheet-close aria-label="Dismiss">✕</button>
          </div>
        </div>
      </div>
    </section>

    <script type="application/json" is:inline data-atlas-guides-json set:html={JSON.stringify(guidesJson)} />

    <div class="atlas-table-wrap">
    <main class="atlas-table" id="atlasTable">
      {/* The sticky header used to carry the search FIELD plus the jump chips at full size,
          so ~110px of chrome followed you down a list of four trips (creator, 2026-08-08:
          "way too persistent"). It is now a slim bar whose only resident is the search
          TOGGLE; the field expands over it on demand and collapses again on Escape or when
          it is left empty. The chips moved out of the sticky region entirely — they scroll
          away with the page like any other content.

          No-JS baseline is unchanged and deliberately the opposite default: the markup
          ships EXPANDED, and search.js collapses it once it can actually wire the toggle.
          A reader without JS therefore still gets the plain field, never a button that
          does nothing. */}
      <div class="atlas-tablehead" data-atlas-searchhead>
        <div class="atlas-search-row" role="search">
          <button class="atlas-search-toggle" data-atlas-search-toggle type="button"
                  aria-expanded="true" aria-label="Search every guide" hidden>
            <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="7" cy="7" r="4.5"/><path d="M10.4 10.4 14 14"/></svg>
          </button>
          <input
            class="atlas-search"
            data-atlas-search
            type="search"
            placeholder="Search every sheet — a place, a price, 119…"
            aria-label="Search every guide"
            autocomplete="off"
          />
          <button class="atlas-search-clear" data-atlas-search-clear type="button" aria-label="Clear search">✕</button>
        </div>
        <div class="atlas-results" data-atlas-results role="listbox" aria-label="Search results"></div>
      </div>

      {/* Chips read in the same order as the list below them — `relevant`, not `rows`. A jump
          rail whose sequence disagrees with the list it jumps into is a second ranking to keep
          in step, which is what this page already avoids for the globe's record rail. */}
      <div class="atlas-chips" data-atlas-chips role="group" aria-label="Jump to a sheet">
        {relevant.map(({ g }) => (
          <a class={`atlas-chip${g.id === quick?.g.id ? " atlas-chip--current" : ""}`} href={`#sheet-${g.id}`}>
            {g.data.title}
          </a>
        ))}
      </div>

      {quick && quickKicker && (
        // A <div>, not an <a> — the tel: chips inside are real functional links (Gate 5:
        // "Emergency numbers are live tel: links"), and nesting an <a> inside another <a> is
        // invalid HTML that breaks click handling on whichever element the browser closes
        // first. "Open this sheet →" is its own anchor instead, matching the spec's own
        // wording (a CTA line, not "the whole card is a link").
        <div class="atlas-quick">
          <span class="atlas-quick-kicker">{quickKicker}</span>
          <span class="atlas-quick-title">{quick.g.data.title}</span>
          <span class="atlas-quick-chips">
            {quick.emergency?.lines.map((line: { label: string; num: string }) => (
              <a class="atlas-quick-tel" href={`tel:${line.num}`}>{line.label} · {line.num}</a>
            ))}
            {quick.currency && <span class="atlas-quick-meta">{quick.currency.code} {quick.currency.symbol}</span>}
            {quick.record.tz && (
              <span class="atlas-quick-meta atlas-quick-clock" data-tick data-tz={quick.record.tz}>—</span>
            )}
            {quick.advisory && (
              <span class="atlas-quick-meta atlas-quick-advisory">⚠ Level {quick.advisory.level} advisory</span>
            )}
          </span>
          <a class="atlas-quick-cta" href={`${base}/guides/${quick.g.id}/`}>Open this sheet →</a>
        </div>
      )}

      {/* The list's own section header (atlas-mobile-home bundle §1 "List section header").
          Mobile-only: on a phone the globe hero scrolls away above this list, so without a
          label the rows arrive with nothing saying what they are or why they are in this
          order. Desktop has the whole page in view at once and does not need it — and adding
          a second sticky bar under the search bar there would be the crowding the design
          doctrine forbids. `aria-hidden` because <ul> already carries the semantics; this is
          a visual label for a sighted reader mid-scroll, not a second announcement. */}
      {rows.length > 0 && (
        <div class="atlas-listhead" aria-hidden="true">Your sheets — up next first</div>
      )}

      {/* ORDER of the list below: `relevant`, not `rows` — current trip first, at every width
          (CONTEXT.md 2026-08-12, "Hub trip list orders current-trip-first, not alphabetical").
          `rows` is the content collection's own order, i.e. alphabetical by slug, which put the
          upcoming trip LAST under a header that promises "up next first".

          The rule is `relevanceOrder()` (features/atlas/model/relevance.ts) — deliberately
          REUSED rather than re-derived here, so this list, the quick card above it and the
          globe's record `rank` can never disagree about which trip is the current one. In full:
          the trip whose date range contains today first (`ongoing`), then upcoming ones
          soonest-start first, then finished ones most-recently-ended first, then undated ones
          last; ties inside a rank keep collection order. The dates come from the guide's own day
          sections via firstDayDateOf/lastDayDateOf — no separate meta field to keep in step.

          The `.atlas-sheets-next` marker below still exists and atlas-mobile.css still gives it
          `order:-1`; that is now a no-op agreeing with the DOM rather than the only thing
          floating the card, and the `#sheet-<id>` anchors are unaffected — they are ids, not
          positions. */}
      {rows.length === 0 ? (
        <p class="atlas-empty">No guides yet.</p>
      ) : (
        <ul class="atlas-sheets">
          {relevant.map(({ g, record, cc, cities, dates, dayCount }) => {
            const stamp = STAMP[record.status];
            // The up-next sheet is the mobile list's big card (bundle §1 "Up-next card").
            const isNext = quick != null && g.id === quick.g.id;
            return (
              <li class={isNext ? "atlas-sheets-next" : undefined}>
                <a class={`atlas-sheet${isNext ? " atlas-sheet--next" : ""}`} id={`sheet-${g.id}`}
                   href={`${base}/guides/${g.id}/`} data-sheet-slug={g.id}>
                  {/* The plate: the trip's own cover photo with its survey number stamped on
                      it (creator, 2026-08-08 — the list read "clean but bland"). The image is
                      the SAME `record.coverImg` the globe's pincards use, so this adds a
                      surface, not a second source of truth. A guide with no cover keeps the
                      number alone on a plain plate — an honest blank, not a grey placeholder
                      pretending to be a photo. */}
                  {/* The plate is the PHOTO now, nothing else (creator, 2026-08-09: "the guide
                      table view has the cover hero but it's covered by the guide number — is
                      there really a need?"). It is 56px square; a stamped badge with its own
                      opaque ground was taking a corner out of an already tiny image, and the
                      survey number does not need to sit on the plate to be a survey number.
                      A guide with no cover still gets an empty plate rather than a grey
                      placeholder — the honest blank the original note asked for, which reads
                      as an unfilled slot in an archive rather than a photo that failed. */}
                  {/* The up-next plate is the same <img> at two very different sizes: a 56px
                      square on desktop, a full-bleed 96px-tall cover at the top of the phone
                      list. Width descriptors + `sizes` are the only srcset form that can say
                      that; every other row keeps the 1x/2x pair, which is all a fixed 56px
                      plate can use. Eager, because on a phone it is the first thing under the
                      globe rather than something below the fold. */}
                  <span class="atlas-sheet-plate">
                    {record.coverImg && (
                      <img class="atlas-sheet-thumb" src={atWidth(record.coverImg, 56)!}
                           srcset={(isNext
                             ? srcsetWidths(record.coverImg, [56, 112, 448, 896])
                             : srcsetFor(record.coverImg, 56)) ?? undefined}
                           sizes={isNext ? "(max-width: 759px) 100vw, 56px" : undefined}
                           alt="" loading={isNext ? "eager" : "lazy"} decoding="async"
                           width="56" height="56" />
                    )}
                  </span>
                  <span class="atlas-sheet-body">
                    <span class="atlas-sheet-title">{g.data.title}</span>
                    <span class="atlas-sheet-cities">{cities}{dayCount > 0 ? ` · ${dayCount} days` : ""}</span>
                    {dates && <span class="atlas-sheet-dates">{dates}</span>}
                  </span>
                  {stamp && <span class={`atlas-stamp ${stamp.cls}`}>{stamp.label}</span>}
                  {cc && <span class="atlas-quick-meta" aria-hidden="true">{cc}</span>}
                  {/* Current conditions at the trip's own anchor (bundle §1 "…33° clear").
                      Ships EMPTY and hidden: the value is live, so a server-rendered number
                      would be a stale fact with no verification date — exactly what this
                      product refuses. home-weather.js fills it or it never appears. Only
                      guides with an anchor get a slot; there is nowhere to ask about a guide
                      with no coordinates. */}
                  {record.anchor && (
                    <span class="atlas-sheet-wx" data-atlas-wx={g.id} hidden></span>
                  )}
                  {/* Moved off the plate to here, beside the other row data. Same position on
                      every row whether or not that guide has a cover, which the on-plate
                      version could not manage. */}
                  <span class="atlas-sheet-num">{record.ordinal != null ? String(record.ordinal).padStart(2, "0") : "—"}</span>
                </a>
              </li>
            );
          })}
          {/* The create card closes the list (bundle §1 "Create card"). On a phone the header's
              ＋ CTA is hidden (atlas-mobile.css explains why), so before this the only route to
              /new/ from the list was the FAB menu — and the moment a reader reaches the end of
              four sheets is exactly when "start one" is the next thing they want. */}
          <li class="atlas-sheets-new">
            <a class="atlas-newcard" href={`${base}/new/`}>
              <span class="atlas-newcard-plus" aria-hidden="true">＋</span>
              <span class="atlas-newcard-label">Start a sheet</span>
            </a>
          </li>
        </ul>
      )}

      {/* README §5's "TRIP TOOLS row" is gone, and its absence is the point (creator,
          2026-08-11: "it's per-guide"). R5 made the tools a station of a guide's own rail,
          so a row here could only ever mean ONE trip's tools — the featured one — while
          reading like a door to tools in general. The way to a trip's tools is the way to
          everything else about that trip: open its guide. */}
    </main>
    <footer class="atlas-foot">Waypoint — every fact checked, every route tested. <a href={`${base}/about/`}>How it's made →</a></footer>
    </div>

    <script>
      import { initAtlasSearch, startLocalClocks, initCover } from "../features/atlas/index";
      import { initAtlasWorld } from "../features/atlas/ui/world-view.js";
      import { initDarkToggle } from "../scripts/theme.js";
      import { initHomeWeather } from "../features/live-data/index.js";

      // The header measures its own height into --hdr-h (docs/design-handoff/DESIGN.md: "sticky offsets are
      // never literals") — the globe wrap and the table's sticky search header both
      // already consume it. Item 9 (Chrome) will grow this same header with more rows
      // (theme toggle, ＋ New guide, TOOLS); this observer keeps working unchanged either way.
      const header = document.querySelector<HTMLElement>(".atlas-header");
      if (header) {
        const setHdrH = () => document.documentElement.style.setProperty("--hdr-h", `${header.offsetHeight}px`);
        setHdrH();
        if ("ResizeObserver" in window) new ResizeObserver(setHdrH).observe(header);
      }

      initAtlasSearch(document);
      startLocalClocks(document);
      initAtlasWorld(document);
      initCover(document);
      initDarkToggle("btnDark");

      // WORLD|TABLE toggle (README §"State" mode atlas/ledger) — table is the markup
      // default (D4); switch to world once JS is confirmed running, remembering the
      // visitor's own last choice.
      const MODE_KEY = "tg-atlas-mode";
      const modeBtns = document.querySelectorAll<HTMLElement>("[data-atlas-mode-btn]");
      function setMode(mode: string) {
        document.documentElement.setAttribute("data-atlas-mode", mode);
        modeBtns.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.atlasModeBtn === mode)));
        try { localStorage.setItem(MODE_KEY, mode); } catch { /* storage unavailable */ }
      }
      modeBtns.forEach((b) => b.addEventListener("click", () => setMode(b.dataset.atlasModeBtn || "world")));
      let initialMode = "world";
      try { initialMode = localStorage.getItem(MODE_KEY) || "world"; } catch { /* storage unavailable */ }
      setMode(initialMode);

      // The horizon strip is the way back to WORLD on a phone (bundle §1b). It is the same
      // globe either way — this switches a state, it never remounts anything.
      document.querySelector("[data-atlas-horizon]")?.addEventListener("click", () => setMode("world"));

      // Current conditions on the sheet rows. Reads the SAME guides payload the globe reads —
      // one source for the coordinates, not a second registry (CONTENT IS KING).
      const wxJson = document.querySelector("[data-atlas-guides-json]")?.textContent;
      if (wxJson) {
        try { initHomeWeather(document, JSON.parse(wxJson)); }
        catch { /* malformed payload — rows simply carry no temperature */ }
      }

      // "Skip to guides" targets #atlasTable, which world mode hides — so in world mode
      // (the JS default) the skip link jumped to a display:none element and did nothing,
      // which is the whole failure mode skip links exist to prevent. Switching to the
      // table first makes the promise true: the link always lands on the list of guides.
      // Found by axe's own skip-link rule ("target should become visible on activation")
      // when this page became the hub and entered the a11y gate's page list.
      document.querySelector(".skip-link")?.addEventListener("click", () => setMode("table"));
    </script>
  </body>
</html>
