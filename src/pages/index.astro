---
// Atlas hub — THE site's home page (docs/archive/INDEX.md → PLAN_ATLAS_MIGRATION Stage C item 10, the flip:
// built aside at /atlas/ through Stage C per D1, then moved here in one commit on the
// creator's GO). Two doors (D4): the table view is server-rendered so the page works with
// zero JS and stays indexable; the globe (world view) and the cover are progressive
// enhancement that mount on top once their modules load.
import { readFile } from "node:fs/promises";
import path from "node:path";
import { getCollection } from "astro:content";
import PwaHead from "../components/PwaHead.astro";
import AppChrome from "../components/AppChrome.astro";
import { generateContourLayer } from "../lib/contours";
import Contours from "../components/Contours.astro";
import {
  deriveGuideRecord, relevanceOrder, quickCardKicker, firstDayDateOf, lastDayDateOf,
  deriveBuildingGuides,
} from "../features/atlas/index";
import type { RunStateLike, RunStateV2Like } from "../features/atlas/index";
import { sheetOrder, ordinalFor } from "../lib/sheet-order";
import { tripRangeLabel } from "../lib/trip-dates";
// A 56px plate does not need a 258 KB original — Commons serves a 14.5 KB thumbnail for
// the same picture if you ask it for a width (verified against the live endpoint).
import { atWidth, srcsetFor, srcsetWidths } from "../lib/img-width";
import { countryData, emergencyFor, COUNTRY_CODES } from "../data/countries.mjs";
import { flattenSections } from "../features/exports/index";
import "@fontsource-variable/literata/standard.css";
import "@fontsource-variable/literata/standard-italic.css";
import "@fontsource-variable/atkinson-hyperlegible-next";
import "../styles/base.css";
import "../styles/chrome.css";
import "../styles/atlas.css";
import "../styles/atlas-world.css";
import "../styles/atlas-mobile.css";
import "../styles/transitions.css";
import "../features/search/styles.css";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const now = new Date();
const DESCRIPTION = "Verified, personalized travel guides — every price, hour, and door checked against a primary source, never autogenerated.";

// A page-level survey ground (README/design-handoff screenshots — the hub's own visual
// identity; rendered by the shared <Contours/> component since D3). Fixed seeds ⇒
// identical rings every build. Own seeds, distinct from the old hub's — the ground's DATA
// is this page's identity; only the rendering is shared.
const contourLayers = [
  generateContourLayer({ seed: 211, rings: 11, cx: 180, cy: 760 }),
  generateContourLayer({ seed: 307, rings: 8, cx: 860, cy: 200 }),
];

const allGuides = await getCollection("guides");
const curated = allGuides.filter((g) => !g.data.draft);

/* The hub's one door to a guide that is still being researched. Before this, a `draft: true`
   guide rendered NOWHERE on the site and /progress/ had no entrance but the post-intake
   redirect — so someone who closed that tab had no way back to their own run.

   Placement follows design-handoff/README.md's entry-point table verbatim: "The Atlas table
   row itself … make that row link to `/progress/?slug=<slug>` instead of the guide. Progress
   is a *state of a guide*, not a fourth destination. Costs zero header space."

   Which drafts qualify is features/atlas/model/building.ts's rule (draft AND its run has not
   cleared `verified`) — see its header for why a finished-but-withheld draft (japan was the
   motivating, now-deleted, example) must not appear here. The run state is read off the LOCAL
   filesystem at build time: it is the same
   git-tracked guides-intake/<slug>/state.json scripts/pipeline.mjs checkpoints into, already
   in the repo, so there is no fetch and no GitHub call.

   The path is resolved from `process.cwd()`, the way content.config.ts's own guide loader
   resolves src/content/guides — NOT from `import.meta.url`. That was the first attempt and it
   silently read nothing: in a BUILT page `import.meta.url` is the output chunk under dist/,
   not this source file, so `../../guides-intake/…` resolved to dist/guides-intake/… and every
   read ENOENT'd into the catch below. It failed the honest way (no rows, no error) which is
   exactly why it needed a fixture build to catch rather than a reading. */
async function readRunFile(slug: string, name: string): Promise<unknown> {
  try {
    // `g.id` is a directory name this repo's own content loader enumerated, not user input.
    const file = path.join(process.cwd(), "guides-intake", slug, name);
    return JSON.parse(await readFile(file, "utf8"));
  } catch {
    // Missing, unreadable or malformed. deriveBuildingGuides reads null as "no run this page
    // can vouch for" and shows nothing — never as "probably building".
    return null;
  }
}
const building = deriveBuildingGuides(
  await Promise.all(
    allGuides.filter((g) => g.data.draft).map(async (g) => ({
      slug: g.id,
      title: g.data.title,
      country: g.data.country,
      draft: true,
      state: (await readRunFile(g.id, "state.json")) as RunStateLike | null,
      // The V2 run record (Pipeline V2, M7): when a landed V2 run exists it is the newer word
      // on whether research finished — building.ts prefers it over the V1 spine.
      runV2: (await readRunFile(g.id, "run.v2.json")) as RunStateV2Like | null,
    })),
  ),
);

const sheetInputs = curated.map((g) => ({
  slug: g.id,
  firstDayDate: firstDayDateOf(g.data.sections),
  lastDayDate: lastDayDateOf(g.data.sections),
  kicker: g.data.kicker ?? null,
}));
const order = sheetOrder(sheetInputs, now);

const rows = curated.map((g) => {
  const flat = flattenSections(g.data.sections || []);
  // coverImgFor (guide-record.ts) deliberately reads `guide.cover` alone — its own doc
  // comment names the richer cover -> first-sight-photo chain as "Stage C's own job".
  // GuideLayout.astro's masthead already runs that exact chain (heroSight fallback); a
  // guide with no explicit `cover.file`/`src`/`video.poster` (Denmark, the US guide) was
  // otherwise showing a picture on its own page but NO picture on the globe pincard —
  // found 2026-08-08 comparing the live globe against guide pages directly.
  const gCover = g.data.cover as { file?: string; src?: string; video?: { poster?: string } } | null | undefined;
  const heroSight = gCover?.file || gCover?.src || gCover?.video?.poster
    ? null
    : flat.filter((s) => s.type === "sights")
        .flatMap((s) => (s as { items?: unknown[] }).items || [])
        .find((it) => (it as { img?: { file?: string; src?: string } })?.img?.file || (it as { img?: { file?: string; src?: string } })?.img?.src) as { img?: { file?: string; src?: string } } | undefined;
  const effectiveCover = heroSight?.img
    ? { file: heroSight.img.file ?? null, src: heroSight.img.src ?? null }
    : (gCover ?? null);
  const record = deriveGuideRecord(
    {
      slug: g.id,
      title: g.data.title,
      dek: g.data.dek ?? null,
      kicker: g.data.kicker ?? null,
      country: g.data.country,
      tz: g.data.tz ?? null,
      cover: effectiveCover,
      sections: g.data.sections,
      // factsFile validates each row's real shape at build (factRecord/originRecord,
      // content.config.ts) but types it as Record<string, unknown> — z.record's value type
      // can't express "one of two discriminated shapes" — so this narrows to the fields
      // deriveGuideRecord actually reads, which every validated row already carries.
      facts: (g.data.facts ?? null) as Record<string, { value?: string; state?: string }> | null,
      ordinal: ordinalFor(order, g.id),
    },
    now,
  );
  const dayCount = flat.filter((s) => s.type === "days").flatMap((s) => (s as { items?: unknown[] }).items || []).length;
  const cc = COUNTRY_CODES[g.data.country] ?? null;
  const kicker = g.data.kicker;
  const cities = kicker ? kicker.split("—")[0].trim() : (g.data.region || g.data.country);
  const dates = kicker && kicker.includes("—") ? kicker.split("—").slice(1).join("—").trim() : null;
  const emergency = emergencyFor(g.data.country);
  const currency = countryData(g.data.country)?.currency ?? null;
  const advisory = g.data.advisory && g.data.advisory.level >= 2 ? g.data.advisory : null;
  const rangeLabel = tripRangeLabel(record.start, record.end);
  return { g, record, dayCount, cc, cities, dates, rangeLabel, emergency, currency, advisory };
});

// Relevance sort (README §3) — distinct from the D6 plate ordinal above: this one moves with
// the clock (ongoing -> upcoming soonest-first -> past most-recent-first -> undated last).
const relevant = relevanceOrder(rows.map((r) => r.record)).map((rec) => rows.find((r) => r.record.slug === rec.slug)!);
const quick = relevant[0] ?? null;
const quickKicker = quick ? quickCardKicker(quick.record.status) : null;

const STAMP: Record<string, { label: string; cls: string } | null> = {
  ongoing: { label: "IN PROGRESS", cls: "atlas-stamp--progress" },
  upcoming: { label: "UPCOMING", cls: "atlas-stamp--upcoming" },
  past: { label: "COMPLETE", cls: "atlas-stamp--complete" },
  undated: null,
};

// The globe's data feed (Stage C.2/5, D19) — every field traces to `rows` above (content is
// king); nothing here is a parallel registry. `anchor`/`origin` flatten to [lng,lat] pairs
// because that's the coordinate order geo libraries (and atlas-map's own port) expect.
/* The prototype's record rail distinguishes NEXT TRIP from PLANNED, and only one guide can
   be the next one. relevanceOrder already sorts upcoming soonest-first, so the first
   `upcoming` it returns IS that guide — derived, not a second ranking to keep in step. */
const nextTripSlug = relevant.find((r) => r.record.status === "upcoming")?.record.slug ?? null;

/* One word for where a trip stands, on every surface that names it here (the strip's status
   chips, the destinations panel): the trip's own status, and NEXT TRIP for the one upcoming
   trip you leave for first. The stamp series below is the list's older vocabulary for the same
   fact; both come from `record.status`, so they cannot disagree. */
const STATUS_WORD: Record<string, string> = { ongoing: "Active trip", upcoming: "Planned trip", past: "Past trip", undated: "Guide" };
const statusWord = (slug: string, status: string) => (slug === nextTripSlug ? "Next trip" : STATUS_WORD[status] ?? "Guide");
const toneOf = (slug: string, status: string) => (slug === nextTripSlug ? "next" : status);

const guidesJson = rows.map(({ g, record, cc }) => ({
  slug: g.id,
  name: g.data.title,
  href: `${base}/guides/${g.id}/`,
  countryId: record.countryId,
  anchor: record.anchor ? [record.anchor.lng, record.anchor.lat] : null,
  origin: record.origin
    ? { lng: record.origin.lng, lat: record.origin.lat, label: record.origin.iata, confirmed: record.origin.confirmed }
    : null,
  ordinal: record.ordinal,
  status: record.status,
  coverImg: record.coverImg,
  tz: record.tz,
  cc,
  /* The two date labels the world-view overlays render. Both are formatted from the record's
     own resolved window, so a guide with no dates gets null and the overlays print an em dash
     rather than inventing one. */
  dates: tripRangeLabel(record.start, record.end),
  /* "KR · SEOUL" — the pin card's kicker names the place the pin is ON, which is the one
     thing the globe cannot say for itself. It was the sheet ordinal, which the index rail
     on the left already carries. Null when the guide's kicker names no anchor. */
  anchorLabel: record.anchorLabel,
  isNext: record.slug === nextTripSlug,
  /* Where this guide sits in relevance order, so the globe's record rail can present the
     same sequence the hub already ranks by without re-deriving (and possibly disagreeing
     with) it. The index rail sorts by `ordinal` instead — see world-view.js. */
  rank: relevant.findIndex((r) => r.record.slug === record.slug),
  stamp: record.start
    ? `${record.start.toLocaleDateString("en-US", { month: "short" }).toUpperCase()} ${String(record.start.getFullYear()).slice(2)}`
    : null,
}));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {/* viewport-fit=cover — see GuideLayout.astro's note: without it every --safe-* token
        resolves to 0 and this page's own FAB/menu/ping-sheet insets do nothing. */}
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Waypoint — Atlas</title>
    <meta name="description" content={DESCRIPTION} />
    <meta property="og:type"        content="website" />
    <meta property="og:title"       content="Waypoint — Atlas" />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:url"         content={Astro.url.href} />
    <meta name="twitter:card"       content="summary" />
    <meta name="twitter:title"      content="Waypoint — Atlas" />
    <meta name="twitter:description" content={DESCRIPTION} />
    <PwaHead />
    {/* Mode before first paint (bundle §1b "apply before first paint to avoid a globe flash
        for table users"). The module script below owns the toggle, but it runs after the
        bundle loads — long enough for a table-view visitor on a phone to watch a 400px globe
        paint and then vanish. Same shape, and the same reason, as the theme script beside it.
        Markup default stays `table` (D4's no-JS door); this only ever writes an attribute. */}
    <script is:inline>
      (function () {
        let m = null;
        try { m = localStorage.getItem("tg-atlas-mode"); } catch (e) { /* storage unavailable */ }
        document.documentElement.setAttribute("data-atlas-mode", m === "table" ? "table" : "world");
      })();
    </script>
    <script is:inline>
      (function () {
        const s = localStorage.getItem("tg-theme");
        const preferDark = window.matchMedia && window.matchMedia("(prefers-color-scheme:dark)").matches;
        if (s === "dark" || (s === null && preferDark)) document.documentElement.setAttribute("data-theme", "dark");
        else if (s === "light") document.documentElement.setAttribute("data-theme", "light");
      })();
    </script>
  </head>
  <body data-base={base}>
    {/* Page-level survey ground — fixed, sits under everything (see `contourLayers`). */}
    <Contours layers={contourLayers} />

    <a class="skip-link" href="#atlasTable">Skip to guides</a>

    {/* THE STAGE (board 01): the dark frame on the cream page. Its first row is the shared
        shell strip (AppChrome) — wordmark, the trips' status chips, Search, theme. Its body is
        the world view: the Atlas panel with the quick actions, the globe, the destinations
        panel, the how-it-works strip. `spatial` puts everything inside in the dark register in
        both themes (design-system.md §7/§13). Table mode collapses the body and leaves the
        strip, so the frame is still the frame while the list has the page. */}
    <div class="stage atlas-stage spatial">
      <AppChrome mode="atlas" base={base} title="WayPoint"
                 guideHref={quick ? `${base}/guides/${quick.g.id}/` : null}
                 destinations={[{ key: "trip", label: "Trip" }, { key: "itinerary", label: "Itinerary" }, { key: "map", label: "Map" }, { key: "guide", label: "Guide" }]}>
        {/* The strip's centre on the Atlas: one chip per trip, its status word and its name —
            the board's "ACTIVE TRIP · South Korea / PLANNED · Denmark" row. Each is a link into
            that guide; the dot's colour repeats the word, never replaces it (§30). */}
        {relevant.length > 0 && (
          <nav slot="center" class="atlas-status" aria-label="Your trips">
            {relevant.map(({ g, record }) => (
              <a class="atlas-status-chip" href={`${base}/guides/${g.id}/`} data-tone={toneOf(g.id, record.status)}>
                <span class="atlas-status-dot" aria-hidden="true"></span>
                <span class="atlas-status-txt">
                  <span class="atlas-status-k">{statusWord(g.id, record.status)}</span>
                  <span class="atlas-status-n">{g.data.title}</span>
                </span>
              </a>
            ))}
          </nav>
        )}
      </AppChrome>

      <section class="atlas-stage-body" aria-label="World view — the guide map">
        {/* ── The Atlas panel: title, one line, the quick actions. Left column on desktop; the
            card under the globe hero on a phone (the title row is the strip's job there). ── */}
        <div class="atlas-panel">
          <div class="atlas-panel-head">
            <h2 class="atlas-panel-title">Atlas</h2>
            <p class="atlas-panel-sub">Your world of trips and guides.</p>
          </div>
          <span class="atlas-kicker">Quick actions</span>
          <ul class="atlas-acts">
            <li>
              <a class="atlas-act" href={`${base}/new/`}>
                <span class="atlas-act-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></span>
                <span class="atlas-act-txt"><span class="atlas-act-l">Plan a new trip</span><span class="atlas-act-s">Choose a destination</span></span>
                <span class="atlas-act-chev" aria-hidden="true">›</span>
              </a>
            </li>
            <li>
              {/* The ONE table-view control. Table mode is the same page with the list up front
                  (and on a phone the globe cropped to its horizon); the list head carries the one
                  way back. aria-pressed is synced by the script under the strip. */}
              <button class="atlas-act" type="button" data-atlas-mode-btn="table" aria-pressed="true">
                <span class="atlas-act-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h10"/></svg></span>
                <span class="atlas-act-txt"><span class="atlas-act-l">Explore guides</span><span class="atlas-act-s">Every trip, as a list</span></span>
                <span class="atlas-act-chev" aria-hidden="true">›</span>
              </button>
            </li>
            {quick && (
              <li>
                <a class="atlas-act" href={`${base}/guides/${quick.g.id}/#dest-map`}>
                  <span class="atlas-act-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6.5 9 4l6 2.5 6-2.5v13L15 19.5 9 17l-6 2.5z"/><path d="M9 4v13M15 6.5v13"/></svg></span>
                  <span class="atlas-act-txt"><span class="atlas-act-l">View map</span><span class="atlas-act-s">{quick.g.data.title}, place by place</span></span>
                  <span class="atlas-act-chev" aria-hidden="true">›</span>
                </a>
              </li>
            )}
            {quick && (
              <li>
                <a class="atlas-act" href={`${base}/guides/${quick.g.id}/#dest-split`}>
                  <span class="atlas-act-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 2v20M17 6H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></span>
                  <span class="atlas-act-txt"><span class="atlas-act-l">Split expenses</span><span class="atlas-act-s">Group costs on {quick.g.data.title}</span></span>
                  <span class="atlas-act-chev" aria-hidden="true">›</span>
                </a>
              </li>
            )}
          </ul>
        </div>
        <script is:inline>
          (function () {
            /* aria-pressed has to match the view actually on screen, and the two doors disagree:
               with no JS nothing sets `data-atlas-mode`, so CSS leaves the TABLE up (D4). With
               JS the head script has already flipped the root before first paint. Re-sync here,
               after the buttons exist and before paint; atlas-hub.js owns every later change. */
            const mode = document.documentElement.getAttribute("data-atlas-mode") || "table";
            document.querySelectorAll("[data-atlas-mode-btn]").forEach(function (b) {
              b.setAttribute("aria-pressed", String(b.dataset.atlasModeBtn === mode));
            });
          })();
        </script>

        {/* ── The featured trip (board 01's active-trip card): photo, status, name, dates, the
            cities, Explore guide / View itinerary. It is `quick` — the same trip the list leads
            with — so the two can never disagree about which trip is up. Desktop only: the phone
            list's up-next card is this card, at that width. ── */}
        {quick && quickKicker && (
          <div class="atlas-tripcard">
            {quick.record.coverImg && (
              <img class="atlas-tripcard-img" src={atWidth(quick.record.coverImg, 480)!}
                   srcset={srcsetWidths(quick.record.coverImg, [320, 480, 640, 960]) ?? undefined}
                   sizes="250px" alt="" loading="eager" decoding="async" width="480" height="270" />
            )}
            <div class="atlas-tripcard-body">
              <span class="atlas-kicker atlas-tripcard-k" data-tone={toneOf(quick.g.id, quick.record.status)}>{statusWord(quick.g.id, quick.record.status)}</span>
              <span class="atlas-tripcard-title">{quick.g.data.title}</span>
              {quick.rangeLabel && <span class="atlas-tripcard-dates">{quick.rangeLabel}</span>}
              <span class="atlas-tripcard-cities">{quick.cities}{quick.dayCount > 0 ? ` · ${quick.dayCount} days` : ""}</span>
              <a class="atlas-cta atlas-cta--fill" href={`${base}/guides/${quick.g.id}/`}>Explore guide</a>
              <a class="atlas-cta" href={`${base}/guides/${quick.g.id}/#dest-itinerary`}>View itinerary</a>
            </div>
          </div>
        )}

        {/* ── The globe. ── */}
        <div class="atlas-globe-cell">
          <div id="atlasGlobe" data-atlas-globe>
            <div data-atlas-map-slot></div>
            <div class="atlas-pins" data-atlas-pins></div>

            {/* What the globe does — drag and the pins (atlas-map.js: d3-drag; a pin tap opens
                the guide on desktop, the ping sheet on a phone). Nothing here that is not wired. */}
            <p class="atlas-globe-hint">Drag to rotate · Tap a pin to open its guide</p>

            <div class="atlas-globe-ctl" role="group" aria-label="Globe controls">
              <button type="button" class="atlas-ctl" data-atlas-zoom-out aria-label="Zoom out"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5M7.5 10.5h6"/></svg><span class="atlas-ctl-l">Out</span></button>
              <button type="button" class="atlas-ctl" data-atlas-fit><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg><span class="atlas-ctl-l">Fit world</span></button>
              <button type="button" class="atlas-ctl" data-atlas-zoom-in aria-label="Zoom in"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5M7.5 10.5h6M10.5 7.5v6"/></svg><span class="atlas-ctl-l">In</span></button>
              <button type="button" class="atlas-ctl" data-atlas-spin><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M9 6v12M15 6v12"/></svg><span class="atlas-ctl-l" data-atlas-spin-label>Pause</span></button>
            </div>

            <div class="atlas-toast" data-atlas-toast></div>

            {/* Globe caption (phone). It describes what this globe ACTUALLY does today: tapping a
                pin raises the ping sheet, tapping anywhere else raises the "No guide here yet —
                start one" toast (world-view.js's atlas-select handler). */}
            <p class="atlas-globe-caption">Tap a pin for its guide — anywhere else to start one.</p>

            {/* The horizon strip's fade and its tap target (phone, table mode). Both are inert
                until `data-atlas-mode="table"` at phone width; the globe underneath is the same
                instance either way — the strip crops it, it never unmounts. */}
            <div class="atlas-horizon" aria-hidden="true"></div>
            <button type="button" class="atlas-horizon-btn" data-atlas-horizon
                    aria-label="Back to the world view"></button>

            {/* Phone only (<760px): the FAB map menu (fly to a guide, fit world, pause spin, new
                guide) and the bottom sheet a pin tap raises. Hidden by CSS above 759px; inert
                without JS either way (world-view.js gates its own mobile branch). */}
            <button type="button" class="atlas-menufab" data-atlas-menufab aria-label="Map menu" aria-expanded="false">☰</button>
            <div class="atlas-menuscrim" data-atlas-menuscrim hidden></div>
            <div class="atlas-menusheet" data-atlas-menusheet hidden>
              <span class="atlas-menusheet-kicker">Fly to a guide</span>
              <div data-atlas-menusheet-fly></div>
              <span class="atlas-menusheet-kicker">The map</span>
              <button type="button" data-atlas-menu-fit>Fit world</button>
              <button type="button" data-atlas-menu-spin>Pause</button>
              <a class="atlas-menusheet-new" href={`${base}/new/`}>＋ New guide</a>
            </div>

            <div class="atlas-pingsheet" data-atlas-pingsheet hidden>
              <span class="atlas-pingsheet-grip" aria-hidden="true"></span>
              {/* The trip's OWN cover (record.coverImg — the same URL the rows use). `hidden`
                  until world-view.js has a URL: a guide with no cover gets no empty frame. */}
              <img class="atlas-pingsheet-thumb" data-atlas-pingsheet-thumb alt="" hidden
                   loading="lazy" decoding="async" width="64" height="64" />
              <span class="atlas-pingsheet-kicker" data-atlas-pingsheet-kicker></span>
              <span class="atlas-pingsheet-title" data-atlas-pingsheet-title></span>
              <span class="atlas-pingsheet-meta" data-atlas-pingsheet-meta></span>
              <div class="atlas-pingsheet-actions">
                <a class="atlas-pingsheet-open" data-atlas-pingsheet-open href="#">Open the guide →</a>
                <button type="button" data-atlas-pingsheet-zoom>Zoom</button>
                <button type="button" data-atlas-pingsheet-close aria-label="Dismiss">✕</button>
              </div>
            </div>
          </div>
        </div>

        {/* ── Your destinations (board 01's right panel): one row per trip, its cover, its
            status, a chevron into the guide; a guide still being researched is a row here too,
            into its progress page. Desktop only — the phone list below carries the same rows. ── */}
        {(relevant.length > 0 || building.length > 0) && (
          <div class="atlas-dests">
            <span class="atlas-kicker">Your destinations</span>
            <ul class="atlas-dest-list">
              {relevant.map(({ g, record, cities }) => (
                <li>
                  <a class="atlas-dest" href={`${base}/guides/${g.id}/`} data-tone={toneOf(g.id, record.status)}>
                    <span class="atlas-dest-plate">
                      {record.coverImg && <img src={atWidth(record.coverImg, 44)!} srcset={srcsetFor(record.coverImg, 44) ?? undefined} alt="" loading="lazy" decoding="async" width="44" height="44" />}
                    </span>
                    <span class="atlas-dest-txt">
                      <span class="atlas-dest-n">{g.data.title}</span>
                      <span class="atlas-dest-s">{statusWord(g.id, record.status)}{cities ? ` · ${cities}` : ""}</span>
                    </span>
                    <span class="atlas-act-chev" aria-hidden="true">›</span>
                  </a>
                </li>
              ))}
              {building.map((b) => (
                <li>
                  <a class="atlas-dest" href={`${base}/progress/?slug=${b.slug}`} data-tone="building"
                     aria-label={`${b.title} — still being built. Follow its research run.`}>
                    <span class="atlas-dest-plate"></span>
                    <span class="atlas-dest-txt">
                      <span class="atlas-dest-n">{b.title}</span>
                      <span class="atlas-dest-s">Building{b.country ? ` · ${b.country}` : ""}</span>
                    </span>
                    <span class="atlas-act-chev" aria-hidden="true">›</span>
                  </a>
                </li>
              ))}
            </ul>
            <a class="atlas-dests-all" href="#atlasTable" data-atlas-show-table>View all destinations →</a>
          </div>
        )}

        {/* ── How it works / the marks / where the globe is looking (board 01's bottom strip).
            The key names what atlas-map.js actually draws: oxide = surveyed (past or on it now),
            muted = filed, the dashed route from the origin airport, the night shade. ── */}
        <div class="atlas-howto">
          <div class="atlas-howto-col">
            <span class="atlas-kicker">How it works</span>
            <ul class="atlas-howto-list">
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M8 13V5.5a1.5 1.5 0 0 1 3 0V12M11 11V4.5a1.5 1.5 0 0 1 3 0V12M14 11.5V6.5a1.5 1.5 0 0 1 3 0V13"/><path d="M17 13v-1.5a1.5 1.5 0 0 1 3 0V15a6 6 0 0 1-6 6h-2.5a5 5 0 0 1-4-2L4 14.5a1.6 1.6 0 0 1 2.6-1.9L8 14"/></svg><span><b>Drag to rotate</b><br/>explore your world</span></li>
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M12 21s-6-5.3-6-10a6 6 0 0 1 12 0c0 4.7-6 10-6 10z"/><circle cx="12" cy="11" r="2"/></svg><span><b>Pins show your trips</b><br/>tap one to open its guide</span></li>
            </ul>
          </div>
          <div class="atlas-howto-col">
            <span class="atlas-kicker">The marks</span>
            <ul class="atlas-howto-key">
              <li><span class="swatch swatch--surveyed"></span> Surveyed — travelled or on it now</li>
              <li><span class="swatch swatch--filed"></span> Filed — not travelled yet</li>
              <li><span class="swatch swatch--route"></span> Route from origin</li>
              <li><span class="swatch swatch--night"></span> Night now</li>
            </ul>
          </div>
          <div class="atlas-howto-col atlas-howto-coord">
            <span class="atlas-kicker">Looking at</span>
            <span class="atlas-coord" data-atlas-coord>—</span>
          </div>
        </div>
      </section>
    </div>

    <script type="application/json" is:inline data-atlas-guides-json set:html={JSON.stringify(guidesJson)} />

    {/* THE LIST (the table view, D4's zero-JS door): under the stage on the cream page in world
        mode — board 01's ivory "Upcoming trips" card — and the whole page in table mode. */}
    <main class="atlas-table-wrap" id="content">
    <div class="atlas-table" id="atlasTable" tabindex="-1">
      <div class="atlas-tablehead" data-atlas-searchhead>
        <div class="atlas-listhead-row">
          <span class="atlas-kicker atlas-listhead">Your trips — up next first</span>
          {/* The one way back to the world view from the list (table mode). */}
          <button type="button" class="atlas-world-btn" data-atlas-mode-btn="world" aria-pressed="false">World view</button>
        </div>
        {/* The one Search (§21): this field hands over to the global overlay (features/search)
            on focus, exactly as a guide's own field does. */}
        <div class="atlas-search-row" role="search">
          <input
            class="atlas-search"
            data-search-field
            type="search"
            placeholder="Search every guide — a place, a price, 119…"
            aria-label="Search every guide"
            autocomplete="off"
          />
        </div>
      </div>

      {/* Chips read in the same order as the list below them — `relevant`, not `rows`. */}
      <div class="atlas-chips" data-atlas-chips role="group" aria-label="Jump to a guide">
        {relevant.map(({ g }) => (
          <a class={`atlas-chip${g.id === quick?.g.id ? " atlas-chip--current" : ""}`} href={`#sheet-${g.id}`}>
            {g.data.title}
          </a>
        ))}
      </div>

      {quick && quickKicker && (
        // A <div>, not an <a> — the chips inside may be real links; nesting <a> in <a> is invalid.
        <div class="atlas-quick">
          <span class="atlas-quick-kicker">{quickKicker}</span>
          <span class="atlas-quick-title">{quick.g.data.title}</span>
          <span class="atlas-quick-chips">
            {quick.record.tz && (
              <span class="atlas-quick-meta atlas-quick-clock" data-tick data-tz={quick.record.tz}>—</span>
            )}
            {quick.advisory && (
              <span class="atlas-quick-meta atlas-quick-advisory">⚠ Level {quick.advisory.level} advisory</span>
            )}
          </span>
          <a class="atlas-quick-cta" href={`${base}/guides/${quick.g.id}/`}>Open this guide →</a>
        </div>
      )}

      {/* ORDER: `relevant` (features/atlas/model/relevance.ts) — current trip first, at every
          width; the quick card above, the strip's chips and the globe's `rank` all reuse it. */}
      {rows.length === 0 && building.length === 0 ? (
        <p class="atlas-empty">No guides yet.</p>
      ) : (
        <ul class="atlas-sheets">
          {/* A guide still being RESEARCHED, one row per run (features/atlas/model/building.ts):
              the row links to /progress/ instead of the guide. No figure off the run — those move
              minute by minute and this page is static. No `data-sheet-slug` and no `#sheet-` id:
              this guide has neither a verified pin nor a sheet to jump to yet. */}
          {building.map((b) => (
            <li class="atlas-sheets-building">
              <a class="atlas-sheet atlas-sheet--building" href={`${base}/progress/?slug=${b.slug}`}
                 aria-label={`${b.title} — still being built. Follow its research run.`}>
                <span class="atlas-sheet-plate"></span>
                <span class="atlas-sheet-body">
                  <span class="atlas-sheet-title">{b.title}</span>
                  {b.country && <span class="atlas-sheet-cities">{b.country}</span>}
                </span>
                <span class="atlas-stamp atlas-stamp--building">BUILDING</span>
                <span class="atlas-sheet-num">—</span>
              </a>
            </li>
          ))}
          {relevant.map(({ g, record, cc, cities, dates, dayCount }) => {
            const stamp = STAMP[record.status];
            // The up-next sheet is the phone list's big card.
            const isNext = quick != null && g.id === quick.g.id;
            return (
              <li class={isNext ? "atlas-sheets-next" : undefined}>
                <a class={`atlas-sheet${isNext ? " atlas-sheet--next" : ""}`} id={`sheet-${g.id}`}
                   href={`${base}/guides/${g.id}/`} data-sheet-slug={g.id}>
                  {/* The plate is the trip's own cover, nothing else; a guide with no cover keeps an
                      honest empty plate rather than a grey placeholder. The up-next plate is the
                      same <img> at two sizes — a 56px square here, a full-bleed 96px cover at the
                      top of the phone list — so it carries width descriptors + `sizes`. */}
                  <span class="atlas-sheet-plate">
                    {record.coverImg && (
                      <img class="atlas-sheet-thumb" src={atWidth(record.coverImg, 56)!}
                           srcset={(isNext
                             ? srcsetWidths(record.coverImg, [56, 112, 448, 896])
                             : srcsetFor(record.coverImg, 56)) ?? undefined}
                           sizes={isNext ? "(max-width: 759px) 100vw, 56px" : undefined}
                           alt="" loading={isNext ? "eager" : "lazy"} decoding="async"
                           width="56" height="56" />
                    )}
                  </span>
                  <span class="atlas-sheet-body">
                    <span class="atlas-sheet-title">{g.data.title}</span>
                    <span class="atlas-sheet-cities">{cities}{dayCount > 0 ? ` · ${dayCount} days` : ""}</span>
                    {dates && <span class="atlas-sheet-dates">{dates}</span>}
                  </span>
                  {stamp && <span class={`atlas-stamp ${stamp.cls}`}>{stamp.label}</span>}
                  {cc && <span class="atlas-quick-meta" aria-hidden="true">{cc}</span>}
                  {/* Current conditions at the trip's own anchor. Ships EMPTY and hidden: the value
                      is live, so a server-rendered number would be a stale fact. home-weather.js
                      fills it or it never appears. */}
                  {record.anchor && (
                    <span class="atlas-sheet-wx" data-atlas-wx={g.id} hidden></span>
                  )}
                  <span class="atlas-sheet-num">{record.ordinal != null ? String(record.ordinal).padStart(2, "0") : "—"}</span>
                </a>
              </li>
            );
          })}
        </ul>
      )}
    </div>
    <footer class="atlas-foot">Waypoint — every fact checked, every route tested. <a href={`${base}/about/`}>How it's made →</a></footer>
    </main>

    <script src="../scripts/atlas-hub.js"></script>
  </body>
</html>
