---
/* The Panel design study (PREVIEW ONLY) — Atlas Phase 1.2.
   Real Panels, real src/features/panel/ behaviour, fixture content. Nothing here is
   imported by any production page; delete src/pages/panel-preview/ and
   src/styles/panel-preview/ and the study is gone without a trace.

   No guide section is on a Panel yet — that is Phase 2. This route exists so the
   container is judged and verified before anything depends on it. */
import PwaHead from "../../components/PwaHead.astro";
import Panel from "../../components/Panel.astro";
import PreviewBar from "./_lib/PreviewBar.astro";
import { PANELS } from "./_lib/fixtures";
import "@fontsource-variable/literata/standard.css";
import "@fontsource-variable/source-sans-3";
import "../../styles/base.css";
import "../../styles/panel-preview/preview-chrome.css";
import "../../features/panel/styles.css";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Panel — design study</title>
    <meta name="robots" content="noindex,nofollow" />
    <PwaHead />
  </head>
  <body>
    <PreviewBar />

    <main class="pp-wrap">
      <header class="pp-head">
        <p class="pp-kicker">Design study</p>
        <h1 class="pp-h">The Panel</h1>
        <p class="pp-lede">
          One container, repeated. Each carries a kicker, a title, a drag handle and a collapse
          toggle. Collapse a Panel and reload — it is still collapsed. Switch scope and the other
          scope's Panels are untouched.
        </p>
        <p class="pp-lede pp-lede--note">
          The drag handle is inert: it is markup and a tap target only, wired in a later ticket.
        </p>
      </header>

      <div class="pnl-grid" data-panel-grid>
        {PANELS.map((p) => (
          <Panel id={p.id} kicker={p.kicker} title={p.title} collapsed={p.collapsed} fullWidth={p.fullWidth}>
            <Fragment set:html={p.body} />
          </Panel>
        ))}
      </div>

      <a class="pp-foot" href={`${base}/`}>← All guides</a>
    </main>

    <script>
      import { initPanelPreview } from "./_lib/harness.js";
      initPanelPreview();
    </script>

    <style>
      /* Wide enough for the grid to actually form rows on desktop; the ledes keep
         their own 62ch measure so the prose does not sprawl with it. */
      .pp-wrap{max-width:64rem;margin:0 auto;padding:2.4rem 1.2rem 5rem}
      .pp-head{margin-bottom:1.6rem}
      .pp-kicker{font-family:var(--font-data);font-size:var(--text-micro);font-weight:700;
        letter-spacing:var(--tracking-micro);text-transform:uppercase;color:var(--muted);margin:0 0 .3rem}
      .pp-h{font-family:var(--font-display);font-weight:600;font-size:var(--text-h2);margin:0 0 .8rem;
        letter-spacing:-.018em}
      .pp-lede{color:var(--muted);font-size:var(--text-small);line-height:1.6;margin:0 0 .7rem;max-width:62ch}
      .pp-lede--note{padding-left:.9rem;border-left:1px solid var(--rule2)}
      .pp-foot{display:inline-block;margin-top:2rem;font-family:var(--font-data);
        font-size:var(--text-control);color:var(--accent-ink);text-decoration:none}
    </style>
  </body>
</html>
