---
/* PREVIEW-ONLY chrome for the Panel design study. Deliberately looks like a tool, not
   like the design — it must never be mistaken for part of the Panel being reviewed, and
   `?bare=1` removes it entirely for clean screenshots.

   It carries the build-time embed of the VALID scopes. The ACTIVE scope is resolved
   client-side from the query string by _lib/harness.js — this route is prerendered, so
   Astro.url carries no query at build time and anything read from it here would be the
   same value on every URL. */
import { jsonEmbed } from "../../../lib/json-embed";
import { SCOPES } from "./fixtures";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<script type="application/json" is:inline id="pvConfig" set:html={jsonEmbed({ scopes: SCOPES.map((s) => s.key) })}></script>

<div class="pv-bar" id="pvBar" data-pv-bar>
  <div class="pv-bar-row">
    <span class="pv-tag">Design study</span>
    <strong class="pv-opt">Panel</strong>
    <span class="pv-pitch">The Atlas container: kicker, title, grip, collapse.</span>
    <span class="pv-warn">Fixture content — no guide section is on a Panel yet</span>
  </div>
  <div class="pv-bar-row pv-bar-row--links">
    <span class="pv-lbl">Scope</span>
    {SCOPES.map((s) => (
      <a class="pv-chip" data-pv-scope={s.key} href={`${base}/panel-preview/?scope=${s.key}`}>{s.label}</a>
    ))}
    <span class="pv-pitch">Collapse a Panel in one, switch — the other is untouched.</span>
  </div>
  <div class="pv-bar-row pv-bar-row--links">
    <span class="pv-lbl">Store</span>
    <button class="pv-chip" type="button" id="pvReset">Forget this scope</button>
    <button class="pv-chip" type="button" data-panel-order-reset>Reset order</button>
    <a class="pv-chip" id="pvBare" href={`${base}/panel-preview/?bare=1`}>Bare (screenshot)</a>
  </div>
  <p class="pv-note" id="pvNote"></p>
</div>

<script is:inline>
  /* ?bare=1 strips the tool chrome for screenshots. Inline + immediate so it never flashes. */
  (function () {
    if (new URLSearchParams(location.search).get("bare") === "1") {
      document.documentElement.setAttribute("data-pv-bare", "1");
    }
  })();
</script>
